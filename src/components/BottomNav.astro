---
import { Home, ArrowLeftRight, Plus, BarChart3, Settings } from '@lucide/astro';

const pathname = Astro.url.pathname;
---

<!-- Pembungkus Fixed Rapat di Paling Bawah Screen HP -->
<div
  class="pointer-events-none fixed right-0 bottom-0 left-0 z-50 w-full bg-gradient-to-t from-slate-50 via-slate-50/95 to-transparent px-4 pt-6 pb-3 sm:pb-4"
>
  <nav
    class="pointer-events-auto flex w-full items-center justify-between rounded-3xl border border-slate-200/80 bg-white/90 px-3 py-1.5 shadow-xl shadow-blue-950/10 backdrop-blur-xl"
  >
    <!-- 1. Home -->
    <a
      href="/"
      class={`flex w-12 flex-col items-center justify-center py-1 transition-colors ${
        pathname === '/'
          ? 'text-blue-600 font-bold'
          : 'text-slate-400 hover:text-slate-800 font-medium'
      }`}
    >
      <Home
        class={`h-5 w-5 ${pathname === '/' ? 'stroke-[2.2]' : 'stroke-2'}`}
      />
      <span class="mt-1 text-[10px]">Home</span>
    </a>

    <!-- 2. Transaction -->
    <a
      href="/history"
      class={`flex w-12 flex-col items-center justify-center py-1 transition-colors ${
        pathname.startsWith('/history')
          ? 'text-blue-600 font-bold'
          : 'text-slate-400 hover:text-slate-800 font-medium'
      }`}
    >
      <ArrowLeftRight
        class={`h-5 w-5 ${pathname.startsWith('/history') ? 'stroke-[2.2]' : 'stroke-2'}`}
      />
      <span class="mt-1 text-[10px]">Transaksi</span>
    </a>

    <!-- 3. Floating Quick Add Button -->
    <div class="relative -top-5 flex shrink-0 justify-center">
      <a
        href="/transaction"
        class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border-4 border-slate-50 bg-blue-600 text-white shadow-lg shadow-blue-600/35 transition-all hover:bg-blue-700 active:scale-95"
        aria-label="Tambah Transaksi"
      >
        <Plus class="h-6 w-6 stroke-[2.5]" />
      </a>
    </div>

    <!-- 4. Analytics -->
    <a
      href="/analytic"
      class={`flex w-12 flex-col items-center justify-center py-1 transition-colors ${
        pathname.startsWith('/analytic')
          ? 'text-blue-600 font-bold'
          : 'text-slate-400 hover:text-slate-800 font-medium'
      }`}
    >
      <BarChart3
        class={`h-5 w-5 ${pathname.startsWith('/analytic') ? 'stroke-[2.2]' : 'stroke-2'}`}
      />
      <span class="mt-1 text-[10px]">Analitik</span>
    </a>

    <!-- 5. Settings -->
    <a
      href="/settings"
      class={`flex w-12 flex-col items-center justify-center py-1 transition-colors ${
        pathname.startsWith('/settings')
          ? 'text-blue-600 font-bold'
          : 'text-slate-400 hover:text-slate-800 font-medium'
      }`}
    >
      <Settings
        class={`h-5 w-5 ${pathname.startsWith('/settings') ? 'stroke-[2.2]' : 'stroke-2'}`}
      />
      <span class="mt-1 text-[10px]">Pengaturan</span>
    </a>
  </nav>
</div>
