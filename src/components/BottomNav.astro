---
import { Home, ArrowLeftRight, Plus, BarChart3, Settings } from '@lucide/astro';
---

<div
  class="from-background via-background/80 pointer-events-none absolute right-0 bottom-0 left-0 z-50 bg-linear-to-t to-transparent p-4 pt-8"
>
  <nav
    class="border-border/80 pointer-events-auto flex w-full items-center justify-between rounded-3xl border bg-white/90 px-3 py-2 shadow-xl shadow-blue-950/5 backdrop-blur-xl"
  >
    <!-- 1. Home (Active Blue) -->
    <a
      href="/"
      class="flex w-12 flex-col items-center justify-center py-1 text-blue-600 transition-colors"
    >
      <Home class="h-5 w-5 stroke-[2.2]" />
      <span class="mt-1 text-[10px] font-semibold">Home</span>
    </a>

    <!-- 2. Transaction -->
    <a
      href="/history"
      class="flex w-12 flex-col items-center justify-center py-1 text-slate-400 transition-colors hover:text-slate-900"
    >
      <ArrowLeftRight class="h-5 w-5 stroke-2" />
      <span class="mt-1 text-[10px] font-medium">Transaksi</span>
    </a>

    <!-- 3. Quick Add Button (Floating Center Blue -> Link to /transaction) -->
    <div class="relative -top-6 flex justify-center">
      <a
        href="/transaction"
        class="flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border-4 border-white bg-blue-600 text-white shadow-lg shadow-blue-600/30 transition-all hover:bg-blue-700 active:scale-95"
        aria-label="Tambah Transaksi"
      >
        <Plus class="h-6 w-6 stroke-[2.5]" />
      </a>
    </div>

    <!-- 4. Analytics -->
    <a
      href="/analytic"
      class="flex w-12 flex-col items-center justify-center py-1 text-slate-400 transition-colors hover:text-slate-900"
    >
      <BarChart3 class="h-5 w-5 stroke-2" />
      <span class="mt-1 text-[10px] font-medium">Analitik</span>
    </a>

    <!-- 5. Settings -->
    <a
      href="#"
      class="flex w-12 flex-col items-center justify-center py-1 text-slate-400 transition-colors hover:text-slate-900"
    >
      <Settings class="h-5 w-5 stroke-2" />
      <span class="mt-1 text-[10px] font-medium">Pengaturan</span>
    </a>
  </nav>
</div>
