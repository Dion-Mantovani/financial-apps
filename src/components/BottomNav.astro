---
import { Home, ArrowLeftRight, Plus, BarChart3, Settings } from '@lucide/astro';

const pathname = Astro.url.pathname;
---

<!-- Pembungkus Fixed Rapat di Paling Bawah Screen HP -->
<div
  class="from-background via-background/95 pointer-events-none fixed right-0 bottom-0 left-0 z-50 w-full bg-linear-to-t to-transparent px-4 pt-6 pb-3 sm:pb-4"
>
  <nav
    class="border-border/80 bg-card/90 shadow-primary/5 pointer-events-auto flex w-full items-center justify-between rounded-3xl border px-3 py-1.5 shadow-xl backdrop-blur-xl"
  >
    <!-- 1. Home -->
    <a
      href="/"
      class={`flex w-12 flex-col items-center justify-center py-1 transition-colors ${
        pathname === '/'
          ? 'text-primary font-bold'
          : 'text-muted-foreground hover:text-foreground font-medium'
      }`}
    >
      <Home
        class={`h-5 w-5 ${pathname === '/' ? 'stroke-[2.2]' : 'stroke-2'}`}
      />
      <span class="mt-1 text-[10px]">Home</span>
    </a>

    <!-- 2. Transaction -->
    <a
      href="/history"
      class={`flex w-12 flex-col items-center justify-center py-1 transition-colors ${
        pathname.startsWith('/history')
          ? 'text-primary font-bold'
          : 'text-muted-foreground hover:text-foreground font-medium'
      }`}
    >
      <ArrowLeftRight
        class={`h-5 w-5 ${pathname.startsWith('/history') ? 'stroke-[2.2]' : 'stroke-2'}`}
      />
      <span class="mt-1 text-[10px]">Transaksi</span>
    </a>

    <!-- 3. Floating Quick Add Button (Pakai Theme Primary) -->
    <div class="relative -top-5 flex shrink-0 justify-center">
      <a
        href="/transaction"
        class="border-background bg-primary text-primary-foreground shadow-primary/25 flex h-12 w-12 cursor-pointer items-center justify-center rounded-full border-4 shadow-lg transition-all hover:opacity-90 active:scale-95"
        aria-label="Tambah Transaksi"
      >
        <Plus class="h-6 w-6 stroke-[2.5]" />
      </a>
    </div>

    <!-- 4. Analytics -->
    <a
      href="/analytic"
      class={`flex w-12 flex-col items-center justify-center py-1 transition-colors ${
        pathname.startsWith('/analytic')
          ? 'text-primary font-bold'
          : 'text-muted-foreground hover:text-foreground font-medium'
      }`}
    >
      <BarChart3
        class={`h-5 w-5 ${pathname.startsWith('/analytic') ? 'stroke-[2.2]' : 'stroke-2'}`}
      />
      <span class="mt-1 text-[10px]">Analitik</span>
    </a>

    <!-- 5. Settings -->
    <a
      href="/settings"
      class={`flex w-12 flex-col items-center justify-center py-1 transition-colors ${
        pathname.startsWith('/settings')
          ? 'text-primary font-bold'
          : 'text-muted-foreground hover:text-foreground font-medium'
      }`}
    >
      <Settings
        class={`h-5 w-5 ${pathname.startsWith('/settings') ? 'stroke-[2.2]' : 'stroke-2'}`}
      />
      <span class="mt-1 text-[10px]">Pengaturan</span>
    </a>
  </nav>
</div>
