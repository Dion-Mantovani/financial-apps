---
import Layout from '../layouts/Layout.astro';
import {
  Search,
  ArrowLeft,
  SlidersHorizontal,
  ArrowDownLeft,
  ArrowUpRight,
  ChevronDown,
  ArrowRightLeft,
  X,
  Calendar,
  Download,
  Filter,
  FileSpreadsheet,
  FileJson,
  Copy,
  Check,
  Utensils,
  Car,
  Briefcase,
  Wallet,
  Receipt,
  Landmark,
  Building,
  PiggyBank,
  CreditCard,
  Coins,
  QrCode,
  ShoppingBag,
  Gamepad2,
  HeartPulse,
  Gift,
  CircleEllipsis,
  TrendingUp,
  Droplets,
  Wifi,
  Home,
  Shirt,
  Coffee,
  Film,
  Dumbbell,
  Scissors,
  GraduationCap,
  Baby,
  PawPrint,
  Plane,
  Zap,
  Repeat,
  Fuel,
  Wrench,
} from '@lucide/astro';

const quickFilterTypes = [
  { id: 'all', label: 'Semua' },
  { id: 'expense', label: 'Keluar', icon: ArrowUpRight },
  { id: 'income', label: 'Masuk', icon: ArrowDownLeft },
  { id: 'transfer', label: 'Transfer', icon: ArrowRightLeft },
  { id: 'upcoming', label: 'Upcoming', icon: Calendar },
];
---

<Layout title="Riwayat Transaksi - Studion App">
  <div
    x-data="historyUI"
    x-init="$watch('showSearchInput', (visible) => {
      if (visible) {
        $nextTick(() =>$refs.searchInput?.focus())
      }
    })"
    class="space-y-5 pb-12"
  >
    <!-- STICKY HEADER -->
    <div
      class="border-border bg-background/95 sticky top-0 z-40 -mx-5 -mt-2 space-y-3 border-b px-5 pt-6 pb-3 backdrop-blur-md"
    >
      <div class="flex items-center justify-between">
        <a
          href="/"
          class="border-border bg-card text-muted-foreground hover:bg-muted flex h-9.5 w-9.5 cursor-pointer items-center justify-center rounded-2xl border shadow-xs transition-all active:scale-95"
        >
          <ArrowLeft class="h-4.5 w-4.5 stroke-[2.5]" />
        </a>
        <h1 class="text-primary text-base font-extrabold tracking-tight">
          Riwayat Transaksi
        </h1>
        <div class="w-9.5"></div>
      </div>

      <!-- SEARCH & CONTROLS -->
      <div class="flex items-center justify-between gap-2">
        <div x-show="!showSearchInput" class="flex items-center">
          <button
            type="button"
            @click="$refs.monthPicker.showPicker()"
            class="border-border bg-card flex min-w-[150px] cursor-pointer items-center gap-2 rounded-2xl border px-4 py-2 text-sm font-medium"
          >
            <Calendar class="text-blue-main h-3.5 w-3.5 stroke-2" />

            <span
              x-text="dateFilterLabel"
              class="text-foreground text-xs font-bold"></span>

            <ChevronDown
              class="text-muted-foreground h-3.5 w-3.5 stroke-[2.5]"
            />
          </button>

          <input
            x-ref="monthPicker"
            type="month"
            x-model="selectedMonth"
            class="pointer-events-none absolute h-0 w-0 opacity-0"
            tabindex="-1"
          />
        </div>

        <div x-show="showSearchInput" x-cloak class="relative flex-1">
          <Search
            x-on:click="showSearchInput = !showSearchInput"
            class="text-muted-foreground absolute top-1/2 left-3 h-4 w-4 -translate-y-1/2 stroke-2"
          />
          <input
            x-ref="searchInput"
            x-model="searchQuery"
            x-show="showSearchInput"
            x-cloak
            type="text"
            placeholder="Cari transaksi, kategori, dompet..."
            class="border-border bg-card text-foreground focus:border-blue-main w-full rounded-2xl border py-2 pr-8 pl-9 text-xs font-semibold outline-none"
          />
          <button
            type="button"
            x-on:click="showSearchInput = false; searchQuery = ''"
            class="text-muted-foreground hover:text-foreground absolute top-1/2 right-2.5 -translate-y-1/2 cursor-pointer"
          >
            <X class="h-4 w-4 stroke-2" />
          </button>
        </div>

        <div class="flex shrink-0 items-center gap-1.5">
          <button
            type="button"
            x-on:click="showSearchInput = !showSearchInput"
            class="border-border bg-card text-muted-foreground hover:bg-muted flex h-9 w-9 cursor-pointer items-center justify-center rounded-2xl border shadow-xs transition-all active:scale-95"
          >
            <Search class="h-4 w-4 stroke-2" />
          </button>

          <button
            type="button"
            @click="openFilterModal = true"
            class="border-border bg-card text-muted-foreground hover:bg-muted flex h-9 w-9 cursor-pointer items-center justify-center rounded-2xl border shadow-xs transition-all active:scale-95"
          >
            <div class="relative">
              <SlidersHorizontal class="h-4 w-4 stroke-2" />

              <span
                x-show="filterDateFrom || filterDateTo || filterWalletId || filterCategoryId"
                x-cloak
                class="bg-primary absolute -top-1 -right-1 h-2 w-2 rounded-full"
              ></span>
            </div>
          </button>

          <button
            type="button"
            @click="openExportModal = true"
            class="border-border bg-card text-muted-foreground hover:bg-muted flex h-9 w-9 cursor-pointer items-center justify-center rounded-2xl border shadow-xs transition-all active:scale-95"
          >
            <Download class="h-4 w-4 stroke-2" />
          </button>
        </div>
      </div>

      <!-- QUICK FILTER -->
      <div class="no-scrollbar flex items-center gap-2 overflow-x-auto pt-1">
        {
          quickFilterTypes.map((tab) => (
            <button
              type="button"
              x-on:click={`activeTab = '${tab.id}'`}
              class="flex shrink-0 cursor-pointer items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-xs font-bold transition-all active:scale-95"
              x-bind:class={`activeTab === '${tab.id}' ? 'bg-primary text-primary-foreground border-primary shadow-soft' : 'bg-card text-muted-foreground border-border hover:bg-muted'`}
            >
              {' '}
              {tab.icon && <tab.icon class="h-3.5 w-3.5 stroke-[2.5]" />}{' '}
              <span>{tab.label}</span>{' '}
            </button>
          ))
        }
      </div>
    </div>

    <!-- EMPTY STATE -->
    <template x-if="groupedTransactions.length === 0">
      <div
        class="flex flex-col items-center justify-center px-6 py-16 text-center"
      >
        <div
          class="bg-blue-soft text-primary flex h-14 w-14 items-center justify-center rounded-2xl"
        >
          <Receipt class="h-6 w-6 stroke-2" />
        </div>
        <h2 class="text-primary mt-4 text-sm font-extrabold">
          Belum ada transaksi
        </h2>
        <p class="text-muted-foreground mt-1 max-w-xs text-xs font-medium">
          Belum ada transaksi yang sesuai dengan filter yang dipilih.
        </p>
      </div>
    </template>

    <!-- TRANSACTION LIST -->
    <div class="space-y-5 pt-1">
      <template x-for="group in groupedTransactions" :key="group.date">
        <div class="space-y-2.5">
          <div class="flex items-center justify-between px-1">
            <span
              x-text="group.dateGroup"
              class="text-primary text-xs font-bold tracking-tight"></span>

            <div
              class="text-muted-foreground flex items-center gap-1.5 text-[10px] font-semibold"
            >
              <span x-text="`${group.count} transaksi`"></span>
              <span>•</span>
              <span
                x-text="group.totalAmount >= 0 ? `+Rp ${group.totalAmount.toLocaleString('id-ID')}` : `-Rp ${Math.abs(group.totalAmount).toLocaleString('id-ID')}`"
                class="text-foreground font-bold"></span>
            </div>
          </div>

          <div
            class="divide-border border-border bg-card shadow-soft divide-y overflow-hidden rounded-[28px] border"
          >
            <template x-for="item in group.items" :key="item.id">
              <button
                type="button"
                @click="openTransaction(item.id)"
                class="hover:bg-muted/50 flex w-full cursor-pointer items-center justify-between p-4 text-left transition-colors"
              >
                <div class="flex min-w-0 items-center gap-3.5">
                  <div
                    class="bg-blue-soft text-primary flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl"
                  >
                    <template x-if="item.icon === 'utensils'">
                      <Utensils class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'car'">
                      <Car class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'shopping-bag'">
                      <ShoppingBag class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'gamepad-2'">
                      <Gamepad2 class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'heart-pulse'">
                      <HeartPulse class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'briefcase'">
                      <Briefcase class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'gift'">
                      <Gift class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'receipt'">
                      <Receipt class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'circle-ellipsis'">
                      <CircleEllipsis class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'trending-up'">
                      <TrendingUp class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'wallet'">
                      <Wallet class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'zap'">
                      <Zap class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'droplets'">
                      <Droplets class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'wifi'">
                      <Wifi class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'home'">
                      <Home class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'shirt'">
                      <Shirt class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'coffee'">
                      <Coffee class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'film'">
                      <Film class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'dumbbell'">
                      <Dumbbell class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'scissors'">
                      <Scissors class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'graduation-cap'">
                      <GraduationCap class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'baby'">
                      <Baby class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'paw-print'">
                      <PawPrint class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'plane'">
                      <Plane class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'fuel'">
                      <Fuel class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'wrench'">
                      <Wrench class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="item.icon === 'transfer'">
                      <Repeat class="h-5 w-5 stroke-2" />
                    </template>
                  </div>

                  <div class="flex min-w-0 flex-col">
                    <span
                      x-text="item.notes"
                      class="text-foreground truncate text-xs font-bold"></span>

                    <span class="text-muted-foreground text-[10px] font-medium">
                      <span x-text="item.category"></span>
                      <span> • </span>
                      <span
                        x-text="item.wallet"
                        class="text-foreground/80 font-semibold"></span>
                    </span>
                  </div>
                </div>

                <div class="flex shrink-0 flex-col items-center gap-1 pl-2">
                  <span
                    x-text="item.amount"
                    :class="{ 'text-blue-main': item.type === 'income', 'text-foreground': item.type === 'expense', 'text-muted-foreground': item.type === 'transfer' }"
                    class="text-xs font-extrabold"></span>

                  <template x-if="item.fee > 0">
                    <span
                      class="bg-muted text-muted-foreground rounded-full px-2 py-0.5 text-[9px] font-semibold"
                    >
                      Admin -Rp<span x-text="item.fee"></span>
                    </span>
                  </template>
                </div>
              </button>
            </template>
          </div>
        </div>
      </template>

      <!-- FILTER MODAL -->
      <template x-teleport="body">
        <div
          x-show="openFilterModal"
          x-cloak
          class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs sm:items-center"
        >
          <div
            @click.away="openFilterModal = false"
            class="border-border bg-card flex max-h-[90vh] w-full max-w-md flex-col rounded-t-4xl border p-6 shadow-2xl sm:rounded-4xl"
          >
            <div
              class="border-border flex items-center justify-between border-b pb-3"
            >
              <div class="flex items-center gap-2">
                <div
                  class="bg-blue-soft text-blue-main flex h-8 w-8 items-center justify-center rounded-xl"
                >
                  <Filter class="h-4 w-4 stroke-2" />
                </div>

                <h3 class="text-primary text-base font-extrabold">
                  Advance Filter
                </h3>
              </div>

              <button
                type="button"
                @click="openFilterModal = false"
                class="text-muted-foreground hover:bg-muted flex h-8 w-8 items-center justify-center rounded-full"
              >
                <X class="h-4 w-4 stroke-[2.5]" />
              </button>
            </div>

            <div class="mt-4 space-y-4">
              <div class="space-y-2">
                <label
                  class="text-muted-foreground block text-[10px] font-bold uppercase"
                >
                  Rentang Tanggal
                </label>

                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label
                      class="text-muted-foreground mb-1.5 block text-[10px] font-medium"
                    >
                      Dari
                    </label>

                    <input
                      type="date"
                      x-model="filterDateFrom"
                      class="border-border bg-background text-foreground focus:border-primary focus:ring-primary/20 w-full rounded-2xl border px-3 py-2.5 text-xs outline-none focus:ring-2"
                    />
                  </div>

                  <div>
                    <label
                      class="text-muted-foreground mb-1.5 block text-[10px] font-medium"
                    >
                      Sampai
                    </label>

                    <input
                      type="date"
                      x-model="filterDateTo"
                      class="border-border bg-background text-foreground focus:border-primary focus:ring-primary/20 w-full rounded-2xl border px-3 py-2.5 text-xs outline-none focus:ring-2"
                    />
                  </div>
                </div>
              </div>

              <div class="space-y-2">
                <label
                  class="text-muted-foreground block text-[10px] font-bold uppercase"
                >
                  Pilih Dompet
                </label>

                <div class="flex flex-wrap gap-2">
                  <button
                    type="button"
                    @click="filterWalletId = ''"
                    :class="!filterWalletId ? 'bg-primary text-primary-foreground border-primary' : 'bg-background text-foreground border-border hover:bg-muted'"
                    class="cursor-pointer rounded-2xl border px-3.5 py-2 text-xs font-bold transition-all"
                  >
                    Semua
                  </button>

                  <template x-for="w in wallets" :key="w.id">
                    <button
                      type="button"
                      @click="filterWalletId = w.id"
                      :class="filterWalletId === w.id ? 'bg-primary text-primary-foreground border-primary' : 'bg-background text-foreground border-border hover:bg-muted'"
                      class="cursor-pointer rounded-2xl border px-3.5 py-2 text-xs font-bold transition-all"
                    >
                      <span x-text="w.name"></span>
                    </button>
                  </template>
                </div>
              </div>

              <div class="space-y-2 pt-2">
                <label
                  class="text-muted-foreground block text-[10px] font-bold tracking-wider uppercase"
                >
                  Pilih Kategori
                </label>

                <!-- Hapus 'no-scrollbar' & pastikan w-full flex-wrap -->
                <div class="flex w-full flex-wrap gap-2">
                  <button
                    type="button"
                    @click="filterCategoryId = ''"
                    :class="!filterCategoryId ? 'bg-primary text-primary-foreground border-primary shadow-xs' : 'bg-background text-foreground border-border hover:bg-muted'"
                    class="cursor-pointer rounded-2xl border px-3.5 py-2 text-xs font-bold transition-all active:scale-95"
                  >
                    Semua
                  </button>

                  <template x-for="category in categories" :key="category.id">
                    <button
                      type="button"
                      @click="filterCategoryId = category.id"
                      :class="filterCategoryId === category.id ? 'bg-primary text-primary-foreground border-primary shadow-xs' : 'bg-background text-foreground border-border hover:bg-muted'"
                      class="cursor-pointer rounded-2xl border px-3.5 py-2 text-xs font-bold transition-all active:scale-95"
                    >
                      <span x-text="category.name"></span>
                    </button>
                  </template>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-2 pt-2">
                <button
                  type="button"
                  @click="clearFilters()"
                  class="border-border bg-background text-foreground flex w-full cursor-pointer items-center justify-center rounded-2xl border py-3.5 text-xs font-bold transition-all active:scale-95"
                >
                  Reset
                </button>

                <button
                  type="button"
                  @click="openFilterModal = false"
                  class="bg-primary text-primary-foreground shadow-soft flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl py-3.5 text-xs font-bold transition-opacity hover:opacity-90 active:scale-95"
                >
                  Terapkan Filter
                </button>
              </div>
            </div>
          </div>
        </div>
      </template>

      <!-- EXPORT MODAL -->
      <template x-teleport="body">
        <div
          x-show="openExportModal"
          x-cloak
          class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs sm:items-center"
        >
          <div
            @click.away="openExportModal = false"
            class="border-border bg-card flex max-h-[90vh] w-full max-w-md flex-col rounded-t-4xl border p-6 shadow-2xl sm:rounded-4xl"
          >
            <div
              class="border-border flex items-center justify-between border-b pb-3"
            >
              <div class="flex items-center gap-2">
                <div
                  class="bg-blue-soft text-blue-main flex h-8 w-8 items-center justify-center rounded-xl"
                >
                  <Download class="h-4 w-4 stroke-2" />
                </div>

                <h3 class="text-primary text-base font-extrabold">
                  Export Transaksi
                </h3>
              </div>

              <button
                type="button"
                @click="openExportModal = false"
                class="text-muted-foreground hover:bg-muted flex h-8 w-8 items-center justify-center rounded-full"
              >
                <X class="h-4 w-4 stroke-[2.5]" />
              </button>
            </div>

            <div class="mt-4 space-y-4">
              <!-- CSV -->
              <div
                class="border-border bg-background space-y-2 rounded-2xl border p-4"
              >
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div
                      class="bg-blue-soft text-blue-main flex h-9 w-9 items-center justify-center rounded-xl"
                    >
                      <FileSpreadsheet class="h-5 w-5 stroke-2" />
                    </div>

                    <div>
                      <span class="text-foreground block text-xs font-bold">
                        Format CSV
                      </span>

                      <span
                        class="text-muted-foreground block text-[10px] font-semibold"
                      >
                        Excel & Sheets
                      </span>
                    </div>
                  </div>

                  <button
                    type="button"
                    @click="downloadCSV(); openExportModal = false"
                    class="bg-primary text-primary-foreground flex cursor-pointer items-center gap-1.5 rounded-xl px-3.5 py-2 text-xs font-bold shadow-xs transition-opacity hover:opacity-90 active:scale-95"
                  >
                    <Download class="h-3.5 w-3.5 stroke-2" />
                    <span>Download</span>
                  </button>
                </div>
              </div>

              <!-- JSON -->
              <div
                class="border-border bg-background space-y-3 rounded-2xl border p-4"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="bg-blue-soft text-blue-main flex h-9 w-9 items-center justify-center rounded-xl"
                  >
                    <FileJson class="h-5 w-5 stroke-2" />
                  </div>

                  <div>
                    <span class="text-foreground block text-xs font-bold">
                      Format JSON
                    </span>

                    <span
                      class="text-muted-foreground block text-[10px] font-semibold"
                    >
                      Data mentah
                    </span>
                  </div>
                </div>

                <div class="grid grid-cols-2 gap-2 pt-1">
                  <button
                    type="button"
                    @click="copyJSON()"
                    class="border-blue-main/30 bg-blue-soft text-blue-main flex cursor-pointer items-center justify-center gap-1.5 rounded-xl border py-2.5 text-xs font-bold transition-all active:scale-95"
                  >
                    <template x-if="!copiedJson">
                      <div class="flex items-center gap-1">
                        <Copy class="h-3.5 w-3.5 stroke-2" />
                        <span>Salin JSON</span>
                      </div>
                    </template>

                    <template x-if="copiedJson">
                      <div class="text-primary flex items-center gap-1">
                        <Check class="h-3.5 w-3.5 stroke-3" />
                        <span>Tersalin!</span>
                      </div>
                    </template>
                  </button>

                  <button
                    type="button"
                    @click="downloadJSON(); openExportModal = false"
                    class="bg-primary text-primary-foreground flex cursor-pointer items-center justify-center gap-1.5 rounded-xl py-2.5 text-xs font-bold shadow-xs transition-opacity hover:opacity-90 active:scale-95"
                  >
                    <Download class="h-3.5 w-3.5 stroke-2" />
                    <span>Download</span>
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </template>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';

  import { historyUI } from '../features/history.ui.js';

  Alpine.data('historyUI', historyUI);
</script>
