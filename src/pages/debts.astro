---
import Layout from '../layouts/Layout.astro';
import {
  ArrowLeft,
  Receipt,
  Plus,
  ArrowUpRight,
  ArrowDownLeft,
} from '@lucide/astro';
---

<Layout title="Utang & Piutang - Studion App">
  <div class="space-y-4 pt-2 pb-10">
    <!-- HEADER -->
    <div class="mt-6 flex items-center justify-between pb-1">
      <a
        href="/"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-2xl border border-slate-200/80 bg-white text-slate-700 shadow-2xs transition-all hover:border-blue-400 hover:bg-slate-50 active:scale-95"
      >
        <ArrowLeft class="h-4 w-4 stroke-[2.5]" />
      </a>
      <h1 class="text-sm font-extrabold tracking-tight text-slate-900">
        Utang & Piutang
      </h1>
      <div class="w-9"></div>
    </div>

    <!-- SUMMARY MINI CARDS -->
    <div class="grid grid-cols-2 gap-2">
      <div class="rounded-2xl border border-rose-100 bg-rose-50/50 p-3">
        <div class="flex items-center gap-1 text-rose-600">
          <ArrowUpRight class="h-3.5 w-3.5 stroke-[2.5]" />
          <span class="text-[9px] font-bold uppercase">Saya Berutang</span>
        </div>
        <p class="mt-1 text-xs font-black text-rose-700">Rp 1.200.000</p>
      </div>

      <div class="rounded-2xl border border-emerald-100 bg-emerald-50/50 p-3">
        <div class="flex items-center gap-1 text-emerald-600">
          <ArrowDownLeft class="h-3.5 w-3.5 stroke-[2.5]" />
          <span class="text-[9px] font-bold uppercase">Piutang Saya</span>
        </div>
        <p class="mt-1 text-xs font-black text-emerald-700">Rp 450.000</p>
      </div>
    </div>

    <!-- DAFTAR CATATAN UTANG -->
    <div
      class="divide-y divide-slate-100 rounded-3xl border border-slate-200/70 bg-white p-2 shadow-sm"
    >
      <!-- Item Utang -->
      <div class="flex items-center justify-between p-3">
        <div>
          <p class="text-xs font-bold text-slate-800">Pinjaman Bank BCA</p>
          <p class="text-[10px] text-slate-400">Jatuh tempo: 15 Sep 2026</p>
        </div>
        <div class="text-right">
          <p class="text-xs font-black text-rose-600">Rp 1.200.000</p>
          <span class="text-[9px] font-semibold text-rose-500">Utang</span>
        </div>
      </div>

      <!-- Item Piutang -->
      <div class="flex items-center justify-between p-3">
        <div>
          <p class="text-xs font-bold text-slate-800">Budi (Talangan Makan)</p>
          <p class="text-[10px] text-slate-400">Jatuh tempo: Besok</p>
        </div>
        <div class="text-right">
          <p class="text-xs font-black text-emerald-600">Rp 450.000</p>
          <span class="text-[9px] font-semibold text-emerald-500">Piutang</span>
        </div>
      </div>
    </div>

    <!-- TOMBOL TAMBAH -->
    <button
      type="button"
      class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-dashed border-blue-300 bg-blue-50/40 py-3.5 text-blue-600 shadow-2xs transition-all hover:bg-blue-100/60 active:scale-95"
    >
      <Plus class="h-4 w-4 stroke-[2.5]" />
      <span class="text-xs font-bold">Catat Utang / Piutang</span>
    </button>
  </div>
</Layout>
