---
import Layout from '../layouts/Layout.astro';
import {
  ArrowLeft,
  Plus,
  Sparkles,
  X,
  Pencil,
  Trash2,
  Utensils,
  Car,
  ShoppingBag,
  Briefcase,
  Gift,
  HeartPulse,
  Gamepad2,
  TrendingUp,
  TrendingDown,
  AlertTriangle,
  Receipt,
  CircleEllipsis,
  Wallet,
  Zap,
  Droplets,
  Wifi,
  Home,
  Shirt,
  Coffee,
  Film,
  Dumbbell,
  Scissors,
  GraduationCap,
  Baby,
  PawPrint,
  Plane,
  Fuel,
  Wrench,
  PiggyBank,
  CreditCard,
  Coins,
  Building,
  Tag,
} from '@lucide/astro';

/**
 * Peta Pemetaan (Mapping) Nama Ikon ke Komponen Lucide Astro.
 * Digunakan untuk merender ikon secara dinamis berdasarkan string dari database/payload.
 */
const iconMap = {
  utensils: Utensils,
  car: Car,
  'shopping-bag': ShoppingBag,
  'gamepad-2': Gamepad2,
  'heart-pulse': HeartPulse,
  receipt: Receipt,
  zap: Zap,
  droplets: Droplets,
  wifi: Wifi,
  home: Home,
  coffee: Coffee,
  shirt: Shirt,
  film: Film,
  dumbbell: Dumbbell,
  scissors: Scissors,
  'graduation-cap': GraduationCap,
  baby: Baby,
  'paw-print': PawPrint,
  plane: Plane,
  fuel: Fuel,
  wrench: Wrench,
  'credit-card': CreditCard,
  briefcase: Briefcase,
  gift: Gift,
  'trending-up': TrendingUp,
  wallet: Wallet,
  'piggy-bank': PiggyBank,
  coins: Coins,
  building: Building,
  'circle-ellipsis': CircleEllipsis,
  tag: Tag,
};

// Daftar key ikon untuk kebutuhan iterasi/pencarian di sisi client.
const availableIconsKeys = Object.keys(iconMap);
---

<Layout title="Manajemen Kategori - Studion App">
  <!-- Inisialisasi Alpine Data state 'categoryUI' -->
  <div x-data="categoryUI" class="space-y-5 pt-2 pb-12">
    <!-- 1. STICKY HEADER -->
    <div class="border-border bg-background/95 sticky top-0 z-40 -mx-5 -mt-2 space-y-3 border-b px-5 pt-6 pb-3 backdrop-blur-md">
      <div class="flex items-center justify-between">
        <!-- Tombol Kembali ke Dashboard -->
        <a
          href="/"
          class="border-border bg-card text-muted-foreground hover:bg-muted flex h-9.5 w-9.5 cursor-pointer items-center justify-center rounded-2xl border shadow-xs transition-all active:scale-95"
        >
          <ArrowLeft class="h-4.5 w-4.5 stroke-[2.5]" />
        </a>

        <h1 class="text-primary text-base font-extrabold tracking-tight">
          Kategori Transaksi
        </h1>

        <div class="w-9.5"></div>
      </div>
    </div>

    <!-- 2. TAB SELECTOR (Filter Pengeluaran vs Pemasukan) -->
    <div class="border-border bg-card grid grid-cols-2 gap-2 rounded-2xl border p-1 shadow-xs">
      <button
        type="button"
        @click="activeTab = 'expense'"
        :class="activeTab === 'expense' ? 'bg-primary text-primary-foreground shadow-soft' : 'text-muted-foreground hover:text-foreground'"
        class="flex cursor-pointer items-center justify-center gap-2 rounded-xl py-2 text-xs font-bold transition-all"
      >
        <TrendingDown class="h-3.5 w-3.5 stroke-[2.5]" />
        <span>Pengeluaran</span>
      </button>

      <button
        type="button"
        @click="activeTab = 'income'"
        :class="activeTab === 'income' ? 'bg-primary text-primary-foreground shadow-soft' : 'text-muted-foreground hover:text-foreground'"
        class="flex cursor-pointer items-center justify-center gap-2 rounded-xl py-2 text-xs font-bold transition-all"
      >
        <TrendingUp class="h-3.5 w-3.5 stroke-[2.5]" />
        <span>Pemasukan</span>
      </button>
    </div>

    <!-- 3. DAFTAR KATEGORI (Grid List yang dirender secara dinamis dari store) -->
    <div class="grid grid-cols-2 gap-3">
      <template x-for="category in filteredCategories" :key="category.id">
        <button
          type="button"
          @click="showDetail(category)"
          class="border-border bg-card hover:bg-muted/40 shadow-soft flex items-center gap-3 rounded-[22px] border p-4 text-left transition-colors"
        >
          <!-- Render Ikon Dinamis berdasarkan string icon di database -->
          <div class="bg-blue-soft text-blue flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl">
            {Object.entries(iconMap).map(([key, IconComponent]) => (
              <template x-if={`category.icon === '${key}'`}>
                <IconComponent size={18} />
              </template>
            ))}
          </div>

          <!-- Nama Kategori -->
          <span
            class="text-foreground min-w-0 truncate text-sm font-medium"
            x-text="category.name"
          ></span>
        </button>
      </template>
    </div>

    <!-- 4. TOMBOL TAMBAH KATEGORI BARU -->
    <button
      type="button"
      @click="openAddModal()"
      class="border-blue-main/40 bg-blue-soft/30 text-blue-main hover:border-blue-main hover:bg-blue-soft flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-dashed py-3.5 shadow-xs transition-all active:scale-95"
    >
      <Plus class="h-4 w-4 stroke-[2.5]" />
      <span class="text-xs font-bold">Tambah Kategori Baru</span>
    </button>

    <!-- 5. MODAL DETAIL KATEGORI (Muncul saat salah satu kartu kategori diklik) -->
    <div
      x-show="openDetailModal"
      x-cloak
      class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
    >
      <div
        @click.away="openDetailModal = false"
        class="border-border bg-card flex max-h-[90vh] w-full max-w-md flex-col overflow-hidden rounded-t-4xl border pb-14 shadow-2xl transition-transform sm:rounded-4xl"
      >
        <!-- Header Modal dengan Informasi Singkat Kategori -->
        <div class="bg-card-blue-dark relative p-6 text-white">
          <div class="pointer-events-none absolute -right-6 -bottom-8 h-28 w-28 rounded-full bg-white/10"></div>

          <div class="relative z-10 flex items-center justify-between">
            <span
              x-text="selectedCategory.type === 'expense' ? 'Kategori Pengeluaran' : 'Kategori Pemasukan'"
              class="rounded-full bg-white/20 px-2.5 py-0.5 text-[9px] font-bold tracking-widest text-white uppercase"
            ></span>
            <button
              type="button"
              @click="openDetailModal = false"
              class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 text-white"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <div class="relative z-10 mt-5 flex items-center gap-3.5">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/20 text-white">
              {Object.entries(iconMap).map(([key, IconComponent]) => (
                <template x-if={`selectedCategory.icon === '${key}'`}>
                  <IconComponent class="h-6 w-6 stroke-2" />
                </template>
              ))}
            </div>

            <div class="flex min-w-0 flex-col">
              <h2
                x-text="selectedCategory.name"
                class="truncate text-lg font-black tracking-tight text-white"
              ></h2>
              <span
                class="text-[10px] text-white/70"
                x-text="`Digunakan oleh ${usedTransactionCount} transaksi`"
              ></span>
            </div>
          </div>
        </div>

        <!-- Tombol Aksi Detail: Hapus atau Edit -->
        <div class="p-6">
          <div class="flex items-center gap-2">
            <button
              type="button"
              @click="attemptDeleteCategory()"
              class="flex w-1/3 cursor-pointer items-center justify-center gap-1.5 rounded-2xl border border-rose-200 bg-rose-50/80 py-3.5 text-xs font-bold text-rose-600 transition-colors active:scale-95"
            >
              <Trash2 class="h-4 w-4 stroke-2" />
              <span>Hapus</span>
            </button>

            <button
              type="button"
              @click="openEditFromDetail()"
              class="bg-primary text-primary-foreground shadow-soft flex w-2/3 cursor-pointer items-center justify-center gap-1.5 rounded-2xl py-3.5 text-xs font-bold transition-opacity hover:opacity-90 active:scale-95"
            >
              <Pencil class="h-4 w-4 stroke-2" />
              <span>Edit Kategori</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- 6. MODAL REASSIGN / PERINGATAN KATEGORI (Muncul jika kategori masih terikat transaksi aktif) -->
    <div
      x-show="openReassignModal"
      x-cloak
      class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
    >
      <div
        @click.away="openReassignModal = false"
        class="border-border bg-card w-full max-w-md space-y-5 rounded-t-4xl border p-6 pb-24 shadow-2xl sm:rounded-4xl"
      >
        <div class="flex items-center gap-3 text-rose-600">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-rose-100">
            <AlertTriangle class="h-5 w-5 stroke-2" />
          </div>

          <div>
            <h3 class="text-foreground text-sm font-extrabold">
              Kategori Tidak Bisa Dihapus
            </h3>
            <p
              class="text-muted-foreground text-[10px]"
              x-text="`Ada ${usedTransactionCount} transaksi menggunakan kategori ini.`"
            ></p>
          </div>
        </div>

        <div class="border-border bg-muted/40 rounded-2xl border p-4">
          <p class="text-muted-foreground text-xs leading-relaxed">
            Kategori{' '}
            <strong
              class="text-foreground"
              x-text="selectedCategory.name"
            ></strong>
            masih aktif digunakan, sehingga tidak dapat dihapus demi menjaga
            integritas data keuangan.
          </p>
        </div>

        <div class="flex items-center gap-2 pt-2">
          <button
            type="button"
            @click="openReassignModal = false"
            class="border-border text-muted-foreground hover:bg-muted w-1/3 cursor-pointer rounded-2xl border py-3.5 text-xs font-bold"
          >
            Batal
          </button>

          <button
            type="button"
            @click="openReassignModal = false; openEditFromDetail()"
            class="w-2/3 cursor-pointer rounded-2xl bg-blue-600 py-3.5 text-xs font-bold text-white shadow-sm hover:bg-blue-500 active:scale-95"
          >
            Edit Kategori
          </button>
        </div>
      </div>
    </div>

    <!-- 7. MODAL FORM TAMBAH / EDIT KATEGORI -->
    <div
      x-show="openFormModal"
      x-cloak
      class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
    >
      <div
        @click.away="openFormModal = false"
        class="border-border bg-card flex max-h-[90vh] w-full max-w-md flex-col rounded-t-4xl border p-6 pb-24 shadow-2xl transition-transform sm:rounded-4xl"
      >
        <div class="border-border flex items-center justify-between border-b pb-3">
          <div class="flex items-center gap-2">
            <div class="bg-blue-soft text-blue-main flex h-8 w-8 items-center justify-center rounded-xl">
              <Sparkles class="h-4 w-4 stroke-2" />
            </div>
            <h3
              x-text="isEdit ? 'Edit Kategori' : 'Tambah Kategori Baru'"
              class="text-primary text-base font-extrabold"
            ></h3>
          </div>
          <button
            type="button"
            @click="openFormModal = false"
            class="text-muted-foreground hover:bg-muted flex h-8 w-8 items-center justify-center rounded-full"
          >
            <X class="h-4 w-4 stroke-[2.5]" />
          </button>
        </div>

        <!-- Form Input Data Kategori -->
        <form @submit.prevent="saveCategory()" class="mt-4 space-y-4">
          <!-- Input Nama Kategori -->
          <div class="space-y-1.5">
            <label class="text-muted-foreground block text-[10px] font-bold uppercase">
              Nama Kategori
            </label>
            <input
              type="text"
              x-model="formData.name"
              x-ref="categoryNameInput"
              placeholder="misal: Makanan, Pendidikan, Pulsa"
              class="border-border bg-background text-foreground focus:border-blue-main w-full rounded-2xl border px-4 py-3 text-xs font-semibold outline-none"
              required
            />
          </div>

          <!-- Pilihan Tipe Transaksi (Expense / Income) -->
          <div class="space-y-1.5">
            <label class="text-muted-foreground block text-[10px] font-bold uppercase">
              Tipe Transaksi
            </label>
            <div class="border-border bg-background grid grid-cols-2 gap-2 rounded-2xl border p-1">
              <button
                type="button"
                @click="setFormType('expense')"
                :class="formData.type === 'expense' ? 'bg-rose-500 text-white shadow-xs' : 'text-muted-foreground hover:text-foreground'"
                class="flex cursor-pointer items-center justify-center gap-2 rounded-xl py-2.5 text-xs font-bold transition-all"
              >
                <TrendingDown class="h-3.5 w-3.5 stroke-[2.5]" />
                <span>Pengeluaran</span>
              </button>

              <button
                type="button"
                @click="setFormType('income')"
                :class="formData.type === 'income' ? 'bg-emerald-600 text-white shadow-xs' : 'text-muted-foreground hover:text-foreground'"
                class="flex cursor-pointer items-center justify-center gap-2 rounded-xl py-2.5 text-xs font-bold transition-all"
              >
                <TrendingUp class="h-3.5 w-3.5 stroke-[2.5]" />
                <span>Pemasukan</span>
              </button>
            </div>
          </div>

          <!-- Grid Pilihan Ikon -->
          <div class="space-y-1.5">
            <label class="text-muted-foreground block text-[10px] font-bold uppercase">
              Pilih Ikon
            </label>
            <div class="border-border bg-muted/20 mt-3 h-40 overflow-y-auto rounded-2xl border p-3">
              <div class="grid grid-cols-6 gap-2">
                <template x-for="item in filteredAvailableIcons" :key="item.id">
                  <button
                    type="button"
                    @click="formData.icon = item.id"
                    :class="formData.icon === item.id ? 'bg-blue-soft text-blue border-blue' : 'bg-card text-muted-foreground border-border hover:bg-muted/50'"
                    class="flex h-11 w-11 items-center justify-center rounded-xl border transition-colors"
                    :title="item.name"
                  >
                    {Object.entries(iconMap).map(([key, IconComponent]) => (
                      <template x-if={`item.id === '${key}'`}>
                        <IconComponent size={18} />
                      </template>
                    ))}
                  </button>
                </template>
              </div>
            </div>
          </div>

          <!-- Tombol Kontrol Form -->
          <div class="flex items-center gap-2 pt-2">
            <button
              type="button"
              @click="openFormModal = false"
              class="border-border text-muted-foreground hover:bg-muted w-1/3 cursor-pointer rounded-2xl border py-3.5 text-xs font-bold"
            >
              Batal
            </button>
            <button
              type="submit"
              class="bg-primary text-primary-foreground shadow-soft w-2/3 cursor-pointer rounded-2xl py-3.5 text-xs font-bold hover:opacity-90 active:scale-95"
            >
              Simpan Kategori
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  import { categoryUI } from '../features/category.ui.js';

  // Inisialisasi komponen Alpine.js untuk halaman kategori
  Alpine.data('categoryUI', categoryUI);
</script>
