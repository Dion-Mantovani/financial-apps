---
import Layout from '../layouts/Layout.astro';
import {
  ArrowLeft,
  User,
  Lock,
  Moon,
  Bell,
  Download,
  Upload,
  Trash2,
  ChevronRight,
  ShieldAlert,
  X,
  Check,
  Settings as SettingsIcon,
} from '@lucide/astro';
---

<Layout title="Pengaturan - Studion App">
  <div
    x-data="{ activeModal: null, darkMode: false, notif: true }"
    class="space-y-4 pt-2 pb-10"
  >
    <!-- 1. HEADER (PRESISI DENGAN REFERENSI WALLET) -->
    <div class="mt-6 flex items-center justify-between pb-1">
      <a
        href="/"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-2xl border border-slate-200/80 bg-white text-slate-700 shadow-2xs transition-all hover:border-blue-400 hover:bg-slate-50 active:scale-95"
      >
        <ArrowLeft class="h-4 w-4 stroke-[2.5]" />
      </a>

      <h1 class="text-sm font-extrabold tracking-tight text-slate-900">
        Pengaturan
      </h1>

      <div class="w-9"></div>
    </div>

    <!-- 2. MAIN MENU LIST CONTAINER -->
    <div class="space-y-3">
      <!-- GROUP 1: AKUN & KEAMANAN -->
      <div
        class="rounded-3xl border border-slate-200/70 bg-white p-2 shadow-sm"
      >
        <p
          class="px-3 pt-2 pb-1 text-[10px] font-bold tracking-wider text-slate-400 uppercase"
        >
          Akun & Keamanan
        </p>

        <div class="divide-y divide-slate-100">
          <!-- Edit Profil -->
          <button
            @click="activeModal = 'profile'"
            type="button"
            class="flex w-full cursor-pointer items-center justify-between rounded-2xl px-3 py-3 text-left transition hover:bg-slate-50/80 active:scale-[0.99]"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-2xl border border-blue-100 bg-blue-50 text-blue-600"
              >
                <User class="h-4.5 w-4.5 stroke-[2.2]" />
              </div>
              <div>
                <p class="text-xs font-bold text-slate-800">Edit Profil</p>
                <p class="text-[10px] text-slate-400">Nama lengkap dan email</p>
              </div>
            </div>
            <ChevronRight class="h-4 w-4 text-slate-400" />
          </button>

          <!-- Ubah Password -->
          <button
            @click="activeModal = 'password'"
            type="button"
            class="flex w-full cursor-pointer items-center justify-between rounded-2xl px-3 py-3 text-left transition hover:bg-slate-50/80 active:scale-[0.99]"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-2xl border border-blue-100 bg-blue-50 text-blue-600"
              >
                <Lock class="h-4.5 w-4.5 stroke-[2.2]" />
              </div>
              <div>
                <p class="text-xs font-bold text-slate-800">Ubah Password</p>
                <p class="text-[10px] text-slate-400">
                  Pembaruan kata sandi akun
                </p>
              </div>
            </div>
            <ChevronRight class="h-4 w-4 text-slate-400" />
          </button>
        </div>
      </div>

      <!-- GROUP 2: PREFERENSI -->
      <div
        class="rounded-3xl border border-slate-200/70 bg-white p-2 shadow-sm"
      >
        <p
          class="px-3 pt-2 pb-1 text-[10px] font-bold tracking-wider text-slate-400 uppercase"
        >
          Preferensi
        </p>

        <div class="divide-y divide-slate-100">
          <!-- Dark Mode Toggle -->
          <div class="flex items-center justify-between px-3 py-3">
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-2xl border border-slate-100 bg-slate-50 text-slate-600"
              >
                <Moon class="h-4.5 w-4.5 stroke-[2.2]" />
              </div>
              <div>
                <p class="text-xs font-bold text-slate-800">Mode Gelap</p>
                <p class="text-[10px] text-slate-400">Tampilan hemat energi</p>
              </div>
            </div>
            <button
              @click="darkMode = !darkMode"
              type="button"
              :class="darkMode ? 'bg-blue-600' : 'bg-slate-200'"
              class="relative inline-flex h-5.5 w-10 shrink-0 cursor-pointer rounded-full transition-colors duration-200"
            >
              <span
                :class="darkMode ? 'translate-x-4.5' : 'translate-x-0.5'"
                class="pointer-events-none inline-block h-4.5 w-4.5 transform self-center rounded-full bg-white shadow-xs transition duration-200"
              ></span>
            </button>
          </div>

          <!-- Notifikasi Toggle -->
          <div class="flex items-center justify-between px-3 py-3">
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-2xl border border-slate-100 bg-slate-50 text-slate-600"
              >
                <Bell class="h-4.5 w-4.5 stroke-[2.2]" />
              </div>
              <div>
                <p class="text-xs font-bold text-slate-800">
                  Pengingat Transaksi
                </p>
                <p class="text-[10px] text-slate-400">Notifikasi harian</p>
              </div>
            </div>
            <button
              @click="notif = !notif"
              type="button"
              :class="notif ? 'bg-blue-600' : 'bg-slate-200'"
              class="relative inline-flex h-5.5 w-10 shrink-0 cursor-pointer rounded-full transition-colors duration-200"
            >
              <span
                :class="notif ? 'translate-x-4.5' : 'translate-x-0.5'"
                class="pointer-events-none inline-block h-4.5 w-4.5 transform self-center rounded-full bg-white shadow-xs transition duration-200"
              ></span>
            </button>
          </div>
        </div>
      </div>

      <!-- GROUP 3: DATA & ZONA BAHAYA -->
      <div
        class="rounded-3xl border border-slate-200/70 bg-white p-2 shadow-sm"
      >
        <p
          class="px-3 pt-2 pb-1 text-[10px] font-bold tracking-wider text-slate-400 uppercase"
        >
          Data & Pemeliharaan
        </p>

        <div class="divide-y divide-slate-100">
          <!-- Export Data -->
          <button
            @click="activeModal = 'export'"
            type="button"
            class="flex w-full cursor-pointer items-center justify-between rounded-2xl px-3 py-3 text-left transition hover:bg-slate-50/80 active:scale-[0.99]"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-2xl border border-emerald-100 bg-emerald-50 text-emerald-600"
              >
                <Download class="h-4.5 w-4.5 stroke-[2.2]" />
              </div>
              <div>
                <p class="text-xs font-bold text-slate-800">
                  Export Semua Data
                </p>
                <p class="text-[10px] text-slate-400">Unduh berkas CSV/Excel</p>
              </div>
            </div>
            <ChevronRight class="h-4 w-4 text-slate-400" />
          </button>

          <!-- Import Data -->
          <button
            @click="activeModal = 'import'"
            type="button"
            class="flex w-full cursor-pointer items-center justify-between rounded-2xl px-3 py-3 text-left transition hover:bg-slate-50/80 active:scale-[0.99]"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-2xl border border-cyan-100 bg-cyan-50 text-cyan-600"
              >
                <Upload class="h-4.5 w-4.5 stroke-[2.2]" />
              </div>
              <div>
                <p class="text-xs font-bold text-slate-800">Import Data</p>
                <p class="text-[10px] text-slate-400">Unggah berkas cadangan</p>
              </div>
            </div>
            <ChevronRight class="h-4 w-4 text-slate-400" />
          </button>

          <!-- Reset Data -->
          <button
            @click="activeModal = 'reset'"
            type="button"
            class="flex w-full cursor-pointer items-center justify-between rounded-2xl px-3 py-3 text-left transition hover:bg-rose-50/40 active:scale-[0.99]"
          >
            <div class="flex items-center gap-3">
              <div
                class="flex h-9 w-9 items-center justify-center rounded-2xl border border-rose-100 bg-rose-50 text-rose-600"
              >
                <Trash2 class="h-4.5 w-4.5 stroke-[2.2]" />
              </div>
              <div>
                <p class="text-xs font-bold text-rose-600">
                  Hapus Seluruh Data
                </p>
                <p class="text-[10px] text-slate-400">
                  Reset permanen database
                </p>
              </div>
            </div>
            <ChevronRight class="h-4 w-4 text-slate-400" />
          </button>
        </div>
      </div>
    </div>

    <!-- ========================================== -->
    <!-- MODAL CONTAINERS (ALPINE TELEPORT STYLE) -->
    <!-- ========================================== -->
    <template x-teleport="body">
      <div
        x-show="activeModal"
        x-cloak
        class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-xs"
      >
        <!-- 1. MODAL EDIT PROFIL -->
        <div
          x-show="activeModal === 'profile'"
          @click.away="activeModal = null"
          class="w-full max-w-sm rounded-3xl bg-white p-5 shadow-2xl transition-all"
        >
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-3"
          >
            <h3 class="text-sm font-extrabold text-slate-900">Edit Profil</h3>
            <button
              @click="activeModal = null"
              type="button"
              class="flex h-7 w-7 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>
          <form class="mt-4 space-y-3.5" @submit.prevent="activeModal = null">
            <div>
              <label
                class="mb-1 block text-[10px] font-bold text-slate-500 uppercase"
                >Nama Lengkap</label
              >
              <input
                type="text"
                value="Muhamad Dion Mantovani"
                class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 p-2.5 text-xs font-semibold text-slate-800 outline-none focus:border-blue-500 focus:bg-white"
              />
            </div>
            <div>
              <label
                class="mb-1 block text-[10px] font-bold text-slate-500 uppercase"
                >Email</label
              >
              <input
                type="email"
                value="dion@example.com"
                class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 p-2.5 text-xs font-semibold text-slate-800 outline-none focus:border-blue-500 focus:bg-white"
              />
            </div>
            <div class="flex items-center gap-2 pt-2">
              <button
                @click="activeModal = null"
                type="button"
                class="w-1/3 cursor-pointer rounded-2xl border border-slate-200 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50"
                >Batal</button
              >
              <button
                type="submit"
                class="w-2/3 cursor-pointer rounded-2xl bg-blue-600 py-2.5 text-xs font-bold text-white shadow-md shadow-blue-600/20 hover:bg-blue-700"
                >Simpan Profil</button
              >
            </div>
          </form>
        </div>

        <!-- 2. MODAL UBAH PASSWORD -->
        <div
          x-show="activeModal === 'password'"
          @click.away="activeModal = null"
          class="w-full max-w-sm rounded-3xl bg-white p-5 shadow-2xl transition-all"
        >
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-3"
          >
            <h3 class="text-sm font-extrabold text-slate-900">Ubah Password</h3>
            <button
              @click="activeModal = null"
              type="button"
              class="flex h-7 w-7 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>
          <form class="mt-4 space-y-3.5" @submit.prevent="activeModal = null">
            <div>
              <label
                class="mb-1 block text-[10px] font-bold text-slate-500 uppercase"
                >Password Saat Ini</label
              >
              <input
                type="password"
                placeholder="••••••••"
                class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 p-2.5 text-xs font-semibold text-slate-800 outline-none focus:border-blue-500 focus:bg-white"
              />
            </div>
            <div>
              <label
                class="mb-1 block text-[10px] font-bold text-slate-500 uppercase"
                >Password Baru</label
              >
              <input
                type="password"
                placeholder="••••••••"
                class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 p-2.5 text-xs font-semibold text-slate-800 outline-none focus:border-blue-500 focus:bg-white"
              />
            </div>
            <div class="flex items-center gap-2 pt-2">
              <button
                @click="activeModal = null"
                type="button"
                class="w-1/3 cursor-pointer rounded-2xl border border-slate-200 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50"
                >Batal</button
              >
              <button
                type="submit"
                class="w-2/3 cursor-pointer rounded-2xl bg-blue-600 py-2.5 text-xs font-bold text-white shadow-md shadow-blue-600/20 hover:bg-blue-700"
                >Update Password</button
              >
            </div>
          </form>
        </div>

        <!-- 3. MODAL EXPORT DATA -->
        <div
          x-show="activeModal === 'export'"
          @click.away="activeModal = null"
          class="w-full max-w-sm space-y-4 rounded-3xl bg-white p-5 text-center shadow-2xl transition-all"
        >
          <div
            class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-emerald-100 text-emerald-600"
          >
            <Download class="h-6 w-6 stroke-[2.2]" />
          </div>
          <div>
            <h3 class="text-sm font-extrabold text-slate-900">
              Export Transaksi
            </h3>
            <p class="mt-1 text-xs text-slate-500">
              Unduh seluruh riwayat data transaksi kamu dalam format CSV.
            </p>
          </div>
          <div class="flex gap-2 pt-1">
            <button
              @click="activeModal = null"
              type="button"
              class="w-1/2 cursor-pointer rounded-2xl border border-slate-200 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50"
              >Batal</button
            >
            <button
              @click="activeModal = null"
              type="button"
              class="w-1/2 cursor-pointer rounded-2xl bg-emerald-600 py-2.5 text-xs font-bold text-white shadow-md shadow-emerald-600/20 hover:bg-emerald-700"
              >Download CSV</button
            >
          </div>
        </div>

        <!-- 4. MODAL IMPORT DATA -->
        <div
          x-show="activeModal === 'import'"
          @click.away="activeModal = null"
          class="w-full max-w-sm space-y-4 rounded-3xl bg-white p-5 shadow-2xl transition-all"
        >
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-3"
          >
            <h3 class="text-sm font-extrabold text-slate-900">
              Import File Data
            </h3>
            <button
              @click="activeModal = null"
              type="button"
              class="flex h-7 w-7 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>
          <div
            class="space-y-1.5 rounded-2xl border-2 border-dashed border-slate-200 p-5 text-center"
          >
            <Upload class="mx-auto h-7 w-7 text-slate-400" />
            <p class="text-xs font-bold text-slate-800">
              Pilih Berkas CSV / JSON
            </p>
            <p class="text-[10px] text-slate-400">
              Batas maksimal ukuran file 5MB
            </p>
          </div>
          <button
            @click="activeModal = null"
            type="button"
            class="w-full cursor-pointer rounded-2xl bg-blue-600 py-2.5 text-xs font-bold text-white shadow-md shadow-blue-600/20 hover:bg-blue-700"
          >
            Unggah Berkas
          </button>
        </div>

        <!-- 5. MODAL RESET DATA (DANGER ZONE) -->
        <div
          x-show="activeModal === 'reset'"
          @click.away="activeModal = null"
          class="w-full max-w-sm space-y-4 rounded-3xl bg-white p-5 text-center shadow-2xl transition-all"
        >
          <div
            class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-100 text-rose-600"
          >
            <ShieldAlert class="h-6 w-6 stroke-[2.2]" />
          </div>
          <div>
            <h3 class="text-sm font-extrabold text-slate-900">
              Hapus Seluruh Data?
            </h3>
            <p class="mt-1 text-xs text-slate-500">
              Tindakan ini permanen. Semua data transaksi kamu akan dihapus
              bersih dari database.
            </p>
          </div>
          <div class="flex gap-2 pt-1">
            <button
              @click="activeModal = null"
              type="button"
              class="w-1/2 cursor-pointer rounded-2xl border border-slate-200 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50"
              >Batal</button
            >
            <button
              @click="activeModal = null"
              type="button"
              class="w-1/2 cursor-pointer rounded-2xl bg-rose-600 py-2.5 text-xs font-bold text-white shadow-md shadow-rose-600/20 hover:bg-rose-700"
              >Ya, Hapus Data</button
            >
          </div>
        </div>
      </div>
    </template>
  </div>
</Layout>
