---
import Layout from '../layouts/Layout.astro';
import {
  ArrowLeft,
  PiggyBank,
  Plus,
  AlertTriangle,
  Grid,
  ChevronRight,
  Calendar,
  ChevronDown,
  Copy,
  X,
  Trash2,
  // Lucide Icons untuk Kategori Dinamis
  Utensils,
  Car,
  ShoppingBag,
  Receipt,
  Gamepad2,
  HeartPulse,
  GraduationCap,
  MoreHorizontal,
  Briefcase,
  Gift,
  TrendingUp,
  RotateCcw,
  Wallet,
  ArrowRightLeft,
  Smartphone,
  LineChart,
  CreditCard,
  Tag,
} from '@lucide/astro';
---

<Layout title="Target Anggaran - Studion App">
  <div x-data="budgetController()" class="space-y-4 pt-2 pb-10">
    <!-- Input Hidden Month Picker -->
    <input
      type="month"
      x-ref="monthInput"
      x-model="selectedMonth"
      class="sr-only hidden"
    />

    <!-- 1. HEADER HALAMAN -->
    <div class="mt-6 flex items-center justify-between pb-1">
      <a
        href="/"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-2xl border border-slate-200/80 bg-white text-slate-700 shadow-2xs transition-all hover:border-blue-400 hover:bg-slate-50 active:scale-95"
        aria-label="Kembali ke Beranda"
      >
        <ArrowLeft class="h-4 w-4 stroke-[2.5]" />
      </a>

      <h1 class="text-sm font-extrabold tracking-tight text-slate-900">
        Anggaran Bulanan
      </h1>

      <div class="w-9"></div>
    </div>

    <!-- 2. HERO CARD UTAMA: SPEEDOMETER METER -->
    <div
      class="relative overflow-hidden rounded-3xl border border-white/15 bg-linear-to-br from-blue-900/90 via-blue-950/95 to-slate-950 p-5 text-white shadow-2xl shadow-blue-950/40 backdrop-blur-xl"
    >
      <div
        class="pointer-events-none absolute right-0 bottom-0 h-full w-full overflow-hidden rounded-br-3xl opacity-25"
      >
        <svg
          class="h-full w-full"
          width="100%"
          height="100%"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <pattern
              id="grid-pattern-budget"
              width="16"
              height="16"
              patternUnits="userSpaceOnUse"
            >
              <path
                d="M 16 0 L 0 0 0 16"
                fill="none"
                stroke="rgba(255, 255, 255, 0.4)"
                stroke-width="1.2"></path>
            </pattern>
            <radialGradient id="grid-fade-budget" cx="100%" cy="100%" r="100%">
              <stop offset="0%" stop-color="white" stop-opacity="1"></stop>
              <stop offset="80%" stop-color="white" stop-opacity="0"></stop>
            </radialGradient>
            <mask id="grid-mask-budget">
              <rect width="100%" height="100%" fill="url(#grid-fade-budget)"
              ></rect>
            </mask>
          </defs>
          <rect
            width="100%"
            height="100%"
            fill="url(#grid-pattern-budget)"
            mask="url(#grid-mask-budget)"></rect>
        </svg>
      </div>

      <div
        class="pointer-events-none absolute -top-12 -left-12 h-36 w-36 rounded-full bg-blue-500/25 blur-2xl"
      >
      </div>
      <div
        class="pointer-events-none absolute -right-12 -bottom-12 h-36 w-36 rounded-full bg-amber-400/15 blur-2xl"
      >
      </div>

      <!-- SELECTOR BULAN -->
      <div class="relative z-10 flex items-center justify-between">
        <button
          type="button"
          @click="openMonthPicker()"
          class="flex cursor-pointer items-center gap-1.5 rounded-full border border-white/15 bg-white/10 px-3 py-1 shadow-xs backdrop-blur-md transition-all hover:bg-white/20 active:scale-95"
        >
          <Calendar class="h-3.5 w-3.5 stroke-2 text-cyan-300" />
          <span
            class="text-xs font-bold text-white"
            x-text="formattedSelectedMonth"></span>
          <ChevronDown class="h-3.5 w-3.5 stroke-[2.5] text-blue-200" />
        </button>
      </div>

      <!-- SPEEDOMETER ARC SVG -->
      <div
        class="relative z-10 my-3 flex flex-col items-center justify-center pt-3 pb-1"
      >
        <div class="relative flex h-36 w-56 items-center justify-center">
          <svg class="h-full w-full overflow-visible" viewBox="0 0 100 60">
            <path
              d="M 10 50 A 40 40 0 0 1 90 50"
              fill="none"
              stroke="rgba(255, 255, 255, 0.15)"
              stroke-width="6.5"
              stroke-linecap="round"
              stroke-dasharray="2 3"></path>

            <path
              d="M 10 50 A 40 40 0 0 1 90 50"
              fill="none"
              stroke="url(#speedo-gradient)"
              stroke-width="7.5"
              stroke-linecap="round"
              stroke-dasharray="126"
              :stroke-dashoffset="126 - (126 * overallPercentage) / 100"
              class="transition-all duration-1000 ease-out"></path>

            <defs>
              <linearGradient
                id="speedo-gradient"
                x1="0%"
                y1="0%"
                x2="100%"
                y2="0%"
              >
                <stop offset="0%" stop-color="#10b981"></stop>
                <stop offset="65%" stop-color="#f59e0b"></stop>
                <stop offset="100%" stop-color="#f43f5e"></stop>
              </linearGradient>
            </defs>
          </svg>

          <div class="absolute bottom-0 flex flex-col items-center pb-1">
            <span
              class="text-3xl font-black tracking-tight text-white drop-shadow-md"
              x-text="`${overallPercentage}%`"></span>
            <span
              class="mt-0.5 text-[9px] font-bold tracking-widest text-blue-200/70 uppercase"
              >Terpakai</span
            >
          </div>
        </div>

        <div class="mt-3 text-center">
          <h2 class="text-xl font-black tracking-tight text-white">
            <span x-text="formatCurrency(totalSpent)"></span>
            <span
              class="text-xs font-normal text-blue-200/60"
              x-text="`/ ${formatCurrency(totalAllocated)}`"></span>
          </h2>
        </div>
      </div>

      <!-- 1. MICRO INFO DENGAN FONT ultra-compact (Anti Overlap) -->
      <div
        class="relative z-10 mt-3 grid grid-cols-3 gap-1.5 border-t border-white/10 pt-3"
      >
        <!-- Micro Item 1: Sisa Saldo -->
        <div class="flex min-w-0 items-center gap-1.5">
          <div
            class="flex h-6.5 w-6.5 shrink-0 items-center justify-center rounded-lg border border-emerald-400/20 bg-emerald-500/20 text-emerald-300"
          >
            <PiggyBank class="h-3.5 w-3.5 stroke-[2.2]" />
          </div>
          <div class="flex min-w-0 flex-col leading-none">
            <span
              class="truncate text-[11px] font-black tracking-tight text-emerald-300"
              x-text="formatUltraCompact(totalRemaining)"></span>
            <span
              class="mt-0.5 truncate text-[8.5px] font-medium text-blue-200/60"
              >Sisa Saldo</span
            >
          </div>
        </div>

        <!-- Micro Item 2: Total Kategori -->
        <div class="flex min-w-0 items-center justify-center gap-1.5">
          <div
            class="flex h-6.5 w-6.5 shrink-0 items-center justify-center rounded-lg border border-blue-400/20 bg-blue-500/20 text-blue-300"
          >
            <Grid class="h-3.5 w-3.5 stroke-[2.2]" />
          </div>
          <div class="flex min-w-0 flex-col leading-none">
            <span
              class="truncate text-[11px] font-black tracking-tight text-white"
              x-text="`${budgets.length}`"></span>
            <span
              class="mt-0.5 truncate text-[8.5px] font-medium text-blue-200/60"
              >Kategori</span
            >
          </div>
        </div>

        <!-- Micro Item 3: Warning Limit -->
        <div class="flex min-w-0 items-center justify-end gap-1.5">
          <div
            class="flex h-6.5 w-6.5 shrink-0 items-center justify-center rounded-lg border border-amber-400/20 bg-amber-500/20 text-amber-300"
          >
            <AlertTriangle class="h-3.5 w-3.5 stroke-[2.2]" />
          </div>
          <div class="flex min-w-0 flex-col leading-none">
            <span
              class="truncate text-[11px] font-black tracking-tight text-amber-300"
              x-text="`${warningLimitCount} Limit`"></span>
            <span
              class="mt-0.5 truncate text-[8.5px] font-medium text-blue-200/60"
              >Warning</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- 3. SECTION DAFTAR ANGGARAN PER KATEGORI -->
    <div class="space-y-3 pt-1">
      <div class="flex items-center justify-between px-0.5">
        <span class="text-sm font-bold tracking-tight text-slate-800"
          >Rincian Kategori</span
        >
      </div>

      <!-- EMPTY STATE -->
      <template x-if="processedBudgets.length === 0 && !loading">
        <div
          class="flex flex-col items-center justify-center rounded-3xl border border-dashed border-slate-200 bg-white p-6 text-center shadow-2xs"
        >
          <div
            class="mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-blue-50 text-blue-600"
          >
            <PiggyBank class="h-6 w-6 stroke-[2]" />
          </div>
          <h3 class="text-xs font-bold text-slate-800">Belum Ada Anggaran</h3>
          <p class="mt-1 max-w-[220px] text-[11px] text-slate-400">
            Atur limit anggaran belanja kamu di bulan <span
              class="font-bold text-slate-600"
              x-text="formattedSelectedMonth"></span> biar nggak gampang overspend.
          </p>

          <div class="mt-4 flex w-full flex-col gap-2">
            <template x-if="hasPreviousMonthBudget">
              <button
                type="button"
                @click="copyPreviousBudget()"
                :disabled="isSubmitting"
                class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl bg-blue-600 py-3 text-xs font-bold text-white shadow-md shadow-blue-500/20 transition-all hover:bg-blue-700 active:scale-95 disabled:opacity-50"
              >
                <Copy class="h-4 w-4 stroke-[2.2]" />
                <span x-text="`Salin Budget dari ${previousMonthPeriod}`"
                ></span>
              </button>
            </template>

            <button
              type="button"
              @click="openAddModal()"
              class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-slate-50 py-3 text-xs font-bold text-slate-700 transition-all hover:bg-slate-100 active:scale-95"
            >
              <Plus class="h-4 w-4 stroke-[2.2]" />
              <span>Buat Anggaran Baru</span>
            </button>
          </div>
        </div>
      </template>

      <!-- DAFTAR KARTU KATEGORI DENGAN DYNAMIC ICON & PROGRESS BAR -->
      <div class="space-y-2.5">
        <template x-for="item in processedBudgets" :key="item.id">
          <div
            @click="openEditModal(item)"
            class="group cursor-pointer rounded-3xl border border-slate-200/70 bg-white p-4 shadow-2xs transition-all hover:border-blue-300 hover:shadow-sm active:scale-[0.99]"
          >
            <div
              class="flex items-center justify-between border-b border-slate-100 pb-2.5"
            >
              <!-- Bagian Kartu Kategori (Di dalam template x-for) -->
              <div class="flex items-center gap-3">
                <!-- Dynamic Icon Container -->
                <div
                  :class="`flex h-9.5 w-9.5 shrink-0 items-center justify-center rounded-2xl border ${item.iconColor}`"
                >
                  <template x-if="item.categories?.icon === 'utensils'">
                    <Utensils class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'car'">
                    <Car class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'shopping-bag'">
                    <ShoppingBag class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'receipt'">
                    <Receipt class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'gamepad-2'">
                    <Gamepad2 class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'heart-pulse'">
                    <HeartPulse class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'graduation-cap'">
                    <GraduationCap class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'more-horizontal'">
                    <MoreHorizontal class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'briefcase'">
                    <Briefcase class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'gift'">
                    <Gift class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'trending-up'">
                    <TrendingUp class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'rotate-ccw'">
                    <RotateCcw class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'wallet'">
                    <Wallet class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'arrow-right-left'">
                    <ArrowRightLeft class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'smartphone'">
                    <Smartphone class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'piggy-bank'">
                    <PiggyBank class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'line-chart'">
                    <LineChart class="h-4.5 w-4.5 stroke-2" />
                  </template>
                  <template x-if="item.categories?.icon === 'credit-card'">
                    <CreditCard class="h-4.5 w-4.5 stroke-2" />
                  </template>

                  <!-- Fallback Default Icon -->
                  <template
                    x-if="!['utensils','car','shopping-bag','receipt','gamepad-2','heart-pulse','graduation-cap','more-horizontal','briefcase','gift','trending-up','rotate-ccw','wallet','arrow-right-left','smartphone','piggy-bank','line-chart','credit-card'].includes(item.categories?.icon)"
                  >
                    <Tag class="h-4.5 w-4.5 stroke-2" />
                  </template>
                </div>

                <div class="flex flex-col">
                  <h3
                    class="text-xs leading-tight font-extrabold text-slate-800"
                    x-text="item.categories?.name || 'Kategori'"
                  >
                  </h3>
                  <span class="text-[10px] font-medium text-slate-400">
                    Anggaran: <span
                      class="font-bold text-slate-600"
                      x-text="formatCurrency(item.amount)"></span>
                  </span>
                </div>
              </div>

              <div class="flex items-center gap-1">
                <span
                  :class="`rounded-full border px-2.5 py-0.5 text-[9px] font-bold ${item.badgeColor}`"
                  x-text="`${item.percentage}%`"></span>
                <ChevronRight
                  class="h-4 w-4 stroke-2 text-slate-300 group-hover:text-slate-500"
                />
              </div>
            </div>

            <!-- PROGRESS BAR VISUAL PER KARTU KATEGORI -->
            <div class="space-y-2 pt-3">
              <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
                <div
                  :class="`h-full rounded-full transition-all duration-500 ${item.barColor}`"
                  :style="`width: ${Math.min(item.percentage, 100)}%;`"
                >
                </div>
              </div>

              <div
                class="flex items-center justify-between text-[10px] font-semibold"
              >
                <span class="text-slate-500">
                  Terpakai: <span
                    class="font-bold text-slate-800"
                    x-text="formatCurrency(item.spent)"></span>
                </span>
                <span
                  :class="item.status === 'exceeded' ? 'font-bold text-rose-600' : 'font-bold text-emerald-600'"
                >
                  <span
                    x-text="item.status === 'exceeded' ? 'Over budget: ' : 'Sisa: '"
                  ></span>
                  <span x-text="formatCurrency(Math.abs(item.remaining))"
                  ></span>
                </span>
              </div>
            </div>
          </div>
        </template>
      </div>
    </div>

    <!-- 4. TOMBOL TAMBAH DILUAR -->
    <template x-if="processedBudgets.length > 0">
      <div class="pt-2">
        <button
          type="button"
          @click="openAddModal()"
          class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-dashed border-blue-300 bg-blue-50/40 py-3.5 text-blue-600 shadow-2xs transition-all hover:border-blue-500 hover:bg-blue-100/60 active:scale-95"
        >
          <Plus class="h-4 w-4 stroke-[2.5]" />
          <span class="text-xs font-bold">Buat Anggaran Kategori Baru</span>
        </button>
      </div>
    </template>

    <!-- 5. MODAL FORM BOTTOM SHEET -->
    <div
      x-show="openModal"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 p-3 backdrop-blur-xs sm:p-4"
      style="display: none;"
    >
      <div
        @click.away="openModal = false"
        class="mb-20 w-full max-w-md rounded-3xl border border-slate-200 bg-white p-5 shadow-2xl transition-all sm:mb-6"
      >
        <div
          class="flex items-center justify-between border-b border-slate-100 pb-3"
        >
          <h3
            class="text-sm font-extrabold text-slate-800"
            x-text="isEditMode ? 'Edit Anggaran Kategori' : 'Tambah Anggaran Kategori'"
          >
          </h3>
          <button
            @click="openModal = false"
            class="rounded-full p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700"
          >
            <X class="h-5 w-5" />
          </button>
        </div>

        <form @submit.prevent="saveBudget()" class="space-y-4 pt-4">
          <div>
            <label
              class="mb-1 block text-[11px] font-bold text-slate-600 uppercase"
              >Kategori Pengeluaran</label
            >
            <select
              x-model="formData.category_id"
              :disabled="isEditMode"
              class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-xs font-bold text-slate-800 focus:border-blue-500 focus:bg-white focus:outline-hidden disabled:opacity-60"
            >
              <template
                x-for="cat in availableCategoriesForBudget"
                :key="cat.id"
              >
                <option :value="cat.id" x-text="cat.name"></option>
              </template>
            </select>
          </div>

          <div>
            <label
              class="mb-1 block text-[11px] font-bold text-slate-600 uppercase"
              >Limit Target Anggaran (Rp)</label
            >
            <input
              type="text"
              inputmode="numeric"
              :value="formattedFormAmount"
              @input="handleAmountInput($event)"
              placeholder="Contoh: 1.500.000"
              class="w-full rounded-2xl border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm font-black text-slate-900 focus:border-blue-500 focus:bg-white focus:outline-hidden"
            />
          </div>

          <div class="flex items-center gap-2 pt-2">
            <template x-if="isEditMode">
              <button
                type="button"
                @click="deleteBudget()"
                :disabled="isSubmitting"
                class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-rose-200 bg-rose-50 text-rose-600 hover:bg-rose-100 active:scale-95 disabled:opacity-50"
              >
                <Trash2 class="h-4.5 w-4.5 stroke-2" />
              </button>
            </template>

            <button
              type="submit"
              :disabled="isSubmitting"
              class="flex flex-1 items-center justify-center gap-2 rounded-2xl bg-blue-600 py-3 text-xs font-bold text-white shadow-md shadow-blue-500/20 hover:bg-blue-700 active:scale-95 disabled:opacity-50"
            >
              <span x-text="isSubmitting ? 'Menyimpan...' : 'Simpan Anggaran'"
              ></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { budgetController } from '../controllers/budget.controller';

  declare const Alpine: any;

  document.addEventListener('alpine:init', () => {
    Alpine.data('budgetController', budgetController);
  });
</script>
