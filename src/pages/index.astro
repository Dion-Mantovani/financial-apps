---
import Layout from '../layouts/Layout.astro';
import {
  Search,
  Flame,
  Bell,
  Eye,
  ArrowDownLeft,
  ArrowUpRight,
  Wallet,
  ChevronDown,
  Sparkles,
  Coffee,
  Fuel,
  ParkingMeter,
  Sliders,
  PiggyBank,
  Grid,
  Target,
  Receipt,
  Repeat,
  MoreHorizontal,
  TrendingUp,
  TrendingDown,
  BarChart2,
  ShoppingBag,
  Utensils,
  ChevronRight,
  Briefcase,
  Plus,
  Zap,
  X,
} from '@lucide/astro';

// Contoh state persentase (bisa disetting dinamis nantinya)
const isPositive = true; // ganti false kalau lagi turun
const percentageText = '+12.5%';
const compareText = 'dari bulan lalu';

// Data mock transaksi cepat tersering
const quickActions = [
  { label: 'Kopi', amount: '18rb', icon: Coffee },
  { label: 'Bensin', amount: '35rb', icon: Fuel },
  { label: 'Parkir', amount: '5rb', icon: ParkingMeter },
];

// 3 Fitur Utama + 1 Button Lainnya di Halaman Depan (1 Baris)
const quickFeatures = [
  { label: 'Dompet', icon: Wallet, color: 'text-blue-600 bg-blue-50' },
  {
    label: 'Anggaran',
    icon: PiggyBank,
    color: 'text-emerald-600 bg-emerald-50',
  },
  { label: 'Kategori', icon: Grid, color: 'text-violet-600 bg-violet-50' },
];

// Semua Fitur Lengkap yang Muncul di Dalam Modal Box
const allFeatures = [
  { label: 'Dompet', icon: Wallet, color: 'text-blue-600 bg-blue-50' },
  {
    label: 'Anggaran',
    icon: PiggyBank,
    color: 'text-emerald-600 bg-emerald-50',
  },
  { label: 'Kategori', icon: Grid, color: 'text-violet-600 bg-violet-50' },
  { label: 'Impian', icon: Target, color: 'text-rose-600 bg-rose-50' },
  { label: 'Utang', icon: Receipt, color: 'text-amber-600 bg-amber-50' },
  { label: 'Langganan', icon: Repeat, color: 'text-cyan-600 bg-cyan-50' },
  { label: 'Laporan', icon: BarChart2, color: 'text-indigo-600 bg-indigo-50' },
];

// Data mock pengeluaran mingguan dengan tanggal & hari
const weeklyExpenses = [
  { day: 'Sen', date: '21', amount: '120rb', height: '40%', isHighest: false },
  { day: 'Sel', date: '22', amount: '250rb', height: '70%', isHighest: false },
  { day: 'Rab', date: '23', amount: '85rb', height: '30%', isHighest: false },
  { day: 'Kam', date: '24', amount: '410rb', height: '100%', isHighest: true }, // Peak spending
  { day: 'Jum', date: '25', amount: '190rb', height: '55%', isHighest: false },
  { day: 'Sab', date: '26', amount: '300rb', height: '80%', isHighest: false },
  { day: 'Ming', date: '27', amount: '60rb', height: '20%', isHighest: false },
];

// Data Mock 5 Aktivitas Terakhir (Micro Info: Kategori • Wallet | Color Scheme: Merah, Hijau, Biru)
const recentTransactions = [
  {
    id: 1,
    title: 'Supermarket Hero',
    category: 'Belanja',
    wallet: 'BCA',
    amount: '- Rp 185.000',
    type: 'expense',
    icon: ShoppingBag,
    color: 'text-rose-600 bg-rose-50 border-rose-100',
  },
  {
    id: 2,
    title: 'Gaji Freelance Studion',
    category: 'Pemasukan',
    wallet: 'Mandiri',
    amount: '+ Rp 3.500.000',
    type: 'income',
    icon: Briefcase,
    color: 'text-emerald-600 bg-emerald-50 border-emerald-100',
  },
  {
    id: 3,
    title: 'Kopi Kenangan',
    category: 'Makanan & Minuman',
    wallet: 'GoPay',
    amount: '- Rp 28.000',
    type: 'expense',
    icon: Utensils,
    color: 'text-rose-600 bg-rose-50 border-rose-100',
  },
  {
    id: 4,
    title: 'Tagihan Listrik PLN',
    category: 'Utilitas',
    wallet: 'BCA',
    amount: '- Rp 245.000',
    type: 'expense',
    icon: Zap,
    color: 'text-blue-600 bg-blue-50 border-blue-100',
  },
  {
    id: 5,
    title: 'Transfer Reksa Dana',
    category: 'Investasi',
    wallet: 'Bibit',
    amount: '+ Rp 500.000',
    type: 'income',
    icon: ArrowDownLeft,
    color: 'text-emerald-600 bg-emerald-50 border-emerald-100',
  },
];
---

<Layout title="Dashboard - Financial Tracker">
  <!-- Top User Bar / Header Dashboard -->
  <div class="mt-7 flex items-center justify-between">
    <!-- Profile & Greeting (Left Side) -->
    <div class="flex items-center gap-3">
      <!-- User Avatar -->
      <div
        class="relative flex h-10 w-10 shrink-0 overflow-hidden rounded-full border border-slate-200/80 shadow-xs"
      >
        <img
          src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&auto=format&fit=crop&q=80"
          alt="Avatar User"
          class="h-full w-full object-cover"
        />
      </div>

      <!-- Greeting & Name -->
      <div class="flex flex-col">
        <span class="text-[11px] font-medium text-slate-500">Good morning,</span
        >
        <h1
          class="text-sm font-bold tracking-tight text-slate-900 sm:text-base"
        >
          Muhamad Dion
        </h1>
      </div>
    </div>

    <!-- Actions (Right Side) -->
    <div class="flex items-center gap-2">
      <!-- Flame Button with Indicator Dot -->
      <button
        type="button"
        class="relative flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl border border-slate-200/80 bg-white text-slate-600 shadow-xs transition-colors hover:bg-slate-50 active:scale-95"
        aria-label="Streak"
      >
        <Flame class="h-4.5 w-4.5 stroke-2" />
      </button>

      <!-- Notification Button with Indicator Dot -->
      <button
        type="button"
        class="relative flex h-9 w-9 cursor-pointer items-center justify-center rounded-xl border border-slate-200/80 bg-white text-slate-600 shadow-xs transition-colors hover:bg-slate-50 active:scale-95"
        aria-label="Notifikasi"
      >
        <Bell class="h-4.5 w-4.5 stroke-2" />
        <!-- Notification Red Dot -->
        <span class="absolute top-2 right-2 h-2 w-2 rounded-full bg-blue-600"
        ></span>
      </button>
    </div>
  </div>

  <!-- Glassmorphism Resume Card dengan Interaktivitas Alpine.js -->
  <div
    x-data="{ showDetails: false }"
    class="relative overflow-hidden rounded-3xl border border-white/15 bg-linear-to-br from-blue-900/90 via-blue-950/95 to-slate-950 p-5 text-white shadow-2xl shadow-blue-950/40 backdrop-blur-xl"
  >
    <!-- Pola Grid Kotak-Kotak Kaca (SVG Pattern di Sudut Kanan Bawah) -->
    <div
      class="pointer-events-none absolute right-0 bottom-0 h-full w-full overflow-hidden rounded-br-3xl opacity-25"
    >
      <svg
        class="h-full w-full"
        width="100%"
        height="100%"
        xmlns="http://www.w3.org/2000/svg"
      >
        <defs>
          <pattern
            id="grid-pattern"
            width="16"
            height="16"
            patternUnits="userSpaceOnUse"
          >
            <path
              d="M 16 0 L 0 0 0 16"
              fill="none"
              stroke="rgba(255, 255, 255, 0.4)"
              stroke-width="1.2"></path>
          </pattern>
          <radialGradient id="grid-fade" cx="100%" cy="100%" r="100%">
            <stop offset="0%" stop-color="white" stop-opacity="1"></stop>
            <stop offset="80%" stop-color="white" stop-opacity="0"></stop>
          </radialGradient>
          <mask id="grid-mask">
            <rect width="100%" height="100%" fill="url(#grid-fade)"></rect>
          </mask>
        </defs>
        <rect
          width="100%"
          height="100%"
          fill="url(#grid-pattern)"
          mask="url(#grid-mask)"></rect>
      </svg>
    </div>

    <!-- Efek Inner Glow Cahaya -->
    <div
      class="pointer-events-none absolute -top-12 -left-12 h-36 w-36 rounded-full bg-blue-500/25 blur-2xl"
    >
    </div>
    <div
      class="pointer-events-none absolute -right-12 -bottom-12 h-36 w-36 rounded-full bg-cyan-400/15 blur-2xl"
    >
    </div>

    <!-- Highlights Inner Border Reflection -->
    <div
      class="pointer-events-none absolute inset-0 rounded-3xl bg-linear-to-br from-white/10 via-transparent to-transparent"
    >
    </div>

    <!-- BARIS ATAS: Total Saldo & Icon Mata -->
    <div class="relative z-10 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div
          class="flex h-7 w-7 items-center justify-center rounded-xl border border-white/15 bg-white/10 shadow-inner backdrop-blur-md"
        >
          <Wallet class="h-4 w-4 stroke-2 text-blue-200" />
        </div>
        <span class="text-xs font-medium tracking-wide text-blue-200/80"
          >Total Saldo</span
        >
      </div>

      <button
        type="button"
        class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full border border-white/15 bg-white/10 text-blue-100 shadow-xs backdrop-blur-md transition-all hover:bg-white/20 active:scale-95"
        aria-label="Sembunyikan Saldo"
      >
        <Eye class="h-4 w-4 stroke-2" />
      </button>
    </div>

    <!-- Nominal Total Saldo -->
    <div class="relative z-10 mt-3 mb-2">
      <h2
        class="text-3xl font-extrabold tracking-tight text-white drop-shadow-sm sm:text-3xl"
      >
        Rp 14.850.000
      </h2>

      <!-- Micro Info Persentase (Glass Micro Pill) -->
      <div class="flex items-center gap-2 pt-0.5">
        <div
          class={`flex items-center gap-1 rounded-full border px-2 py-0.5 text-[10px] font-bold backdrop-blur-md ${
            isPositive
              ? 'border-emerald-400/30 bg-emerald-500/15 text-emerald-300'
              : 'border-rose-400/30 bg-rose-500/15 text-rose-300'
          }`}
        >
          {
            isPositive ? (
              <TrendingUp class="h-3 w-3 stroke-[2.5]" />
            ) : (
              <TrendingDown class="h-3 w-3 stroke-[2.5]" />
            )
          }
          <span>{percentageText}</span>
        </div>
        <span class="text-[10px] font-medium text-blue-200/60"
          >{compareText}</span
        >
      </div>
    </div>

    <!-- TOMBOL EXPAND BIKIN PENASARAN (Glass Button) -->
    <div class="relative z-10 mt-4">
      <button
        type="button"
        @click="showDetails = !showDetails"
        class="flex w-fit cursor-pointer items-center gap-2 rounded-2xl border border-white/15 bg-linear-to-r from-white/10 via-white/5 to-white/10 px-3.5 py-2 text-xs font-semibold text-blue-100 shadow-xs backdrop-blur-md transition-all hover:bg-white/15 hover:text-white active:scale-[0.98]"
      >
        <Sparkles class="h-3.5 w-3.5 animate-pulse stroke-2 text-blue-300" />
        <span x-text="showDetails ? 'Tutup Detail' : 'Lihat Detail'">
          Lihat Detail
        </span>
        <ChevronDown
          class="h-4 w-4 stroke-[2.5] text-blue-200 transition-transform duration-300"
          :class="showDetails ? 'rotate-180' : ''"
        />
      </button>
    </div>

    <!-- CONTAINER Rincian Pemasukan & Pengeluaran (Expandable) -->
    <div
      x-show="showDetails"
      x-collapse
      class="relative z-10 space-y-3 pt-3"
      x-cloak
    >
      <div
        class="h-px w-full bg-linear-to-r from-transparent via-white/15 to-transparent"
      >
      </div>

      <!-- Label Periode Transparan -->
      <div
        class="flex items-center justify-between px-1 text-[10px] font-medium text-blue-200/70"
      >
        <span>Periode Agustus 2026</span>
        <span
          class="rounded-full border border-white/10 bg-white/10 px-2 py-0.5 text-[9px] text-blue-200"
          >Aktif</span
        >
      </div>

      <div class="grid grid-cols-2 gap-2.5 pt-0.5">
        <!-- Item Pemasukan -->
        <div
          class="flex items-center gap-2.5 rounded-2xl border border-white/5 bg-white/4 p-2.5 backdrop-blur-sm"
        >
          <div
            class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-emerald-400/30 bg-emerald-500/20 text-emerald-300 shadow-xs"
          >
            <ArrowDownLeft class="h-3 w-3 stroke-[2.5]" />
          </div>
          <div class="flex flex-col">
            <span class="text-[10px] font-medium text-blue-200/70"
              >Pemasukan</span
            >
            <span class="text-[11px] font-bold text-white">Rp 8.500.000</span>
          </div>
        </div>

        <!-- Item Pengeluaran -->
        <div
          class="flex items-center gap-2.5 rounded-2xl border border-white/5 bg-white/4 p-2.5 backdrop-blur-sm"
        >
          <div
            class="flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-rose-400/30 bg-rose-500/20 text-rose-300 shadow-xs"
          >
            <ArrowUpRight class="h-3 w-3 stroke-[2.5]" />
          </div>
          <div class="flex flex-col">
            <span class="text-[10px] font-medium text-blue-200/70"
              >Pengeluaran</span
            >
            <span class="text-[11px] font-bold text-white">Rp 3.650.000</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Fitur Keuangan Clean & Monokromatik -->
  <div x-data="{ openModal: false }" class="pt-2">
    <!-- Grid 1 Baris Langsung Tanpa Judul & Card Outter -->
    <div class="grid grid-cols-4 gap-2">
      {
        quickFeatures.map((item) => (
          <button
            type="button"
            class="group flex cursor-pointer flex-col items-center justify-center gap-1.5 py-1 transition-all active:scale-95"
          >
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-600 transition-all group-hover:bg-blue-600 group-hover:text-white group-hover:shadow-md group-hover:shadow-blue-500/20">
              <item.icon class="h-5 w-5 stroke-2" />
            </div>
            <span class="text-[10px] font-semibold text-slate-700 transition-colors group-hover:text-blue-600">
              {item.label}
            </span>
          </button>
        ))
      }

      <!-- Tombol 4: Lainnya -->
      <button
        type="button"
        @click="openModal = true"
        class="group flex cursor-pointer flex-col items-center justify-center gap-1.5 py-1 transition-all active:scale-95"
      >
        <div
          class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-all group-hover:bg-blue-600 group-hover:text-white group-hover:shadow-md group-hover:shadow-blue-500/20"
        >
          <MoreHorizontal class="h-5 w-5 stroke-2" />
        </div>
        <span
          class="text-[10px] font-semibold text-slate-700 transition-colors group-hover:text-blue-600"
        >
          Lainnya
        </span>
      </button>
    </div>

    <!-- MODAL BOX FITUR LENGKAP -->
    <template x-teleport="body">
      <div
        x-show="openModal"
        class="fixed inset-0 z-50 flex items-end justify-center sm:items-center"
        style="display: none;"
        x-cloak
      >
        <!-- Backdrop Overlay Dark Blur -->
        <div
          x-cloak
          x-show="openModal"
          x-transition:enter="ease-out duration-300"
          x-transition:enter-start="opacity-0"
          x-transition:enter-end="opacity-100"
          x-transition:leave="ease-in duration-200"
          x-transition:leave-start="opacity-100"
          x-transition:leave-end="opacity-0"
          @click="openModal = false"
          class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs"
        >
        </div>

        <!-- Modal Card Body -->
        <div
          x-cloak
          x-show="openModal"
          x-transition:enter="ease-out duration-300"
          x-transition:enter-start="opacity-0 translate-y-8 scale-95"
          x-transition:enter-end="opacity-100 translate-y-0 scale-100"
          x-transition:leave="ease-in duration-200"
          x-transition:leave-start="opacity-100 translate-y-0 scale-100"
          x-transition:leave-end="opacity-0 translate-y-8 scale-95"
          class="relative z-10 w-full max-w-md rounded-t-3xl border border-slate-200 bg-white p-5 shadow-2xl sm:rounded-3xl"
        >
          <!-- Modal Drag Handle -->
          <div
            class="mx-auto -mt-1 mb-4 h-1 w-10 rounded-full bg-slate-200 sm:hidden"
          >
          </div>

          <!-- Modal Header (Dengan Tombol Slider/Setting di Kanan) -->
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-4"
          >
            <div>
              <h4 class="text-sm font-bold text-slate-900">Semua Fitur</h4>
              <p class="text-[10px] font-medium text-slate-400">
                Pilih menu fitur yang ingin kamu akses
              </p>
            </div>

            <!-- Actions: Slider/Setting & Close -->
            <div class="flex items-center gap-1.5">
              <button
                type="button"
                class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-slate-100 text-slate-600 transition-colors hover:bg-slate-200 active:scale-95"
                aria-label="Atur Urutan Fitur"
              >
                <Sliders class="h-3.5 w-3.5 stroke-2" />
              </button>
              <button
                type="button"
                @click="openModal = false"
                class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-slate-100 text-slate-500 transition-colors hover:bg-slate-200 active:scale-95"
              >
                <X class="h-4 w-4 stroke-2" />
              </button>
            </div>
          </div>

          <!-- All Features Grid inside Modal (Bulat & Single Theme Color) -->
          <div class="grid grid-cols-4 gap-3 pt-4">
            {
              allFeatures.map((item) => (
                <button
                  type="button"
                  class="group flex cursor-pointer flex-col items-center justify-center gap-1.5 py-1.5 transition-all active:scale-95"
                >
                  <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-600 transition-all group-hover:bg-blue-600 group-hover:text-white group-hover:shadow-md group-hover:shadow-blue-500/20">
                    <item.icon class="h-5 w-5 stroke-2" />
                  </div>
                  <span class="text-[10px] font-semibold text-slate-700 transition-colors group-hover:text-blue-600">
                    {item.label}
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Section Catat Cepat (Card Wrapper Premium Glass-Glow) -->
  <div class="pt-2">
    <div
      class="relative overflow-hidden rounded-3xl border border-blue-100/80 bg-linear-to-br from-white via-blue-50/30 to-slate-50 p-4 shadow-sm"
    >
      <!-- Pattern Dots Accent di Sudut Kanan Atas -->
      <div
        class="pointer-events-none absolute -top-2 -right-2 h-24 w-24 opacity-20 mix-blend-multiply"
        style="background-image: radial-gradient(circle, #2563eb 1px, transparent 1px); background-size: 8px 8px; mask-image: radial-gradient(circle at top right, black 30%, transparent 80%); -webkit-mask-image: radial-gradient(circle at top right, black 30%, transparent 80%);"
      >
      </div>

      <!-- Layout Inner Split-View -->
      <div class="relative z-10 flex items-center gap-3.5">
        <!-- SISI KIRI: Logo Petir -->
        <div
          class="relative flex h-13 w-13 shrink-0 items-center justify-center rounded-2xl bg-linear-to-br from-blue-600 to-blue-700 text-white shadow-md shadow-blue-600/25"
        >
          <Zap class="h-6 w-6 fill-white/20 stroke-[2.2]" />
          <div
            class="absolute inset-0 rounded-2xl bg-linear-to-br from-white/20 via-transparent to-transparent"
          >
          </div>
        </div>

        <!-- SISI KANAN: Judul + List Pill -->
        <div class="relative flex min-w-0 flex-1 flex-col space-y-2">
          <!-- Header & Status Tag -->
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="text-sm font-bold tracking-tight text-slate-800"
                >Catat Cepat</span
              >
              <span
                class="rounded-full bg-blue-100/80 px-2 py-0.5 text-[9px] font-bold text-blue-600"
              >
                One-click
              </span>
            </div>
          </div>

          <!-- CONTAINER WRAPPER UNTUK OVERLAY FADING MASK -->
          <div class="relative w-full">
            <!-- Deretan Pill (Scroll Horizontal) -->
            <div
              class="no-scrollbar flex items-center gap-1.5 overflow-x-auto pr-6 pb-0.5"
            >
              {
                quickActions.map((item) => (
                  <button
                    type="button"
                    class="group flex shrink-0 cursor-pointer items-center gap-1.5 rounded-xl border border-slate-200/90 bg-white/90 px-2.5 py-1.5 shadow-2xs backdrop-blur-xs transition-all hover:border-blue-500 hover:bg-blue-50/50 hover:shadow-xs active:scale-95"
                  >
                    <item.icon class="h-3.5 w-3.5 shrink-0 stroke-2 text-slate-500 group-hover:text-blue-600" />
                    <span class="text-[11px] font-semibold text-slate-700 group-hover:text-slate-900">
                      {item.label}
                    </span>
                    <span class="text-[10px] font-bold text-blue-600">
                      {item.amount}
                    </span>
                  </button>
                ))
              }

              <!-- Pill Tambah (+ Tambah) -->
              <button
                type="button"
                class="flex shrink-0 cursor-pointer items-center gap-1 rounded-xl border border-dashed border-blue-300/80 bg-blue-50/40 px-2.5 py-1.5 text-blue-600 transition-all hover:border-blue-500 hover:bg-blue-100/60 active:scale-95"
                aria-label="Tambah Catat Cepat"
              >
                <Plus class="h-3.5 w-3.5 stroke-[2.5]" />
                <span class="text-[10px] font-bold">Tambah</span>
              </button>
            </div>

            <!-- EFEK FADING MASK DI UJUNG KANAN (Penyamar Potongan Pill) -->
            <div
              class="pointer-events-none absolute top-0 right-0 bottom-0 w-8 bg-linear-to-l from-slate-50/90 via-slate-50/40 to-transparent"
            >
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Section Grafik Pengeluaran Mingguan -->
  <div class="space-y-2.5 pt-2">
    <!-- Judul Section Di Luar Card -->
    <div class="flex items-center justify-between px-0.5">
      <span class="text-sm font-bold text-slate-700">Pengeluaran Mingguan</span>
    </div>

    <!-- Card Container Chart Main -->
    <div
      class="relative space-y-4 overflow-hidden rounded-3xl border border-slate-200/70 bg-white p-4 shadow-sm"
    >
      <!-- BARIS ATAS DALAM CARD: Periode Bulan (Kiri) & Total Nominal Red Pill (Kanan) -->
      <div
        class="flex items-center justify-between border-b border-slate-100 pb-3"
      >
        <!-- Periode Bulan Langsung Tanpa Label Header -->
        <span class="text-sm font-bold text-slate-700">Agustus</span>

        <!-- Total Mingguan dalam Red Transparent Pill -->
        <div
          class="flex items-center gap-1.5 rounded-full border border-rose-200/60 bg-rose-50/70 px-2.5 py-1 backdrop-blur-xs"
        >
          <TrendingDown class="h-2.5 w-2.5 stroke-[2.5] text-rose-500" />
          <span class="text-[11px] font-bold text-rose-500">Rp 1.415.000</span>
        </div>
      </div>

      <!-- BAR CHART GRID (Senin - Minggu + Tanggal) -->
      <div class="grid h-32 grid-cols-7 items-end gap-2 pt-2">
        {
          weeklyExpenses.map((item) => (
            <div class="group flex h-full cursor-pointer flex-col items-center justify-end">
              <span class="mb-1 text-[9px] font-bold text-slate-600 opacity-0 transition-opacity group-hover:opacity-100">
                {item.amount}
              </span>

              <div class="flex h-full w-full max-w-4.5 flex-col justify-end overflow-hidden rounded-md bg-slate-100">
                <div
                  class={`w-full rounded-md transition-all duration-300 ${
                    item.isHighest
                      ? 'bg-blue-600 shadow-xs shadow-blue-500/30'
                      : 'bg-blue-200 group-hover:bg-blue-400'
                  }`}
                  style={`height: ${item.height};`}
                />
              </div>

              <div class="mt-2 flex flex-col items-center leading-tight">
                <span
                  class={`text-[10px] font-medium ${
                    item.isHighest
                      ? 'font-bold text-blue-600'
                      : 'text-slate-400 group-hover:text-slate-700'
                  }`}
                >
                  {item.day}
                </span>
                <span
                  class={`text-[10px] font-bold ${
                    item.isHighest ? 'text-blue-600' : 'text-slate-700'
                  }`}
                >
                  {item.date}
                </span>
              </div>
            </div>
          ))
        }
      </div>

      <!-- BARIS BAWAH DALAM CARD: Tombol Pill "Lihat Analitik" (Kiri) -->
      <div
        class="flex items-center justify-start border-t border-slate-100/80 pt-2"
      >
        <button
          type="button"
          class="flex cursor-pointer items-center gap-1 rounded-full border border-blue-200/80 bg-blue-50/60 px-3 py-1.5 text-[11px] font-bold text-blue-600 shadow-2xs transition-all hover:border-blue-600 hover:bg-blue-600 hover:text-white active:scale-95"
        >
          <span>Lihat Analitik</span>
          <ChevronRight class="h-3.5 w-3.5 stroke-[2.5]" />
        </button>
      </div>
    </div>
  </div>

  <!-- Section Aktivitas Terakhir (5 Transaksi) -->
  <div class="space-y-2.5 pt-2">
    <!-- Header Section -->
    <div class="flex items-center justify-between px-0.5">
      <span class="text-sm font-bold tracking-tight text-slate-800"
        >Aktivitas Terakhir</span
      >
      <a
        href="#"
        class="flex items-center gap-0.5 text-xs font-semibold text-blue-600 transition-colors hover:text-blue-700"
      >
        <span>Lihat Semua</span>
        <ChevronRight class="h-3 w-3 stroke-[2.5]" />
      </a>
    </div>

    <!-- List 5 Transaksi (Card Container) -->
    <div
      class="divide-y divide-slate-100 rounded-3xl border border-slate-200/70 bg-white shadow-sm"
    >
      {
        recentTransactions.map((item) => (
          <div class="flex cursor-pointer items-center justify-between p-3.5 transition-colors first:rounded-t-3xl last:rounded-b-3xl hover:bg-slate-50/80">
            <div class="flex min-w-0 items-center gap-3">
              <div
                class={`flex h-9.5 w-9.5 shrink-0 items-center justify-center rounded-2xl border ${item.color}`}
              >
                <item.icon class="h-4.5 w-4.5 stroke-2" />
              </div>
              <div class="flex min-w-0 flex-col">
                <span class="truncate text-xs font-bold text-slate-800">
                  {item.title}
                </span>
                <span class="text-[10px] font-medium text-slate-400">
                  {item.category} •{' '}
                  <span class="font-semibold text-slate-500">
                    {item.wallet}
                  </span>
                </span>
              </div>
            </div>

            <div class="flex shrink-0 items-center gap-1 pl-2">
              <span
                class={`text-xs font-bold ${
                  item.type === 'income' ? 'text-emerald-600' : 'text-slate-800'
                }`}
              >
                {item.amount}
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</Layout>
