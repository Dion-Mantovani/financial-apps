---
import Layout from '../layouts/Layout.astro';
import {
  Flame,
  Bell,
  Eye,
  EyeOff,
  ArrowDownLeft,
  ArrowUpRight,
  Wallet,
  ChevronDown,
  Sparkles,
  Grid,
  Target,
  Receipt,
  Repeat,
  TrendingUp,
  TrendingDown,
  ChevronRight,
  Plus,
  Zap,
  X,
  Check,
  Utensils,
  Car,
  CreditCard,
} from '@lucide/astro';
---

<Layout title="Dashboard - Financial Tracker">
  <div
    x-data="{
      hideBalance: false,
      showDetails: false,
      openModal: false,
      isReorderingFeatures: false,
      openCustomQuickModal: false,
      showToast: false,
      toastMessage: '',
      allFeatures: [
        { id: 'wallet', label: 'Dompet', icon: 'wallet', href: '/wallet' },
        { id: 'categories', label: 'Kategori', icon: 'grid', href: '/categories' },
        { id: 'goals', label: 'Impian', icon: 'target', href: '/goals' },
        { id: 'debts', label: 'Utang', icon: 'receipt', href: '/debts' },
        { id: 'subscriptions', label: 'Langganan', icon: 'repeat', href: '/subscriptions' },
        { id: 'bills', label: 'Tagihan', icon: 'credit-card', href: '/bills' }
      ],
      frequentTransactions: [
        { title: 'Kopi Kenangan', amount: 25000 },
        { title: 'Bensin Pertamax', amount: 50000 },
        { title: 'Makan Siang', amount: 35000 },
        { title: 'Topup Gopay', amount: 100000 }
      ],
      recentTransactions: [
        { id: 1, title: 'Kopi Kenangan', category: 'Makanan & Minuman', wallet: 'BCA Utama', amount: 'Rp 25.000', type: 'expense', icon: 'utensils' },
        { id: 2, title: 'Gaji Bulanan', category: 'Pekerjaan', wallet: 'BCA Utama', amount: 'Rp 8.500.000', type: 'income', icon: 'wallet' },
        { id: 3, title: 'Bensin Pertamax', category: 'Transportasi', wallet: 'Gopay', amount: 'Rp 50.000', type: 'expense', icon: 'car' }
      ],
      triggerToast(msg) {
        this.toastMessage = msg;
        this.showToast = true;
        setTimeout(() => { this.showToast = false; }, 2500);
      }
    }"
    class="space-y-6 pt-2 pb-16"
  >
    <!-- 1. HEADER -->
    <div class="flex items-center justify-between pt-2">
      <div class="flex flex-col gap-0.5">
        <h1
          class="text-primary text-base font-extrabold tracking-tight sm:text-lg"
        >
          Malam, Muhamad Dion
        </h1>
        <span class="text-muted-foreground text-[11px] font-medium">
          Sabtu, 12 September 2026
        </span>
      </div>

      <!-- Button Right (Streak & Notification) -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="border-border bg-card text-muted-foreground hover:bg-muted relative flex h-9.5 w-9.5 cursor-pointer items-center justify-center rounded-2xl border shadow-xs transition-all active:scale-95"
        >
          <Flame class="h-4.5 w-4.5 stroke-2" />
        </button>
        <button
          type="button"
          class="border-border bg-card text-muted-foreground hover:bg-muted relative flex h-9.5 w-9.5 cursor-pointer items-center justify-center rounded-2xl border shadow-xs transition-all active:scale-95"
        >
          <Bell class="h-4.5 w-4.5 stroke-2" />
          <span
            class="bg-blue-main absolute top-2.5 right-2.5 h-2 w-2 rounded-full"
          ></span>
        </button>
      </div>
    </div>

    <!-- 2. MAIN CARD -->
    <div
      class="bg-card-blue-dark shadow-soft relative overflow-hidden rounded-[28px] p-6 text-white transition-all duration-300"
    >
      <!-- Watermark Lingkaran Halus -->
      <div
        class="pointer-events-none absolute -right-8 -bottom-10 h-40 w-40 rounded-full bg-white/10"
      >
      </div>
      <div
        class="pointer-events-none absolute right-16 -bottom-16 h-32 w-32 rounded-full bg-white/5"
      >
      </div>

      <!-- Header Card: Title & Eye Toggle -->
      <div class="relative z-10 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-xl bg-white/15 backdrop-blur-md"
          >
            <Wallet class="h-4 w-4 stroke-[2.2] text-white" />
          </div>
          <span class="text-xs font-semibold tracking-wide text-white/80"
            >Total Saldo</span
          >
        </div>

        <button
          type="button"
          @click="hideBalance = !hideBalance"
          class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-md transition-all hover:bg-white/25 active:scale-95"
        >
          <template x-if="!hideBalance">
            <Eye class="h-4 w-4 stroke-2" />
          </template>
          <template x-if="hideBalance">
            <EyeOff class="h-4 w-4 stroke-2" />
          </template>
        </button>
      </div>

      <!-- Nominal Total Saldo -->
      <div class="relative z-10 mt-5 mb-2">
        <h2
          x-text="hideBalance ? 'Rp ••••••••' : 'Rp 14.250.000'"
          class="text-3xl font-extrabold tracking-tight text-white drop-shadow-xs"
        >
          Rp 14.250.000
        </h2>
        <div class="flex items-center gap-2 pt-2">
          <div
            class="flex items-center gap-1 rounded-full bg-white/20 px-2.5 py-0.5 text-[10px] font-bold text-white backdrop-blur-md"
          >
            <TrendingUp class="h-3 w-3 stroke-[2.5]" />
            <span>+12.5%</span>
          </div>
          <span class="text-[10px] font-medium text-white/70"
            >dari awal bulan</span
          >
        </div>
      </div>

      <!-- Tombol Expand Detail -->
      <div class="relative z-10 mt-5">
        <button
          type="button"
          @click="showDetails = !showDetails"
          class="flex w-fit cursor-pointer items-center gap-2 rounded-2xl bg-white/15 px-3.5 py-1.5 text-xs font-semibold text-white backdrop-blur-md transition-all hover:bg-white/25 active:scale-95"
        >
          <Sparkles class="h-3.5 w-3.5 stroke-[2.2]" />
          <span x-text="showDetails ? 'Tutup Detail' : 'Lihat Detail'"
            >Lihat Detail</span
          >
          <ChevronDown
            class="h-4 w-4 stroke-[2.5] transition-transform duration-300"
            :class="showDetails ? 'rotate-180' : ''"
          />
        </button>
      </div>

      <!-- Smooth Collapse Inner Container -->
      <div
        x-show="showDetails"
        x-collapse
        class="relative z-10 overflow-hidden"
        x-cloak
      >
        <div class="space-y-3 pt-5">
          <div class="h-px w-full bg-white/15"></div>
          <div
            class="flex items-center justify-between px-1 text-[10px] font-medium text-white/70"
          >
            <span>Periode Bulan Ini</span>
            <span
              class="rounded-full bg-white/20 px-2 py-0.5 text-[9px] text-white"
              >Aktif</span
            >
          </div>
          <div class="grid grid-cols-2 gap-2.5 pt-0.5">
            <div
              class="flex items-center gap-2.5 rounded-2xl bg-white/10 p-3 backdrop-blur-xs"
            >
              <div
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-white/20 text-white"
              >
                <ArrowDownLeft class="h-3.5 w-3.5 stroke-[2.5]" />
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] font-medium text-white/70"
                  >Pemasukan</span
                >
                <span
                  x-text="hideBalance ? 'Rp ••••••' : 'Rp 8.500.000'"
                  class="text-[11px] font-bold text-white">Rp 8.500.000</span
                >
              </div>
            </div>
            <div
              class="flex items-center gap-2.5 rounded-2xl bg-white/10 p-3 backdrop-blur-xs"
            >
              <div
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-xl bg-white/20 text-white"
              >
                <ArrowUpRight class="h-3.5 w-3.5 stroke-[2.5]" />
              </div>
              <div class="flex flex-col">
                <span class="text-[10px] font-medium text-white/70"
                  >Pengeluaran</span
                >
                <span
                  x-text="hideBalance ? 'Rp ••••••' : 'Rp 3.250.000'"
                  class="text-[11px] font-bold text-white">Rp 3.250.000</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. DAFTAR MENU (Dengan Efek Fade Gradient Halus di Kiri & Kanan) -->
    <div class="space-y-3">
      <!-- Outer Relative Wrapper untuk menampung efek Fade Blur Gradient -->
      <div class="relative w-full">
        <!-- Overlay Gradient Kiri (Fade in dari background) -->
        <div
          class="from-background pointer-events-none absolute top-0 bottom-0 left-0 z-10 w-4 bg-linear-to-r to-transparent"
        >
        </div>

        <!-- Scrollable Container -->
        <div
          class="no-scrollbar flex items-center gap-1 overflow-x-auto px-1 py-1"
        >
          <template x-for="item in allFeatures" :key="item.id">
            <a
              :href="item.href"
              class="group flex w-[4.35rem] shrink-0 cursor-pointer flex-col items-center gap-2 transition-all active:scale-95"
            >
              <div
                class="border-border bg-card text-muted-foreground group-hover:border-blue-main/40 group-hover:bg-blue-soft group-hover:text-blue-main group-hover:shadow-soft flex h-10 w-10 items-center justify-center rounded-2xl border shadow-xs transition-all"
              >
                <template x-if="item.icon === 'wallet'">
                  <Wallet class="h-4.5 w-4.5 stroke-2" />
                </template>
                <template x-if="item.icon === 'grid'">
                  <Grid class="h-4.5 w-4.5 stroke-2" />
                </template>
                <template x-if="item.icon === 'target'">
                  <Target class="h-4.5 w-4.5 stroke-2" />
                </template>
                <template x-if="item.icon === 'receipt'">
                  <Receipt class="h-4.5 w-4.5 stroke-2" />
                </template>
                <template x-if="item.icon === 'repeat'">
                  <Repeat class="h-4.5 w-4.5 stroke-2" />
                </template>
                <template x-if="item.icon === 'credit-card'">
                  <CreditCard class="h-4.5 w-4.5 stroke-2" />
                </template>
              </div>
              <span
                class="text-muted-foreground group-hover:text-primary truncate text-[10px] font-semibold transition-colors"
                x-text="item.label"></span>
            </a>
          </template>
        </div>

        <!-- Overlay Gradient Kanan (Fade out ke background untuk menu ke-5) -->
        <div
          class="from-background pointer-events-none absolute top-0 right-0 bottom-0 z-10 w-6 bg-linear-to-l to-transparent"
        >
        </div>
      </div>
    </div>

    <!-- 4. CATAT CEPAT (Card Soft dengan Ornamen Biru Kontras & Ukuran Beda) -->
    <div class="space-y-3">
      <div class="flex items-center justify-between px-1">
        <div class="flex items-center gap-2">
          <div
            class="bg-blue-soft text-primary flex h-6 w-6 items-center justify-center rounded-lg shadow-xs"
          >
            <Zap class="h-3.5 w-3.5 fill-current stroke-2" />
          </div>
          <span class="text-primary text-xs font-extrabold tracking-tight"
            >Catat Cepat</span
          >
          <span
            class="bg-blue-soft text-blue-main rounded-full px-2 py-0.5 text-[9px] font-extrabold"
            >One Click Instant</span
          >
        </div>
        <button
          type="button"
          @click="openCustomQuickModal = true"
          class="text-blue-main hover:text-primary flex items-center gap-1 text-[11px] font-bold transition-colors"
        >
          <Plus class="h-3.5 w-3.5 stroke-[2.5]" />
          <span>Custom</span>
        </button>
      </div>

      <!-- Card Soft dengan Ornamen Lingkaran Gelap Kontras -->
      <div
        class="border-border bg-card shadow-soft relative overflow-hidden rounded-[26px] border p-4"
      >
        <div
          class="no-scrollbar relative z-10 flex items-center gap-2.5 overflow-x-auto"
        >
          <template x-for="(item, index) in frequentTransactions" :key="index">
            <button
              type="button"
              @click="triggerToast(`Tercatat: ${item.title}`)"
              class="group border-border bg-card/90 hover:border-blue-main hover:bg-blue-soft flex shrink-0 cursor-pointer items-center gap-2.5 rounded-2xl border px-3.5 py-2.5 shadow-xs transition-all active:scale-95"
            >
              <div
                class="bg-blue-soft text-blue-main group-hover:bg-blue-main flex h-6.5 w-6.5 items-center justify-center rounded-xl transition-colors group-hover:text-white"
              >
                <Zap class="h-3.5 w-3.5 stroke-[2.5]" />
              </div>
              <div class="flex flex-col text-left">
                <span
                  class="text-foreground text-[11px] font-bold"
                  x-text="item.title"></span>
                <span
                  class="text-blue-main text-[10px] font-extrabold"
                  x-text="`Rp ${item.amount.toLocaleString('id-ID')}`"></span>
              </div>
            </button>
          </template>
        </div>
      </div>
    </div>

    <!-- TOAST NOTIFICATION -->
    <template x-teleport="body">
      <div
        x-show="showToast"
        x-cloak
        x-transition
        class="bg-primary text-primary-foreground fixed top-6 left-1/2 z-50 flex -translate-x-1/2 items-center gap-2 rounded-2xl px-4 py-3 text-xs font-bold shadow-2xl"
      >
        <div
          class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-white"
        >
          <Zap class="h-3 w-3 stroke-[2.5]" />
        </div>
        <span x-text="toastMessage"></span>
      </div>
    </template>

    <!-- MODAL CUSTOM CATAT CEPAT -->
    <template x-teleport="body">
      <div
        x-show="openCustomQuickModal"
        x-cloak
        class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
      >
        <div
          @click.away="openCustomQuickModal = false"
          class="border-border bg-card flex max-h-[90vh] w-full max-w-md flex-col rounded-t-4xl border p-6 shadow-2xl transition-transform sm:rounded-4xl"
        >
          <div
            class="border-border flex items-center justify-between border-b pb-3"
          >
            <h3 class="text-primary text-base font-extrabold">
              Custom Catat Cepat
            </h3>
            <button
              type="button"
              @click="openCustomQuickModal = false"
              class="text-muted-foreground hover:bg-muted flex h-8 w-8 items-center justify-center rounded-full"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <div class="space-y-4 pt-4">
            <div class="space-y-1.5">
              <label class="text-foreground text-[11px] font-bold"
                >Nama Transaksi</label
              >
              <input
                type="text"
                placeholder="Misal: Kopi Kenangan"
                class="border-border bg-background text-foreground focus:border-blue-main w-full rounded-2xl border px-4 py-3 text-xs font-semibold outline-none"
              />
            </div>
            <div class="space-y-1.5">
              <label class="text-foreground text-[11px] font-bold"
                >Nominal (Rp)</label
              >
              <input
                type="number"
                placeholder="0"
                class="border-border bg-background text-foreground focus:border-blue-main w-full rounded-2xl border px-4 py-3 text-xs font-bold outline-none"
              />
            </div>
            <div class="pt-2">
              <button
                type="button"
                @click="openCustomQuickModal = false; triggerToast('Custom catat cepat berhasil!')"
                class="bg-primary text-primary-foreground shadow-soft flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl py-3.5 text-xs font-bold hover:opacity-90 active:scale-95"
              >
                <Check class="h-4 w-4 stroke-[2.5]" />
                <span>Simpan Transaksi</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </template>

    <!-- 5. GRAFIK PENGELUARAN MINGGUAN -->
    <div class="space-y-3">
      <div class="flex items-center justify-between px-1">
        <span class="text-primary text-sm font-bold">Pengeluaran Mingguan</span>
        <a
          href="/analytic"
          class="text-blue-main hover:text-primary flex items-center gap-0.5 text-xs font-semibold transition-colors"
        >
          <span>Analitik</span>
          <ChevronRight class="h-3.5 w-3.5 stroke-[2.5]" />
        </a>
      </div>

      <div
        class="border-border bg-card shadow-soft relative space-y-4 rounded-[28px] border p-5"
      >
        <div
          class="border-border flex items-center justify-between border-b pb-3"
        >
          <span class="text-muted-foreground text-xs font-bold">Bulan Ini</span>
          <div
            class="bg-blue-soft flex items-center gap-1.5 rounded-full px-3 py-1"
          >
            <TrendingDown class="text-primary h-3 w-3 stroke-[2.5]" />
            <span
              class="text-primary text-[11px] font-bold"
              x-text="hideBalance ? 'Rp ••••••' : 'Rp 1.450.000'"
              >Rp 1.450.000</span
            >
          </div>
        </div>

        <!-- Monochromatic Blue Bar Chart -->
        <div class="flex h-32 w-full items-end justify-between gap-2 px-1 pt-4">
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="bg-blue-soft h-12 w-full rounded-full"></div>
            <span class="text-muted-foreground text-[10px] font-bold">Sen</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="bg-primary h-24 w-full rounded-full"></div>
            <span class="text-primary text-[10px] font-bold">Sel</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="bg-blue-soft h-8 w-full rounded-full"></div>
            <span class="text-muted-foreground text-[10px] font-bold">Rab</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="bg-blue-soft h-16 w-full rounded-full"></div>
            <span class="text-muted-foreground text-[10px] font-bold">Kam</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="bg-blue-main h-28 w-full rounded-full"></div>
            <span class="text-blue-main text-[10px] font-bold">Jum</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="bg-blue-soft h-10 w-full rounded-full"></div>
            <span class="text-muted-foreground text-[10px] font-bold">Sab</span>
          </div>
          <div class="flex w-full flex-col items-center gap-1.5">
            <div class="bg-blue-soft h-14 w-full rounded-full"></div>
            <span class="text-muted-foreground text-[10px] font-bold">Min</span>
          </div>
        </div>
      </div>
    </div>

    <!-- 6. AKTIVITAS TERAKHIR -->
    <div class="space-y-3">
      <div class="flex items-center justify-between px-1">
        <span class="text-primary text-sm font-bold tracking-tight"
          >Aktivitas Terakhir</span
        >
        <a
          href="/history"
          class="text-blue-main hover:text-primary flex items-center gap-0.5 text-xs font-semibold transition-colors"
        >
          <span>Lihat Semua</span>
          <ChevronRight class="h-3.5 w-3.5 stroke-[2.5]" />
        </a>
      </div>

      <div
        class="divide-border border-border bg-card shadow-soft divide-y overflow-hidden rounded-[28px] border"
      >
        <template x-for="item in recentTransactions" :key="item.id">
          <div
            class="hover:bg-muted/50 flex cursor-pointer items-center justify-between p-4 transition-colors"
          >
            <div class="flex min-w-0 items-center gap-3.5">
              <div
                class="bg-blue-soft text-primary flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl"
              >
                <template x-if="item.icon === 'utensils'">
                  <Utensils class="h-5 w-5 stroke-2" />
                </template>
                <template x-if="item.icon === 'wallet'">
                  <Wallet class="h-5 w-5 stroke-2" />
                </template>
                <template x-if="item.icon === 'car'">
                  <Car class="h-5 w-5 stroke-2" />
                </template>
              </div>

              <div class="flex min-w-0 flex-col">
                <span
                  class="text-foreground truncate text-xs font-bold"
                  x-text="item.title"></span>
                <span class="text-muted-foreground text-[10px] font-medium">
                  <span x-text="item.category"></span> •
                  <span
                    class="text-foreground/80 font-semibold"
                    x-text="item.wallet"></span>
                </span>
              </div>
            </div>

            <div class="flex shrink-0 items-center gap-1 pl-2">
              <span
                x-text="hideBalance ? 'Rp ••••••' : item.amount"
                :class=`{
                  'text-blue-main': item.type === 'income',
                  'text-foreground': item.type === 'expense'
                }`
                class="text-xs font-extrabold"></span>
            </div>
          </div>
        </template>
      </div>
    </div>
  </div>
</Layout>
