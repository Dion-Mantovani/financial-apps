---
import Layout from '../layouts/Layout.astro';

import {
  X,
  ArrowUpRight,
  ArrowDownLeft,
  ArrowRightLeft,
  Wallet,
  Grid,
  Calendar,
  FileText,
  Check,
  Sparkles,
  History,
  Zap,
  ChevronRight,

  // Account icons
  Landmark,
  Building,
  CreditCard,
  Coins,
  PiggyBank,
  QrCode,
  Briefcase,

  // Category icons
  Utensils,
  Car,
  ShoppingBag,
  Gamepad2,
  HeartPulse,
  Receipt,
  CircleEllipsis,
  TrendingUp,
  Gift,
  Droplets,
  Wifi,
  Home,
  Shirt,
  Coffee,
  Film,
  Dumbbell,
  Scissors,
  GraduationCap,
  Baby,
  PawPrint,
  Plane,
  Fuel,
  Wrench,
} from '@lucide/astro';

const transactionTypes = [
  {
    id: 'expense',
    label: 'Pengeluaran',
    icon: ArrowUpRight,
    activeClass: 'bg-primary text-primary-foreground shadow-soft',
  },
  {
    id: 'income',
    label: 'Pemasukan',
    icon: ArrowDownLeft,
    activeClass: 'bg-primary text-primary-foreground shadow-soft',
  },
  {
    id: 'transfer',
    label: 'Transfer',
    icon: ArrowRightLeft,
    activeClass: 'bg-primary text-primary-foreground shadow-soft',
  },
];
---

<Layout title="Transaksi - Studion App" hideBottomNav={true}>
  <div x-data="transactionUI" class="space-y-6 pt-5 pb-12">
    <template x-if="successMessage">
      <div
        x-transition:enter="transition ease-out duration-300"
        x-transition:enter-start="opacity-0 -translate-y-3 scale-95"
        x-transition:enter-end="opacity-100 translate-y-0 scale-100"
        x-transition:leave="transition ease-in duration-200"
        x-transition:leave-start="opacity-100 translate-y-0 scale-100"
        x-transition:leave-end="opacity-0 -translate-y-3 scale-95"
        class="bg-blue-main shadow-blue-main/25 fixed bottom-5 left-1/2 z-[60] flex w-[calc(100%-2rem)] max-w-md -translate-x-1/2 items-center gap-3 rounded-2xl px-4 py-3.5 text-white shadow-xl"
      >
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/15">
          <Check size={20} stroke-width={2.5} />
        </div>

        <div class="min-w-0 flex-1">
          <p class="text-sm font-bold">Berhasil</p>

          <p
            class="mt-0.5 truncate text-xs text-white/80"
            x-text="successMessage"
          ></p>
        </div>

        <button
          type="button"
          @click="successMessage = ''"
          class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-white/70 transition hover:bg-white/10 hover:text-white"
          aria-label="Tutup"
        >
          <X size={16} />
        </button>
      </div>
    </template>

    <!-- 1. HEADER & NOMINAL -->
    <div class="bg-card-blue-dark shadow-soft relative overflow-hidden rounded-[28px] p-6 text-white transition-all duration-300">
      <div class="pointer-events-none absolute -right-8 -bottom-10 h-40 w-40 rounded-full bg-white/10"></div>

      <div class="pointer-events-none absolute right-16 -bottom-16 h-32 w-32 rounded-full bg-white/5"></div>

      <div class="relative z-10 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-white/15 backdrop-blur-md">
            <Sparkles class="h-4 w-4 stroke-[2.2] text-white" />
          </div>

          <div>
            <h1
              x-text="isEditMode ? 'Edit Transaksi' : 'Tambah Transaksi'"
              class="text-base font-extrabold tracking-tight text-white"
            >
              Tambah Transaksi
            </h1>
          </div>
        </div>

        <a
          href="/history"
          class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-md transition-all hover:bg-white/25 active:scale-95"
          aria-label="Tutup Form"
        >
          <X class="h-4 w-4 stroke-[2.5]" />
        </a>
      </div>

      <div class="relative z-10 mt-6 mb-2 space-y-1 text-center">
        <span class="text-[9px] font-extrabold tracking-widest text-white/70 uppercase">
          Nominal Transaksi
        </span>

        <div class="flex items-center justify-center gap-1.5">
          <span class="text-xl font-extrabold text-white/90"> Rp </span>

          <input
            x-ref="amountInput"
            type="text"
            inputmode="numeric"
            :value="formattedAmount"
            @input="handleAmountInput($event)"
            placeholder="0"
            class="w-full max-w-55 bg-transparent text-center text-3xl font-black tracking-tight text-white placeholder-white/30 outline-none sm:text-4xl"
            required
          />
        </div>
      </div>
    </div>
    <template x-if="errors.amount">
      <p
        class="-mt-5 text-center text-xs text-red-500"
        x-text="errors.amount"
      ></p>
    </template>

    <!-- 2. QUICK ACCESS -->
    <template x-if="!isEditMode">
      <div class="space-y-2.5 pt-1">
        <div class="flex items-center gap-1.5 px-1">
          <History class="text-blue-main h-3.5 w-3.5 stroke-[2.2]" />

          <span class="text-primary text-xs font-bold"> Sering Digunakan </span>

          <span class="text-muted-foreground text-[10px] font-medium">
            (Auto-fill)
          </span>
        </div>

        <div class="relative w-full">
          <div class="no-scrollbar flex items-center gap-2 overflow-x-auto px-0.5">
            <template x-for="item in frequentTransactions" :key="item.title">
              <button
                type="button"
                x-on:click="applyQuickData(item)"
                class="group border-border bg-card hover:border-blue-main hover:bg-blue-soft/50 flex shrink-0 cursor-pointer items-center gap-2 rounded-2xl border px-3.5 py-2 shadow-xs transition-all active:scale-95"
              >
                <Zap class="text-blue-main h-3.5 w-3.5 shrink-0 stroke-2" />

                <span
                  class="text-foreground text-[11px] font-semibold"
                  x-text="item.title"
                ></span>

                <span
                  class="text-blue-main text-[10px] font-bold"
                  x-text="`Rp ${Number(item.amount).toLocaleString('id-ID')}`"
                ></span>
              </button>
            </template>
          </div>
        </div>
      </div>
    </template>

    <!-- 3. TIPE TRANSAKSI -->
    <div class="border-border bg-card grid grid-cols-3 gap-2 rounded-2xl border p-1 shadow-xs">
      {transactionTypes.map((item) => (
        <button
          type="button"
          x-on:click={`changeTransactionType('${item.id}')`}
          x-bind:class={`formData.type === '${item.id}' ? '${item.activeClass}' : 'text-muted-foreground hover:text-foreground'`}
          class="flex cursor-pointer items-center justify-center gap-1.5 rounded-xl py-2 text-xs font-bold transition-all active:scale-95"
        >
          <item.icon class="h-3.5 w-3.5 stroke-[2.5]" />
          <span>{item.label}</span>
        </button>
      ))}
    </div>

    <!-- 4. FORM DETAIL -->
    <div class="border-border bg-card shadow-soft space-y-4 rounded-[28px] border p-5">
      <!-- TANGGAL -->
      <div class="space-y-1.5">
        <label class="text-primary flex items-center gap-1.5 text-xs font-bold">
          <Calendar class="text-blue-main h-3.5 w-3.5 stroke-2" />
          <span>Tanggal</span>
        </label>

        <input
          type="date"
          x-model="formData.transaction_date"
          class="border-border bg-background text-foreground focus:border-blue-main w-full rounded-2xl border px-4 py-3 text-xs font-semibold outline-none"
        />

        <template x-if="errors.transaction_date">
          <p
            class="mt-1 text-xs text-red-500"
            x-text="errors.transaction_date"
          ></p>
        </template>
      </div>

      <!-- ACCOUNT SOURCE -->
      <div class="space-y-1.5">
        <label class="text-primary flex items-center gap-1.5 text-xs font-bold">
          <Wallet class="text-blue-main h-3.5 w-3.5 stroke-2" />

          <span x-text="formData.type === 'transfer' ? 'Akun Asal' : 'Akun'">
            Akun
          </span>
        </label>

        <button
          type="button"
          @click="openWalletSheet('source')"
          class="border-border bg-background text-foreground hover:border-blue-main flex w-full cursor-pointer items-center justify-between rounded-2xl border px-3.5 py-3 text-xs font-semibold transition-all active:scale-95"
        >
          <span class="truncate font-bold" x-text="selectedAccountName">
            Pilih Akun
          </span>

          <ChevronRight class="text-muted-foreground h-3.5 w-3.5 shrink-0" />
        </button>

        <template x-if="errors.account_id">
          <p class="mt-1 text-xs text-red-500" x-text="errors.account_id"></p>
        </template>
      </div>

      <!-- TRANSFER DESTINATION -->
      <template x-if="formData.type === 'transfer'">
        <div class="space-y-1.5">
          <label class="text-primary flex items-center gap-1.5 text-xs font-bold">
            <Wallet class="text-blue-main h-3.5 w-3.5 stroke-2" />
            <span>Akun Tujuan</span>
          </label>

          <button
            type="button"
            @click="openWalletSheet('target')"
            class="border-border bg-background text-foreground hover:border-blue-main flex w-full cursor-pointer items-center justify-between rounded-2xl border px-3.5 py-3 text-xs font-semibold transition-all active:scale-95"
          >
            <span class="truncate font-bold" x-text="selectedToAccountName">
              Pilih Akun Tujuan
            </span>

            <ChevronRight class="text-muted-foreground h-3.5 w-3.5 shrink-0" />
          </button>

          <template x-if="errors.to_account_id">
            <p
              class="mt-1 text-xs text-red-500"
              x-text="errors.to_account_id"
            ></p>
          </template>
        </div>
      </template>

      <!-- CATEGORY -->
      <template x-if="formData.type !== 'transfer'">
        <div class="space-y-1.5">
          <label class="text-primary flex items-center gap-1.5 text-xs font-bold">
            <Grid class="text-blue-main h-3.5 w-3.5 stroke-2" />
            <span>Kategori</span>
          </label>

          <button
            type="button"
            @click="openCategoryModal()"
            class="border-border bg-background text-foreground hover:border-blue-main flex w-full cursor-pointer items-center justify-between rounded-2xl border px-3.5 py-3 text-xs font-semibold transition-all active:scale-95"
          >
            <span class="truncate font-bold" x-text="selectedCategoryName">
              Pilih Kategori
            </span>

            <ChevronRight class="text-muted-foreground h-3.5 w-3.5 shrink-0" />
          </button>

          <template x-if="errors.category_id">
            <p
              class="mt-1 text-xs text-red-500"
              x-text="errors.category_id"
            ></p>
          </template>

          <template x-if="autoCategoryDetected">
            <p class="text-blue-main px-1 text-[10px] font-semibold">
              ✨ Dipilih berdasarkan transaksi sebelumnya.
            </p>
          </template>
        </div>
      </template>

      <!-- TRANSFER FEE -->
      <template x-if="formData.type === 'transfer'">
        <div class="space-y-1.5">
          <label class="text-primary flex items-center gap-1.5 text-xs font-bold">
            <Wallet class="text-blue-main h-3.5 w-3.5 stroke-2" />
            <span>Biaya Transfer (Opsional)</span>
          </label>

          <div class="relative">
            <span class="text-muted-foreground absolute top-1/2 left-4 -translate-y-1/2 text-xs font-bold">
              Rp
            </span>

            <input
              type="text"
              inputmode="numeric"
              :value="formattedFee"
              @input="handleFeeInput($event)"
              placeholder="0"
              class="border-border bg-background text-foreground focus:border-blue-main w-full rounded-2xl border py-3 pr-4 pl-10 text-xs font-semibold outline-none"
            />
          </div>
        </div>
      </template>

      <!-- DESCRIPTION -->
      <div class="space-y-1.5">
        <label class="text-primary flex items-center gap-1.5 text-xs font-bold">
          <FileText class="text-blue-main h-3.5 w-3.5 stroke-2" />
          <span>Catatan (Opsional)</span>
        </label>

        <textarea
          x-model="formData.description"
          @input="handleDescriptionInput()"
          rows="2"
          placeholder="Tulis detail transaksi di sini..."
          class="border-border bg-background text-foreground placeholder-muted-foreground focus:border-blue-main w-full rounded-2xl border px-4 py-3 text-xs font-medium transition-all outline-none"
        ></textarea>
      </div>
    </div>

    <!-- 5. ACTION -->
    <div class="space-y-2 pt-1">
      <template x-if="!isEditMode">
        <div class="grid grid-cols-2 gap-2.5">
          <button
            type="button"
            @click="saveAndAddTransaction()"
            :disabled="isSubmitting"
            class="border-border text-muted-foreground hover:bg-muted flex cursor-pointer items-center justify-center gap-1.5 rounded-2xl border py-3.5 text-xs font-bold active:scale-95"
          >
            Simpan & Tambah
          </button>

          <button
            type="button"
            @click="saveTransaction()"
            :disabled="isSubmitting"
            :class="isSubmitting ? 'opacity-60 cursor-not-allowed' : 'hover:opacity-90 active:scale-95'"
            class="bg-primary text-primary-foreground shadow-soft flex cursor-pointer items-center justify-center gap-2 rounded-2xl py-3.5 text-xs font-bold transition-opacity"
          >
            <Check class="h-4 w-4 stroke-[2.5]" />

            <span x-text="isSubmitting ? 'Menyimpan...' : 'Simpan Transaksi'">
              Simpan Transaksi
            </span>
          </button>
        </div>
      </template>

      <template x-if="isEditMode">
        <div class="grid grid-cols-2 gap-2.5">
          <button
            type="button"
            @click="deleteTransaction()"
            :disabled="isSubmitting"
            class="flex cursor-pointer items-center justify-center rounded-2xl border border-red-200 py-3.5 text-xs font-bold text-red-500 transition-colors hover:bg-red-50 active:scale-95"
          >
            Hapus Transaksi
          </button>

          <button
            type="button"
            @click="saveTransaction()"
            :disabled="isSubmitting"
            :class="isSubmitting ? 'opacity-60 cursor-not-allowed' : 'hover:opacity-90 active:scale-95'"
            class="bg-primary text-primary-foreground shadow-soft flex cursor-pointer items-center justify-center gap-2 rounded-2xl py-3.5 text-xs font-bold transition-opacity"
          >
            <Check class="h-4 w-4 stroke-[2.5]" />

            <span x-text="isSubmitting ? 'Menyimpan...' : 'Simpan Perubahan'">
              Simpan Perubahan
            </span>
          </button>
        </div>
      </template>
    </div>

    <!-- MODAL PILIH AKUN -->
    <template x-teleport="body">
      <div
        x-show="showWalletModal"
        x-cloak
        class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
      >
        <div
          @click.away="showWalletModal = false"
          class="border-border bg-card flex max-h-[80vh] w-full max-w-md flex-col rounded-t-4xl border p-6 shadow-2xl transition-transform sm:rounded-4xl"
        >
          <div class="border-border flex items-center justify-between border-b pb-3">
            <h3
              class="text-primary text-base font-extrabold"
              x-text="walletSheetTarget === 'source' ? 'Pilih Akun' : 'Pilih Akun Tujuan'"
            >
              Pilih Akun
            </h3>

            <button
              type="button"
              @click="showWalletModal = false"
              class="text-muted-foreground hover:bg-muted flex h-8 w-8 items-center justify-center rounded-full"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <div class="no-scrollbar divide-border divide-y overflow-y-auto pt-2">
            <template
              x-for="account in (walletSheetTarget === 'source' ? activeAccounts : availableToAccounts)"
              :key="account.id"
            >
              <div
                @click="selectAccount(account.id)"
                class="hover:bg-muted/50 flex cursor-pointer items-center justify-between rounded-2xl p-3.5 transition-colors"
              >
                <div class="flex items-center gap-3.5">
                  <div class="bg-blue-soft text-primary flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl">
                    <template x-if="account.icon === 'landmark'">
                      <Landmark class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="account.icon === 'building'">
                      <Building class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="account.icon === 'credit-card'">
                      <CreditCard class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="account.icon === 'coins'">
                      <Coins class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="account.icon === 'wallet'">
                      <Wallet class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="account.icon === 'piggy-bank'">
                      <PiggyBank class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="account.icon === 'qr-code'">
                      <QrCode class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="account.icon === 'briefcase'">
                      <Briefcase class="h-5 w-5 stroke-2" />
                    </template>
                  </div>

                  <div class="min-w-0">
                    <span
                      class="text-foreground block truncate text-xs font-bold"
                      x-text="account.name"
                    >
                      Akun
                    </span>
                  </div>
                </div>

                <template x-if="(walletSheetTarget === 'source' && formData.account_id === account.id) || (walletSheetTarget === 'target' && formData.to_account_id === account.id)">
                  <Check class="text-blue-main h-4 w-4 stroke-3" />
                </template>
              </div>
            </template>

            <template x-if="!activeAccounts.length">
              <div class="text-muted-foreground px-3 py-8 text-center text-xs font-medium">
                Belum ada akun aktif.
              </div>
            </template>
          </div>
        </div>
      </div>
    </template>

    <!-- MODAL PILIH KATEGORI -->
    <template x-teleport="body">
      <div
        x-show="showCategoryModal"
        x-cloak
        class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
      >
        <div
          @click.away="showCategoryModal = false"
          class="border-border bg-card flex max-h-[80vh] w-full max-w-md flex-col rounded-t-4xl border p-6 shadow-2xl transition-transform sm:rounded-4xl"
        >
          <div class="border-border flex items-center justify-between border-b pb-3">
            <h3 class="text-primary text-base font-extrabold">
              Pilih Kategori
            </h3>

            <button
              type="button"
              @click="showCategoryModal = false"
              class="text-muted-foreground hover:bg-muted flex h-8 w-8 items-center justify-center rounded-full"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <div class="no-scrollbar divide-border divide-y overflow-y-auto pt-2">
            <template x-for="category in filteredCategories" :key="category.id">
              <div
                @click="selectCategory(category.id)"
                class="hover:bg-muted/50 flex cursor-pointer items-center justify-between rounded-2xl p-3.5 transition-colors"
              >
                <div class="flex items-center gap-3.5">
                  <div class="bg-blue-soft text-primary flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl">
                    <template x-if="category.icon === 'utensils'">
                      <Utensils class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'car'">
                      <Car class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'shopping-bag'">
                      <ShoppingBag class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'gamepad-2'">
                      <Gamepad2 class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'heart-pulse'">
                      <HeartPulse class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'briefcase'">
                      <Briefcase class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'gift'">
                      <Gift class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'receipt'">
                      <Receipt class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'circle-ellipsis'">
                      <CircleEllipsis class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'trending-up'">
                      <TrendingUp class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'wallet'">
                      <Wallet class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'zap'">
                      <Zap class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'droplets'">
                      <Droplets class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'wifi'">
                      <Wifi class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'home'">
                      <Home class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'shirt'">
                      <Shirt class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'coffee'">
                      <Coffee class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'film'">
                      <Film class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'dumbbell'">
                      <Dumbbell class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'scissors'">
                      <Scissors class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'graduation-cap'">
                      <GraduationCap class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'baby'">
                      <Baby class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'paw-print'">
                      <PawPrint class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'plane'">
                      <Plane class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'fuel'">
                      <Fuel class="h-5 w-5 stroke-2" />
                    </template>

                    <template x-if="category.icon === 'wrench'">
                      <Wrench class="h-5 w-5 stroke-2" />
                    </template>
                  </div>

                  <span
                    class="text-foreground text-xs font-bold"
                    x-text="category.name"
                  >
                    Kategori
                  </span>
                </div>

                <template x-if="formData.category_id === category.id">
                  <Check class="text-blue-main h-4 w-4 stroke-3" />
                </template>
              </div>
            </template>

            <template x-if="!filteredCategories.length">
              <div class="text-muted-foreground px-3 py-8 text-center text-xs font-medium">
                Belum ada kategori untuk tipe transaksi ini.
              </div>
            </template>
          </div>
        </div>
      </div>
    </template>
  </div>
</Layout>

<script>
  import Alpine from 'alpinejs';
  import { transactionUI } from '../features/transaction.ui.js';

  Alpine.data('transactionUI', transactionUI);
