---
import Layout from '../layouts/Layout.astro';

import {
  X,
  ArrowUpRight,
  ArrowDownLeft,
  ArrowRightLeft,
  Wallet,
  Grid,
  Calendar,
  FileText,
  Check,
  Sparkles,
  History,
  Zap,
  ChevronRight,
} from '@lucide/astro';

const transactionTypes = [
  {
    id: 'expense',
    label: 'Pengeluaran',
    icon: ArrowUpRight,
    activeClass: 'bg-primary text-primary-foreground shadow-soft',
  },
  {
    id: 'income',
    label: 'Pemasukan',
    icon: ArrowDownLeft,
    activeClass: 'bg-primary text-primary-foreground shadow-soft',
  },
  {
    id: 'transfer',
    label: 'Transfer',
    icon: ArrowRightLeft,
    activeClass: 'bg-primary text-primary-foreground shadow-soft',
  },
];

const frequentTransactions = [
  {
    title: 'Kopi Kenangan',
    amount: '28000',
    type: 'expense',
    category_icon: 'utensils',
  },
  {
    title: 'Bensin Pertamax',
    amount: '35000',
    type: 'expense',
    category_icon: 'car',
  },
  {
    title: 'Supermarket Hero',
    amount: '185000',
    type: 'expense',
    category_icon: 'shopping-bag',
  },
  {
    title: 'Parkir Motor',
    amount: '5000',
    type: 'expense',
    category_icon: 'car',
  },
];
---

<Layout title="Transaksi - Studion App" hideBottomNav={true}>
  <div
    x-data="{
      accStore: Alpine.store('accountStore'),
      catStore: Alpine.store('categoryStore'),
      txStore: Alpine.store('transactionStore'),

      isEditMode: false,
      isSubmitting: false,

      showWalletModal: false,
      showCategoryModal: false,

      walletSheetTarget: 'source',

      autoCategoryDetected: false,

      formattedAmount: '',
      rawAmount: 0,

      formattedFee: '',
      rawFee: 0,

      errorMessage: '',

      formData: {
        type: 'expense',
        transaction_date: new Date().toISOString().split('T')[0],
        account_id: '',
        to_account_id: '',
        category_id: '',
        fee: null,
        description: ''
      },

      async init() {
  this.errorMessage = '';

  if (!this.accStore.accounts.length) {
    await this.accStore.init();
  }

  if (!this.catStore.categories.length) {
    await this.catStore.init();
  }

  if (!this.txStore.transactions.length) {
    await this.txStore.init();
  }

  const params = new URLSearchParams(window.location.search);

  if (params.get('type') === 'transfer') {
    this.formData.type = 'transfer';
  }

  if (!this.formData.account_id && this.accStore.activeAccounts.length) {
    this.formData.account_id = this.accStore.activeAccounts[0].id;
  }

  this.syncDefaultCategory();
},

      get activeAccounts() {
        return this.accStore?.activeAccounts || [];
      },

      get selectedAccount() {
        return this.activeAccounts.find(
          account => account.id === this.formData.account_id
        );
      },

      get selectedToAccount() {
        return this.activeAccounts.find(
          account => account.id === this.formData.to_account_id
        );
      },

      get expenseCategories() {
        return this.catStore?.expenseCategories || [];
      },

      get incomeCategories() {
        return this.catStore?.incomeCategories || [];
      },

      get filteredCategories() {
        if (this.formData.type === 'expense') {
          return this.expenseCategories;
        }

        if (this.formData.type === 'income') {
          return this.incomeCategories;
        }

        return [];
      },

      get availableToAccounts() {
        return this.activeAccounts.filter(
          account => account.id !== this.formData.account_id
        );
      },

      get selectedAccountName() {
        return this.selectedAccount?.name || 'Pilih Akun';
      },

      get selectedToAccountName() {
        return this.selectedToAccount?.name || 'Pilih Akun Tujuan';
      },

      get selectedCategoryName() {
        const category = this.filteredCategories.find(
          category => category.id === this.formData.category_id
        );

        return category ? category.name : 'Pilih Kategori';
      },

      get formattedAmountPreview() {
        return this.rawAmount
          ? this.rawAmount.toLocaleString('id-ID')
          : '';
      },

      get formattedFeePreview() {
        return this.rawFee
          ? this.rawFee.toLocaleString('id-ID')
          : '';
      },

      handleAmountInput(event) {
        const value = event.target.value.replace(/[^0-9]/g, '');

        this.rawAmount = value ? parseInt(value, 10) : 0;
        this.formattedAmount = this.rawAmount
          ? this.rawAmount.toLocaleString('id-ID')
          : '';

        this.errorMessage = '';
      },

      handleFeeInput(event) {
        const value = event.target.value.replace(/[^0-9]/g, '');

        this.rawFee = value ? parseInt(value, 10) : 0;
        this.formattedFee = this.rawFee
          ? this.rawFee.toLocaleString('id-ID')
          : '';

        this.errorMessage = '';
      },

      applyQuickData(item) {
        this.formData.type = item.type;

        this.rawAmount = parseInt(item.amount, 10);
        this.formattedAmount = this.rawAmount.toLocaleString('id-ID');

        this.formData.description = item.title;

        this.syncDefaultCategory();

        const suggestedCategory = this.txStore.suggestCategory(
          item.title
        );

        if (suggestedCategory) {
          const categoryExists = this.filteredCategories.some(
            category => category.id === suggestedCategory
          );

          if (categoryExists) {
            this.formData.category_id = suggestedCategory;
            this.autoCategoryDetected = true;
          }
        }

        this.errorMessage = '';
      },

      syncDefaultCategory() {
        if (this.formData.type === 'transfer') {
          this.formData.category_id = '';
          this.autoCategoryDetected = false;
          return;
        }

        const categories = this.filteredCategories;

        const currentExists = categories.some(
          category => category.id === this.formData.category_id
        );

        if (!currentExists) {
          this.formData.category_id = categories.length
            ? categories[0].id
            : '';
        }
      },

      changeTransactionType(type) {
        this.formData.type = type;

        this.formData.category_id = '';
        this.formData.to_account_id = '';
        this.rawFee = 0;
        this.formattedFee = '';
        this.autoCategoryDetected = false;

        this.syncDefaultCategory();
        this.errorMessage = '';
      },

      openWalletSheet(target) {
        this.walletSheetTarget = target;
        this.showWalletModal = true;
      },

      selectAccount(id) {
        if (this.walletSheetTarget === 'source') {
          this.formData.account_id = id;

          if (this.formData.to_account_id === id) {
            this.formData.to_account_id = '';
          }
        } else {
          this.formData.to_account_id = id;
        }

        this.showWalletModal = false;
      },

      openCategoryModal() {
        if (!this.filteredCategories.length) {
          this.errorMessage =
            'Belum ada kategori untuk tipe transaksi ini.';
          return;
        }

        this.showCategoryModal = true;
      },

      selectCategory(id) {
        this.formData.category_id = id;
        this.autoCategoryDetected = false;
        this.showCategoryModal = false;
      },

      validateForm() {
        if (!this.rawAmount || this.rawAmount <= 0) {
          this.errorMessage = 'Nominal transaksi harus lebih dari Rp 0.';
          return false;
        }

        if (!this.formData.account_id) {
          this.errorMessage = 'Silakan pilih akun terlebih dahulu.';
          return false;
        }

        if (this.formData.type === 'transfer') {
          if (!this.formData.to_account_id) {
            this.errorMessage =
              'Silakan pilih akun tujuan transfer.';
            return false;
          }

          if (
            this.formData.account_id ===
            this.formData.to_account_id
          ) {
            this.errorMessage =
              'Akun asal dan akun tujuan tidak boleh sama.';
            return false;
          }

          if (this.rawFee < 0) {
            this.errorMessage = 'Biaya transfer tidak valid.';
            return false;
          }
        } else {
          if (!this.formData.category_id) {
            this.errorMessage =
              'Silakan pilih kategori transaksi.';
            return false;
          }
        }

        if (!this.formData.transaction_date) {
          this.errorMessage = 'Tanggal transaksi wajib diisi.';
          return false;
        }

        return true;
      },

      async saveTransaction() {
        if (this.isSubmitting) return;

        this.errorMessage = '';

        if (!this.validateForm()) {
          return;
        }

        this.isSubmitting = true;

        try {
          const txData = {
            type: this.formData.type,
            amount: this.rawAmount,
            account_id: this.formData.account_id,
            to_account_id:
              this.formData.type === 'transfer'
                ? this.formData.to_account_id
                : null,
            category_id:
              this.formData.type === 'transfer'
                ? null
                : this.formData.category_id,
            fee:
              this.formData.type === 'transfer' && this.rawFee > 0
                ? this.rawFee
                : null,
            transaction_date: this.formData.transaction_date,
            description: this.formData.description.trim()
          };

          await this.txStore.addTransaction(
            txData,
            this.catStore.categories
          );

          window.location.href = '/history';
        } catch (error) {
          console.error(
            'Gagal menyimpan transaksi:',
            error
          );

          this.errorMessage =
            'Transaksi gagal disimpan. Silakan coba lagi.';
        } finally {
          this.isSubmitting = false;
        }
      }
    }"
    class="space-y-6 pt-5 pb-12"
  >
    <!-- 1. HEADER & NOMINAL -->
    <div
      class="bg-card-blue-dark shadow-soft relative overflow-hidden rounded-[28px] p-6 text-white transition-all duration-300"
    >
      <div
        class="pointer-events-none absolute -right-8 -bottom-10 h-40 w-40 rounded-full bg-white/10"
      >
      </div>

      <div
        class="pointer-events-none absolute right-16 -bottom-16 h-32 w-32 rounded-full bg-white/5"
      >
      </div>

      <div class="relative z-10 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-xl bg-white/15 backdrop-blur-md"
          >
            <Sparkles class="h-4 w-4 stroke-[2.2] text-white" />
          </div>

          <div>
            <h1
              x-text="isEditMode ? 'Edit Transaksi' : 'Tambah Transaksi'"
              class="text-base font-extrabold tracking-tight text-white"
            >
              Tambah Transaksi
            </h1>
          </div>
        </div>

        <a
          href="/history"
          class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full bg-white/15 text-white backdrop-blur-md transition-all hover:bg-white/25 active:scale-95"
          aria-label="Tutup Form"
        >
          <X class="h-4 w-4 stroke-[2.5]" />
        </a>
      </div>

      <div class="relative z-10 mt-6 mb-2 space-y-1 text-center">
        <span
          class="text-[9px] font-extrabold tracking-widest text-white/70 uppercase"
        >
          Nominal Transaksi
        </span>

        <div class="flex items-center justify-center gap-1.5">
          <span class="text-xl font-extrabold text-white/90"> Rp </span>

          <input
            type="text"
            inputmode="numeric"
            :value="formattedAmount"
            @input="handleAmountInput($event)"
            placeholder="0"
            class="w-full max-w-55 bg-transparent text-center text-3xl font-black tracking-tight text-white placeholder-white/30 outline-none sm:text-4xl"
            required
          />
        </div>
      </div>
    </div>

    <!-- 2. QUICK ACCESS -->
    <template x-if="!isEditMode">
      <div class="space-y-2.5 pt-1">
        <div class="flex items-center gap-1.5 px-1">
          <History class="text-blue-main h-3.5 w-3.5 stroke-[2.2]" />

          <span class="text-primary text-xs font-bold"> Sering Digunakan </span>

          <span class="text-muted-foreground text-[10px] font-medium">
            (Auto-fill)
          </span>
        </div>

        <div class="relative w-full">
          <div
            class="no-scrollbar flex items-center gap-2 overflow-x-auto px-0.5"
          >
            {
              frequentTransactions.map((item) => (
                <button
                  type="button"
                  x-on:click={`applyQuickData(${JSON.stringify(item)})`}
                  class="group border-border bg-card hover:border-blue-main hover:bg-blue-soft/50 flex shrink-0 cursor-pointer items-center gap-2 rounded-2xl border px-3.5 py-2 shadow-xs transition-all active:scale-95"
                >
                  <Zap class="text-blue-main h-3.5 w-3.5 shrink-0 stroke-2" />

                  <span class="text-foreground text-[11px] font-semibold">
                    {item.title}
                  </span>

                  <span class="text-blue-main text-[10px] font-bold">
                    Rp {parseInt(item.amount).toLocaleString('id-ID')}
                  </span>
                </button>
              ))
            }
          </div>
        </div>
      </div>
    </template>

    <!-- 3. TIPE TRANSAKSI -->
    <div
      class="border-border bg-card grid grid-cols-3 gap-2 rounded-2xl border p-1 shadow-xs"
    >
      {
        transactionTypes.map((item) => (
          <button
            type="button"
            x-on:click={`changeTransactionType('${item.id}')`}
            x-bind:class={`formData.type === '${item.id}' ? '${item.activeClass}' : 'text-muted-foreground hover:text-foreground'`}
            class="flex cursor-pointer items-center justify-center gap-1.5 rounded-xl py-2 text-xs font-bold transition-all active:scale-95"
          >
            <item.icon class="h-3.5 w-3.5 stroke-[2.5]" />
            <span>{item.label}</span>
          </button>
        ))
      }
    </div>

    <!-- 4. FORM DETAIL -->
    <div
      class="border-border bg-card shadow-soft space-y-4 rounded-[28px] border p-5"
    >
      <!-- TANGGAL -->
      <div class="space-y-1.5">
        <label class="text-primary flex items-center gap-1.5 text-xs font-bold">
          <Calendar class="text-blue-main h-3.5 w-3.5 stroke-2" />
          <span>Tanggal</span>
        </label>

        <input
          type="date"
          x-model="formData.transaction_date"
          class="border-border bg-background text-foreground focus:border-blue-main w-full rounded-2xl border px-4 py-3 text-xs font-semibold outline-none"
        />
      </div>

      <!-- ACCOUNT SOURCE -->
      <div class="space-y-1.5">
        <label class="text-primary flex items-center gap-1.5 text-xs font-bold">
          <Wallet class="text-blue-main h-3.5 w-3.5 stroke-2" />

          <span x-text="formData.type === 'transfer' ? 'Akun Asal' : 'Akun'">
            Akun
          </span>
        </label>

        <button
          type="button"
          @click="openWalletSheet('source')"
          class="border-border bg-background text-foreground hover:border-blue-main flex w-full cursor-pointer items-center justify-between rounded-2xl border px-3.5 py-3 text-xs font-semibold transition-all active:scale-95"
        >
          <span class="truncate font-bold" x-text="selectedAccountName">
            Pilih Akun
          </span>

          <ChevronRight class="text-muted-foreground h-3.5 w-3.5 shrink-0" />
        </button>
      </div>

      <!-- TRANSFER DESTINATION -->
      <template x-if="formData.type === 'transfer'">
        <div class="space-y-1.5">
          <label
            class="text-primary flex items-center gap-1.5 text-xs font-bold"
          >
            <Wallet class="text-blue-main h-3.5 w-3.5 stroke-2" />
            <span>Akun Tujuan</span>
          </label>

          <button
            type="button"
            @click="openWalletSheet('target')"
            class="border-border bg-background text-foreground hover:border-blue-main flex w-full cursor-pointer items-center justify-between rounded-2xl border px-3.5 py-3 text-xs font-semibold transition-all active:scale-95"
          >
            <span class="truncate font-bold" x-text="selectedToAccountName">
              Pilih Akun Tujuan
            </span>

            <ChevronRight class="text-muted-foreground h-3.5 w-3.5 shrink-0" />
          </button>
        </div>
      </template>

      <!-- CATEGORY -->
      <template x-if="formData.type !== 'transfer'">
        <div class="space-y-1.5">
          <label
            class="text-primary flex items-center gap-1.5 text-xs font-bold"
          >
            <Grid class="text-blue-main h-3.5 w-3.5 stroke-2" />
            <span>Kategori</span>
          </label>

          <button
            type="button"
            @click="openCategoryModal()"
            class="border-border bg-background text-foreground hover:border-blue-main flex w-full cursor-pointer items-center justify-between rounded-2xl border px-3.5 py-3 text-xs font-semibold transition-all active:scale-95"
          >
            <span class="truncate font-bold" x-text="selectedCategoryName">
              Pilih Kategori
            </span>

            <ChevronRight class="text-muted-foreground h-3.5 w-3.5 shrink-0" />
          </button>

          <template x-if="autoCategoryDetected">
            <p class="text-blue-main px-1 text-[10px] font-semibold">
              ✨ Kategori otomatis dipilih berdasarkan transaksi sebelumnya.
            </p>
          </template>
        </div>
      </template>

      <!-- TRANSFER FEE -->
      <template x-if="formData.type === 'transfer'">
        <div class="space-y-1.5">
          <label
            class="text-primary flex items-center gap-1.5 text-xs font-bold"
          >
            <Wallet class="text-blue-main h-3.5 w-3.5 stroke-2" />
            <span>Biaya Transfer (Opsional)</span>
          </label>

          <div class="relative">
            <span
              class="text-muted-foreground absolute top-1/2 left-4 -translate-y-1/2 text-xs font-bold"
            >
              Rp
            </span>

            <input
              type="text"
              inputmode="numeric"
              :value="formattedFee"
              @input="handleFeeInput($event)"
              placeholder="0"
              class="border-border bg-background text-foreground focus:border-blue-main w-full rounded-2xl border py-3 pr-4 pl-10 text-xs font-semibold outline-none"
            />
          </div>
        </div>
      </template>

      <!-- DESCRIPTION -->
      <div class="space-y-1.5">
        <label class="text-primary flex items-center gap-1.5 text-xs font-bold">
          <FileText class="text-blue-main h-3.5 w-3.5 stroke-2" />
          <span>Catatan (Opsional)</span>
        </label>

        <textarea
          x-model="formData.description"
          rows="2"
          placeholder="Tulis detail transaksi di sini..."
          class="border-border bg-background text-foreground placeholder-muted-foreground focus:border-blue-main w-full rounded-2xl border px-4 py-3 text-xs font-medium transition-all outline-none"
        ></textarea>
      </div>
    </div>

    <!-- ERROR MESSAGE -->
    <template x-if="errorMessage">
      <div
        class="border-destructive/20 bg-destructive/10 text-destructive rounded-2xl border px-4 py-3 text-xs font-semibold"
        x-text="errorMessage"
      >
      </div>
    </template>

    <!-- 5. ACTION -->
    <div class="space-y-2 pt-1">
      <div class="grid grid-cols-2 gap-2.5">
        <a
          href="/history"
          class="border-border text-muted-foreground hover:bg-muted flex cursor-pointer items-center justify-center gap-1.5 rounded-2xl border py-3.5 text-xs font-bold active:scale-95"
        >
          <span>Batal</span>
        </a>

        <button
          type="button"
          @click="saveTransaction()"
          :disabled="isSubmitting"
          :class="isSubmitting ? 'opacity-60 cursor-not-allowed' : 'hover:opacity-90 active:scale-95'"
          class="bg-primary text-primary-foreground shadow-soft flex cursor-pointer items-center justify-center gap-2 rounded-2xl py-3.5 text-xs font-bold transition-opacity"
        >
          <Check class="h-4 w-4 stroke-[2.5]" />

          <span x-text="isSubmitting ? 'Menyimpan...' : 'Simpan Transaksi'">
            Simpan Transaksi
          </span>
        </button>
      </div>
    </div>

    <!-- MODAL PILIH AKUN -->
    <template x-teleport="body">
      <div
        x-show="showWalletModal"
        x-cloak
        class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
      >
        <div
          @click.away="showWalletModal = false"
          class="border-border bg-card flex max-h-[80vh] w-full max-w-md flex-col rounded-t-4xl border p-6 shadow-2xl transition-transform sm:rounded-4xl"
        >
          <div
            class="border-border flex items-center justify-between border-b pb-3"
          >
            <h3
              class="text-primary text-base font-extrabold"
              x-text="walletSheetTarget === 'source' ? 'Pilih Akun' : 'Pilih Akun Tujuan'"
            >
              Pilih Akun
            </h3>

            <button
              type="button"
              @click="showWalletModal = false"
              class="text-muted-foreground hover:bg-muted flex h-8 w-8 items-center justify-center rounded-full"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <div class="no-scrollbar divide-border divide-y overflow-y-auto pt-2">
            <template
              x-for="account in (walletSheetTarget === 'source' ? activeAccounts : availableToAccounts)"
              :key="account.id"
            >
              <div
                @click="selectAccount(account.id)"
                class="hover:bg-muted/50 flex cursor-pointer items-center justify-between rounded-2xl p-3.5 transition-colors"
              >
                <div class="flex items-center gap-3.5">
                  <div
                    class="bg-blue-soft text-primary flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl"
                  >
                    <Wallet class="h-5 w-5 stroke-2" />
                  </div>

                  <div class="min-w-0">
                    <span
                      class="text-foreground block truncate text-xs font-bold"
                      x-text="account.name"
                    >
                      Akun
                    </span>
                  </div>
                </div>

                <template
                  x-if="(walletSheetTarget === 'source' && formData.account_id === account.id) || (walletSheetTarget === 'target' && formData.to_account_id === account.id)"
                >
                  <Check class="text-blue-main h-4 w-4 stroke-3" />
                </template>
              </div>
            </template>

            <template x-if="!activeAccounts.length">
              <div
                class="text-muted-foreground px-3 py-8 text-center text-xs font-medium"
              >
                Belum ada akun aktif.
              </div>
            </template>
          </div>
        </div>
      </div>
    </template>

    <!-- MODAL PILIH KATEGORI -->
    <template x-teleport="body">
      <div
        x-show="showCategoryModal"
        x-cloak
        class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
      >
        <div
          @click.away="showCategoryModal = false"
          class="border-border bg-card flex max-h-[80vh] w-full max-w-md flex-col rounded-t-4xl border p-6 shadow-2xl transition-transform sm:rounded-4xl"
        >
          <div
            class="border-border flex items-center justify-between border-b pb-3"
          >
            <h3 class="text-primary text-base font-extrabold">
              Pilih Kategori
            </h3>

            <button
              type="button"
              @click="showCategoryModal = false"
              class="text-muted-foreground hover:bg-muted flex h-8 w-8 items-center justify-center rounded-full"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <div class="no-scrollbar divide-border divide-y overflow-y-auto pt-2">
            <template x-for="category in filteredCategories" :key="category.id">
              <div
                @click="selectCategory(category.id)"
                class="hover:bg-muted/50 flex cursor-pointer items-center justify-between rounded-2xl p-3.5 transition-colors"
              >
                <div class="flex items-center gap-3.5">
                  <div
                    class="bg-blue-soft text-primary flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl"
                  >
                    <Grid class="h-5 w-5 stroke-2" />
                  </div>

                  <span
                    class="text-foreground text-xs font-bold"
                    x-text="category.name"
                  >
                    Kategori
                  </span>
                </div>

                <template x-if="formData.category_id === category.id">
                  <Check class="text-blue-main h-4 w-4 stroke-3" />
                </template>
              </div>
            </template>

            <template x-if="!filteredCategories.length">
              <div
                class="text-muted-foreground px-3 py-8 text-center text-xs font-medium"
              >
                Belum ada kategori untuk tipe transaksi ini.
              </div>
            </template>
          </div>
        </div>
      </div>
    </template>
  </div>
</Layout>
