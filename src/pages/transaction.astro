---
import Layout from '../layouts/Layout.astro';
import {
  X,
  ArrowUpRight,
  ArrowDownLeft,
  ArrowRightLeft,
  Wallet,
  Grid,
  Calendar,
  FileText,
  Check,
  Sparkles,
  Plus,
  History,
  Zap,
  Trash2,
  ChevronRight,
  Landmark,
  Building2,
  CreditCard,
  Coins,
  Utensils,
  Car,
  ShoppingBag,
  Receipt,
  Gamepad2,
  HeartPulse,
  GraduationCap,
  MoreHorizontal,
  Briefcase,
  Gift,
  TrendingUp,
  RotateCcw,
  Smartphone,
  PiggyBank,
  LineChart,
  Tag,
} from '@lucide/astro';

const transactionTypes = [
  {
    id: 'expense',
    label: 'Pengeluaran',
    icon: ArrowUpRight,
    activeClass: 'bg-rose-600 text-white shadow-rose-500/25',
  },
  {
    id: 'income',
    label: 'Pemasukan',
    icon: ArrowDownLeft,
    activeClass: 'bg-emerald-600 text-white shadow-emerald-500/25',
  },
  {
    id: 'transfer',
    label: 'Transfer',
    icon: ArrowRightLeft,
    activeClass: 'bg-blue-600 text-white shadow-blue-500/25',
  },
];

const frequentTransactions = [
  {
    title: 'Kopi Kenangan',
    amount: '28000',
    type: 'expense',
    note: 'Kopi Kenangan mantan',
  },
  {
    title: 'Bensin Pertamax',
    amount: '35000',
    type: 'expense',
    note: 'Isi Pertamax',
  },
  {
    title: 'Supermarket Hero',
    amount: '185000',
    type: 'expense',
    note: 'Belanja mingguan',
  },
  {
    title: 'Parkir',
    amount: '5000',
    type: 'expense',
    note: 'Parkir motor',
  },
];
---

<Layout title="Transaksi - Studion App" hideBottomNav={true}>
  <div x-data="addTransactionApp()" class="space-y-4 pt-6 pb-12">
    <!-- 1. TOPBAR HEADER -->
    <div
      class="relative overflow-hidden rounded-3xl border border-blue-100/80 bg-linear-to-br from-slate-900 via-blue-950 to-slate-900 p-5 text-white shadow-xl"
    >
      <div
        class="pointer-events-none absolute -top-12 -right-12 h-36 w-36 rounded-full bg-blue-500/20 blur-2xl"
      >
      </div>
      <div
        class="pointer-events-none absolute -bottom-12 -left-12 h-36 w-36 rounded-full bg-cyan-400/15 blur-2xl"
      >
      </div>

      <div class="relative z-10 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-xl border border-white/15 bg-white/10 backdrop-blur-md"
          >
            <Sparkles class="h-4 w-4 stroke-2 text-cyan-300" />
          </div>
          <div>
            <h1
              x-text="isEditMode ? 'Edit Transaksi' : 'Tambah Transaksi'"
              class="text-sm font-bold tracking-tight text-white"
              x-cloak
            >
            </h1>
            <p class="text-[10px] font-medium text-blue-200/70">
              Catat & kelola arus kasmu
            </p>
          </div>
        </div>

        <a
          href="/history"
          class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full border border-white/15 bg-white/10 text-blue-100 backdrop-blur-md transition-all hover:bg-white/20 active:scale-95"
          aria-label="Tutup Form"
        >
          <X class="h-4 w-4 stroke-2" />
        </a>
      </div>

      <!-- INPUT NOMINAL UTAMA (FORMAT RIBUAN & CLEAN DARI MINUS) -->
      <div class="relative z-10 mt-5 mb-2 space-y-1 text-center">
        <span
          class="text-[10px] font-bold tracking-widest text-blue-200/60 uppercase"
        >
          Nominal Transaksi
        </span>
        <div class="flex items-center justify-center gap-1">
          <span class="text-lg font-bold text-blue-300">Rp</span>
          <input
            x-ref="amountInput"
            type="text"
            inputmode="numeric"
            :value="formattedAmount"
            @input="handleAmountInput($event)"
            placeholder="0"
            class="w-full max-w-55 bg-transparent text-center text-3xl font-extrabold tracking-tight text-white placeholder-blue-300/40 outline-none sm:text-4xl"
            required
          />
        </div>
      </div>

      <!-- Grid Pattern Background -->
      <div
        class="pointer-events-none absolute right-0 bottom-0 h-full w-full overflow-hidden rounded-br-3xl opacity-25"
      >
        <svg
          class="h-full w-full"
          width="100%"
          height="100%"
          xmlns="http://www.w3.org/2000/svg"
        >
          <defs>
            <pattern
              id="grid-pattern-card"
              width="16"
              height="16"
              patternUnits="userSpaceOnUse"
            >
              <path
                d="M 16 0 L 0 0 0 16"
                fill="none"
                stroke="rgba(255, 255, 255, 0.4)"
                stroke-width="1.2"></path>
            </pattern>
            <radialGradient id="grid-fade-card" cx="100%" cy="100%" r="100%">
              <stop offset="0%" stop-color="white" stop-opacity="1"></stop>
              <stop offset="80%" stop-color="white" stop-opacity="0"></stop>
            </radialGradient>
            <mask id="grid-mask-card">
              <rect width="100%" height="100%" fill="url(#grid-fade-card)"
              ></rect>
            </mask>
          </defs>
          <rect
            width="100%"
            height="100%"
            fill="url(#grid-pattern-card)"
            mask="url(#grid-mask-card)"></rect>
        </svg>
      </div>
    </div>

    <!-- 2. QUICK ACCESS (Dinamis Top 5 dari Sistem) -->
    <template x-if="!isEditMode && frequentTransactions.length > 0">
      <div class="space-y-1.5 pt-0.5">
        <div class="flex items-center gap-1.5 px-1">
          <History class="h-3.5 w-3.5 stroke-[2.5] text-blue-600" />
          <span class="text-[11px] font-bold text-slate-700"
            >Sering Digunakan</span
          >
          <span class="text-[9px] font-semibold text-slate-400"
            >(Tap untuk auto-fill)</span
          >
        </div>

        <div class="relative w-full">
          <div
            class="no-scrollbar flex items-center gap-1.5 overflow-x-auto pr-6 pb-0.5"
          >
            <template
              x-for="(item, index) in frequentTransactions"
              :key="index"
            >
              <button
                type="button"
                @click="applyQuickData(item)"
                class="group flex shrink-0 cursor-pointer items-center gap-1.5 rounded-xl border border-blue-100/90 bg-blue-50/40 px-2.5 py-1.5 text-xs font-semibold text-slate-700 shadow-2xs backdrop-blur-xs transition-all hover:border-blue-500 hover:bg-blue-600 hover:text-white active:scale-95"
              >
                <!-- Render Ikon Kategori Dinamis -->
                <div
                  class="flex items-center text-blue-600 group-hover:text-white"
                >
                  <template x-if="item.category_icon === 'utensils'"
                    ><Utensils class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'car'"
                    ><Car class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'shopping-bag'"
                    ><ShoppingBag class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'receipt'"
                    ><Receipt class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'gamepad-2'"
                    ><Gamepad2 class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'heart-pulse'"
                    ><HeartPulse class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'graduation-cap'"
                    ><GraduationCap class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'more-horizontal'"
                    ><MoreHorizontal class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'briefcase'"
                    ><Briefcase class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'gift'"
                    ><Gift class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'trending-up'"
                    ><TrendingUp class="h-3 w-3 stroke-[2.5]" /></template
                  >
                  <template x-if="item.category_icon === 'rotate-ccw'"
                    ><RotateCcw class="h-3 w-3 stroke-[2.5]" /></template
                  >

                  <!-- Fallback ke Zap jika tidak ada ikon kategori -->
                  <template
                    x-if="!['utensils','car','shopping-bag','receipt','gamepad-2','heart-pulse','graduation-cap','more-horizontal','briefcase','gift','trending-up','rotate-ccw'].includes(item.category_icon)"
                  >
                    <Zap class="h-3 w-3 stroke-[2.5]" />
                  </template>
                </div>

                <!-- Nama Catatan -->
                <span x-text="item.title"></span>

                <!-- Nominal Terformat dengan Titik -->
                <span
                  class="text-[10px] font-bold text-blue-600 group-hover:text-blue-100"
                  x-text="`Rp ${formatCurrencyNumber(item.amount)}`"></span>
              </button>
            </template>
          </div>
        </div>
      </div>
    </template>

    <!-- 3. TIPE TRANSAKSI -->
    <div
      class="grid grid-cols-3 gap-1.5 rounded-2xl border border-slate-200/70 bg-white p-1.5 shadow-2xs"
    >
      {
        transactionTypes.map((item) => (
          <button
            type="button"
            x-on:click={`formData.type = '${item.id}'`}
            x-bind:class={`formData.type === '${item.id}' ? '${item.activeClass} shadow-md' : 'text-slate-600 hover:bg-slate-50'`}
            class="flex cursor-pointer items-center justify-center gap-1.5 rounded-xl py-2 text-xs font-bold transition-all active:scale-95"
          >
            <item.icon class="h-3.5 w-3.5 stroke-[2.5]" />
            <span>{item.label}</span>
          </button>
        ))
      }
    </div>

    <!-- 4. FORM INPUT DETAILS -->
    <div
      class="space-y-3 rounded-3xl border border-slate-200/70 bg-white p-4 shadow-sm"
    >
      <!-- Tanggal -->
      <div class="space-y-1">
        <label
          class="flex items-center gap-1.5 text-[11px] font-bold text-slate-700"
        >
          <Calendar class="h-3.5 w-3.5 stroke-2 text-blue-600" />
          <span>Tanggal</span>
        </label>
        <input
          type="date"
          x-model="formData.transaction_date"
          class="w-full rounded-2xl border border-slate-200/80 bg-slate-50/60 px-3.5 py-2.5 text-xs font-semibold text-slate-800 transition-all outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/10"
        />
      </div>

      <!-- TRIGGER INPUTS (BOTTOM SHEET TRIGGER) -->
      <div class="grid grid-cols-2 gap-2.5">
        <!-- TRIGGER DOMPET ASAL -->
        <div class="space-y-1">
          <label
            class="flex items-center gap-1.5 text-[11px] font-bold text-slate-700"
          >
            <Wallet class="h-3.5 w-3.5 stroke-2 text-blue-600" />
            <span
              x-text="formData.type === 'transfer' ? 'Dompet Asal' : 'Dompet'"
              >Dompet</span
            >
          </label>
          <button
            type="button"
            @click="openWalletSheet('source')"
            class="flex w-full cursor-pointer items-center justify-between rounded-2xl border border-slate-200/80 bg-slate-50/60 px-3 py-2.5 text-xs font-semibold text-slate-800 transition-all hover:border-blue-400 hover:bg-white active:scale-95"
          >
            <span class="truncate font-bold" x-text="selectedWalletName"></span>
            <ChevronRight class="h-3.5 w-3.5 shrink-0 text-slate-400" />
          </button>
        </div>

        <!-- TRIGGER DOMPET TUJUAN (Hanya mode Transfer) -->
        <template x-if="formData.type === 'transfer'">
          <div class="space-y-1">
            <label
              class="flex items-center gap-1.5 text-[11px] font-bold text-slate-700"
            >
              <Wallet class="h-3.5 w-3.5 stroke-2 text-blue-600" />
              <span>Dompet Tujuan</span>
            </label>
            <button
              type="button"
              @click="openWalletSheet('target')"
              class="flex w-full cursor-pointer items-center justify-between rounded-2xl border border-slate-200/80 bg-slate-50/60 px-3 py-2.5 text-xs font-semibold text-slate-800 transition-all hover:border-blue-400 hover:bg-white active:scale-95"
            >
              <span class="truncate font-bold" x-text="selectedToWalletName"
              ></span>
              <ChevronRight class="h-3.5 w-3.5 shrink-0 text-slate-400" />
            </button>
          </div>
        </template>

        <!-- TRIGGER KATEGORI (Jika BUKAN Transfer) -->
        <template x-if="formData.type !== 'transfer'">
          <div class="space-y-1">
            <div class="flex items-center justify-between">
              <label
                class="flex items-center gap-1.5 text-[11px] font-bold text-slate-700"
              >
                <Grid class="h-3.5 w-3.5 stroke-2 text-blue-600" />
                <span>Kategori</span>
              </label>
              <template x-if="autoCategoryDetected">
                <span
                  class="rounded-md bg-blue-50 px-1.5 py-0.5 text-[9px] font-extrabold text-blue-600"
                  >Auto</span
                >
              </template>
            </div>
            <button
              type="button"
              @click="showCategoryModal = true"
              class="flex w-full cursor-pointer items-center justify-between rounded-2xl border border-slate-200/80 bg-slate-50/60 px-3 py-2.5 text-xs font-semibold text-slate-800 transition-all hover:border-blue-400 hover:bg-white active:scale-95"
            >
              <span class="truncate font-bold" x-text="selectedCategoryName"
              ></span>
              <ChevronRight class="h-3.5 w-3.5 shrink-0 text-slate-400" />
            </button>
          </div>
        </template>
      </div>

      <!-- TRIGGER KATEGORI TRANSFER -->
      <template x-if="formData.type === 'transfer'">
        <div class="space-y-1">
          <label
            class="flex items-center gap-1.5 text-[11px] font-bold text-slate-700"
          >
            <Grid class="h-3.5 w-3.5 stroke-2 text-blue-600" />
            <span>Kategori Transfer</span>
          </label>
          <button
            type="button"
            @click="showCategoryModal = true"
            class="flex w-full cursor-pointer items-center justify-between rounded-2xl border border-slate-200/80 bg-slate-50/60 px-3.5 py-2.5 text-xs font-semibold text-slate-800 transition-all hover:border-blue-400 hover:bg-white active:scale-95"
          >
            <span class="truncate font-bold" x-text="selectedCategoryName"
            ></span>
            <ChevronRight class="h-3.5 w-3.5 shrink-0 text-slate-400" />
          </button>
        </div>
      </template>

      <!-- Catatan (Dengan Smart Auto-Category) -->
      <div class="space-y-1">
        <label
          class="flex items-center gap-1.5 text-[11px] font-bold text-slate-700"
        >
          <FileText class="h-3.5 w-3.5 stroke-2 text-blue-600" />
          <span>Catatan (Opsional)</span>
        </label>
        <textarea
          x-model="formData.notes"
          @input="handleNotesInput()"
          rows="2"
          placeholder="Tulis detail transaksi di sini..."
          class="w-full rounded-2xl border border-slate-200/80 bg-slate-50/60 px-3.5 py-2.5 text-xs font-medium text-slate-800 placeholder-slate-400 transition-all outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/10"
        ></textarea>
      </div>
    </div>

    <!-- 5. TOMBOL AKSI -->
    <div class="space-y-2 pt-2">
      <template x-if="!isEditMode">
        <div class="grid grid-cols-2 gap-2">
          <button
            type="button"
            @click="saveTransaction(true)"
            :disabled="isSubmitting"
            class="flex cursor-pointer items-center justify-center gap-1.5 rounded-2xl border border-blue-200 bg-blue-50/70 py-3 text-[11px] font-bold text-blue-600 shadow-2xs transition-all hover:border-blue-300 hover:bg-blue-100/80 active:scale-95 disabled:opacity-50"
          >
            <Plus class="h-3.5 w-3.5 stroke-[2.5]" />
            <span>Simpan & Tambah</span>
          </button>

          <button
            type="button"
            @click="saveTransaction(false)"
            :disabled="isSubmitting"
            class="flex cursor-pointer items-center justify-center gap-1.5 rounded-2xl bg-linear-to-r from-blue-600 to-blue-700 py-3 text-[11px] font-bold text-white shadow-md shadow-blue-600/25 transition-all hover:from-blue-700 hover:to-blue-800 active:scale-95 disabled:opacity-50"
          >
            <Check class="h-3.5 w-3.5 stroke-[2.5]" />
            <span>Simpan</span>
          </button>
        </div>
      </template>

      <template x-if="isEditMode">
        <div class="flex items-center gap-2">
          <button
            type="button"
            @click="deleteTransaction()"
            :disabled="isSubmitting"
            class="flex w-1/3 cursor-pointer items-center justify-center gap-1.5 rounded-2xl border border-red-200 bg-red-50 py-3 text-[11px] font-bold text-red-600 shadow-2xs transition-all hover:bg-red-100 active:scale-95 disabled:opacity-50"
          >
            <Trash2 class="h-3.5 w-3.5 stroke-[2.5]" />
            <span>Hapus</span>
          </button>

          <button
            type="button"
            @click="saveTransaction(false)"
            :disabled="isSubmitting"
            class="flex w-2/3 cursor-pointer items-center justify-center gap-1.5 rounded-2xl bg-linear-to-r from-blue-600 to-blue-700 py-3 text-[11px] font-bold text-white shadow-md shadow-blue-600/25 transition-all hover:from-blue-700 hover:to-blue-800 active:scale-95 disabled:opacity-50"
          >
            <Check class="h-3.5 w-3.5 stroke-[2.5]" />
            <span>Simpan Perubahan</span>
          </button>
        </div>
      </template>
    </div>

    <!-- BOTTOM SHEET MODAL: PILIH DOMPET -->
    <template x-teleport="body">
      <div
        x-show="showWalletModal"
        x-cloak
        class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 backdrop-blur-xs transition-opacity sm:items-center"
      >
        <div
          @click.away="showWalletModal = false"
          class="flex max-h-[80vh] w-full max-w-md flex-col rounded-t-3xl bg-white p-5 shadow-2xl transition-transform sm:rounded-3xl"
        >
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-3"
          >
            <div class="flex items-center gap-2">
              <div
                class="flex h-7 w-7 items-center justify-center rounded-xl bg-blue-50 text-blue-600"
              >
                <Wallet class="h-4 w-4 stroke-2" />
              </div>
              <h3
                class="text-sm font-extrabold text-slate-900"
                x-text="walletSheetTarget === 'source' ? 'Pilih Dompet Asal' : 'Pilih Dompet Tujuan'"
              >
              </h3>
            </div>
            <button
              type="button"
              @click="showWalletModal = false"
              class="flex h-7 w-7 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <div
            class="no-scrollbar divide-y divide-slate-100 overflow-y-auto pt-2"
          >
            <template
              x-for="w in (walletSheetTarget === 'source' ? wallets : availableToWallets)"
              :key="w.id"
            >
              <div
                @click="selectWallet(w.id)"
                class="flex cursor-pointer items-center justify-between rounded-2xl p-3.5 transition-colors hover:bg-slate-50/80"
              >
                <div class="flex items-center gap-3">
                  <div
                    :style="`background-color: ${w.color}20; color: ${w.color}`"
                    class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-100"
                  >
                    <template x-if="w.icon === 'landmark'"
                      ><Landmark class="h-4 w-4 stroke-2" /></template
                    >
                    <template x-if="w.icon === 'building-2'"
                      ><Building2 class="h-4 w-4 stroke-2" /></template
                    >
                    <template x-if="w.icon === 'credit-card'"
                      ><CreditCard class="h-4 w-4 stroke-2" /></template
                    >
                    <template x-if="w.icon === 'coins'"
                      ><Coins class="h-4 w-4 stroke-2" /></template
                    >
                  </div>
                  <span class="text-xs font-bold text-slate-800" x-text="w.name"
                  ></span>
                </div>

                <template
                  x-if="(walletSheetTarget === 'source' && formData.wallet_id === w.id) || (walletSheetTarget === 'target' && formData.to_wallet_id === w.id)"
                >
                  <Check class="h-4 w-4 stroke-[3] text-blue-600" />
                </template>
              </div>
            </template>
          </div>
        </div>
      </div>
    </template>

    <!-- BOTTOM SHEET MODAL: PILIH KATEGORI -->
    <template x-teleport="body">
      <div
        x-show="showCategoryModal"
        x-cloak
        class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 backdrop-blur-xs transition-opacity sm:items-center"
      >
        <div
          @click.away="showCategoryModal = false"
          class="flex max-h-[80vh] w-full max-w-md flex-col rounded-t-3xl bg-white p-5 shadow-2xl transition-transform sm:rounded-3xl"
        >
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-3"
          >
            <div class="flex items-center gap-2">
              <div
                class="flex h-7 w-7 items-center justify-center rounded-xl bg-blue-50 text-blue-600"
              >
                <Grid class="h-4 w-4 stroke-2" />
              </div>
              <h3 class="text-sm font-extrabold text-slate-900">
                Pilih Kategori
              </h3>
            </div>
            <button
              type="button"
              @click="showCategoryModal = false"
              class="flex h-7 w-7 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <div
            class="no-scrollbar divide-y divide-slate-100 overflow-y-auto pt-2"
          >
            <template x-for="c in filteredCategories" :key="c.id">
              <div
                @click="formData.category_id = c.id; autoCategoryDetected = false; showCategoryModal = false"
                class="flex cursor-pointer items-center justify-between rounded-2xl p-3.5 transition-colors hover:bg-slate-50/80"
              >
                <div class="flex items-center gap-3">
                  <div
                    class="flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-slate-700"
                  >
                    <template x-if="c.icon === 'utensils'"
                      ><Utensils
                        class="h-4 w-4 stroke-2 text-amber-600"
                      /></template
                    >
                    <template x-if="c.icon === 'car'"
                      ><Car class="h-4 w-4 stroke-2 text-blue-600" /></template
                    >
                    <template x-if="c.icon === 'shopping-bag'"
                      ><ShoppingBag
                        class="h-4 w-4 stroke-2 text-rose-600"
                      /></template
                    >
                    <template x-if="c.icon === 'receipt'"
                      ><Receipt
                        class="h-4 w-4 stroke-2 text-slate-600"
                      /></template
                    >
                    <template x-if="c.icon === 'gamepad-2'"
                      ><Gamepad2
                        class="h-4 w-4 stroke-2 text-cyan-600"
                      /></template
                    >
                    <template x-if="c.icon === 'heart-pulse'"
                      ><HeartPulse
                        class="h-4 w-4 stroke-2 text-rose-500"
                      /></template
                    >
                    <template x-if="c.icon === 'graduation-cap'"
                      ><GraduationCap
                        class="h-4 w-4 stroke-2 text-indigo-600"
                      /></template
                    >
                    <template x-if="c.icon === 'more-horizontal'"
                      ><MoreHorizontal
                        class="h-4 w-4 stroke-2 text-slate-500"
                      /></template
                    >
                    <template x-if="c.icon === 'briefcase'"
                      ><Briefcase
                        class="h-4 w-4 stroke-2 text-emerald-600"
                      /></template
                    >
                    <template x-if="c.icon === 'gift'"
                      ><Gift class="h-4 w-4 stroke-2 text-pink-600" /></template
                    >
                    <template x-if="c.icon === 'trending-up'"
                      ><TrendingUp
                        class="h-4 w-4 stroke-2 text-emerald-600"
                      /></template
                    >
                    <template x-if="c.icon === 'rotate-ccw'"
                      ><RotateCcw
                        class="h-4 w-4 stroke-2 text-teal-600"
                      /></template
                    >

                    <template
                      x-if="!['utensils','car','shopping-bag','receipt','gamepad-2','heart-pulse','graduation-cap','more-horizontal','briefcase','gift','trending-up','rotate-ccw'].includes(c.icon)"
                    >
                      <Tag class="h-4 w-4 stroke-2 text-slate-400" />
                    </template>
                  </div>
                  <span class="text-xs font-bold text-slate-800" x-text="c.name"
                  ></span>
                </div>

                <template x-if="formData.category_id === c.id">
                  <Check class="h-4 w-4 stroke-[3] text-blue-600" />
                </template>
              </div>
            </template>
          </div>
        </div>
      </div>
    </template>
  </div>
</Layout>

