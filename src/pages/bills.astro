---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft, CreditCard, Plus, Zap, Wifi, Home } from '@lucide/astro';
---

<Layout title="Tagihan - Studion App">
  <div class="space-y-4 pt-2 pb-10">
    <!-- HEADER -->
    <div class="mt-6 flex items-center justify-between pb-1">
      <a
        href="/"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-2xl border border-slate-200/80 bg-white text-slate-700 shadow-2xs transition-all hover:border-blue-400 hover:bg-slate-50 active:scale-95"
      >
        <ArrowLeft class="h-4 w-4 stroke-[2.5]" />
      </a>
      <h1 class="text-sm font-extrabold tracking-tight text-slate-900">
        Tagihan Rutin
      </h1>
      <div class="w-9"></div>
    </div>

    <!-- LIST TAGIHAN -->
    <div
      class="divide-y divide-slate-100 rounded-3xl border border-slate-200/70 bg-white p-2 shadow-sm"
    >
      <div class="flex items-center justify-between p-3">
        <div class="flex items-center gap-3">
          <div
            class="flex h-9 w-9 items-center justify-center rounded-2xl bg-amber-50 text-amber-600"
          >
            <Zap class="h-4.5 w-4.5 stroke-2" />
          </div>
          <div>
            <p class="text-xs font-bold text-slate-800">Listrik PLN</p>
            <p class="text-[10px] font-semibold text-amber-600">
              Belum dibayar • Tgl 20
            </p>
          </div>
        </div>
        <button
          type="button"
          class="rounded-xl bg-blue-600 px-3 py-1.5 text-[10px] font-bold text-white shadow-xs"
          >Bayar</button
        >
      </div>

      <div class="flex items-center justify-between p-3">
        <div class="flex items-center gap-3">
          <div
            class="flex h-9 w-9 items-center justify-center rounded-2xl bg-blue-50 text-blue-600"
          >
            <Wifi class="h-4.5 w-4.5 stroke-2" />
          </div>
          <div>
            <p class="text-xs font-bold text-slate-800">IndiHome WiFi</p>
            <p class="text-[10px] font-semibold text-emerald-600">
              Lunas (1 Sep)
            </p>
          </div>
        </div>
        <span
          class="rounded-full bg-emerald-50 px-2 py-0.5 text-[9px] font-bold text-emerald-600"
          >Lunas</span
        >
      </div>
    </div>

    <!-- TOMBOL TAMBAH -->
    <button
      type="button"
      class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-dashed border-blue-300 bg-blue-50/40 py-3.5 text-blue-600 shadow-2xs transition-all hover:bg-blue-100/60 active:scale-95"
    >
      <Plus class="h-4 w-4 stroke-[2.5]" />
      <span class="text-xs font-bold">Tambah Tagihan</span>
    </button>
  </div>
</Layout>
