---
import Layout from '../layouts/Layout.astro';
import {
  Wallet,
  Plus,
  ArrowRightLeft,
  LayoutGrid,
  List,
  Landmark,
  CreditCard,
  Building2,
  Coins,
  Star,
  Activity,
  ArrowLeft,
  ChevronRight,
  Pencil,
  Trash2,
  X,
  Sparkles,
  Check,
  ArrowUp,
  ArrowDown,
  ArrowUpDown,
  TrendingUp,
  TrendingDown,
} from '@lucide/astro';
---

<Layout title="Dompet Saya - Studion App">
  <div x-data="walletApp()" class="space-y-4 pt-2 pb-10">
    <!-- 1. HEADER -->
    <div class="mt-6 flex items-center justify-between pb-1">
      <a
        href="/"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-2xl border border-slate-200/80 bg-white text-slate-700 shadow-2xs transition-all hover:border-blue-400 hover:bg-slate-50 active:scale-95"
      >
        <ArrowLeft class="h-4 w-4 stroke-[2.5]" />
      </a>

      <h1 class="text-sm font-extrabold tracking-tight text-slate-900">
        Dompet Saya
      </h1>

      <div class="w-9"></div>
    </div>

    <!-- 2. CARD UTAMA (TOTAL SALDO) -->
    <div
      class="relative overflow-hidden rounded-3xl border border-white/15 bg-linear-to-br from-blue-900/90 via-blue-950/95 to-slate-950 p-5 text-white shadow-2xl shadow-blue-950/40 backdrop-blur-xl"
    >
      <div class="relative z-10 flex items-center justify-between">
        <div class="flex items-center gap-2">
          <div
            class="flex h-7 w-7 items-center justify-center rounded-xl border border-white/15 bg-white/10 shadow-inner backdrop-blur-md"
          >
            <Wallet class="h-4 w-4 stroke-2 text-blue-200" />
          </div>
          <span class="text-xs font-medium tracking-wide text-blue-200/80"
            >Total Saldo</span
          >
        </div>

        <!-- CONTROLS: REORDER & TOGGLE VIEW -->
        <div class="flex items-center gap-1.5">
          <!-- Tombol Aktivasi Reorder -->
          <button
            type="button"
            @click="toggleReorderMode()"
            :class="isReordering ? 'bg-amber-400 text-slate-950 border-amber-300' : 'bg-white/10 text-blue-100 border-white/15 hover:bg-white/20'"
            class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full border shadow-xs backdrop-blur-md transition-all active:scale-95"
            title="Atur Urutan Dompet"
          >
            <ArrowUpDown class="h-4 w-4 stroke-[2.5]" />
          </button>

          <!-- Tombol Toggle Mode Card / List -->
          <button
            type="button"
            @click="toggleViewMode()"
            :disabled="isReordering"
            class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full border border-white/15 bg-white/10 text-blue-100 shadow-xs backdrop-blur-md transition-all hover:bg-white/20 active:scale-95 disabled:opacity-40"
            :title="`Beralih ke mode ${viewMode === 'card' ? 'List' : 'Card'}`"
          >
            <LayoutGrid x-show="viewMode === 'list'" class="h-4 w-4 stroke-2" />
            <List x-show="viewMode === 'card'" class="h-4 w-4 stroke-2" />
          </button>
        </div>
      </div>

      <div class="relative z-10 mt-3 mb-3">
        <h2
          x-text="loading ? 'Rp ...' : totalBalance"
          class="text-3xl font-extrabold tracking-tight text-white drop-shadow-sm"
        >
          Rp 0
        </h2>
      </div>

      <div
        class="relative z-10 grid grid-cols-3 gap-2 border-t border-white/10 pt-3"
      >
        <div class="flex items-center gap-2">
          <div
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-blue-400/20 bg-blue-500/20 text-blue-300"
          >
            <Wallet class="h-3.5 w-3.5 stroke-[2.2]" />
          </div>
          <div class="flex min-w-0 flex-col">
            <span
              x-text="wallets.length"
              class="text-xs leading-tight font-extrabold text-white">0</span
            >
            <span class="truncate text-[9px] font-medium text-blue-200/60"
              >Dompet</span
            >
          </div>
        </div>

        <div class="flex items-center gap-2">
          <div
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-amber-400/20 bg-amber-500/20 text-amber-300"
          >
            <Star class="h-3.5 w-3.5 stroke-[2.2]" />
          </div>
          <div class="flex min-w-0 flex-col">
            <span
              x-text="topWallet ? topWallet.name : '-'"
              class="truncate text-xs leading-tight font-extrabold text-white"
              >-</span
            >
            <span class="truncate text-[9px] font-medium text-blue-200/60"
              >Teratas</span
            >
          </div>
        </div>

        <div class="flex items-center gap-2">
          <div
            class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg border border-emerald-400/20 bg-emerald-500/20 text-emerald-300"
          >
            <Activity class="h-3.5 w-3.5 stroke-[2.2]" />
          </div>
          <div class="flex min-w-0 flex-col">
            <span
              x-text="transactions.length"
              class="text-xs leading-tight font-extrabold text-white">0</span
            >
            <span class="truncate text-[9px] font-medium text-blue-200/60"
              >Transaksi</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- 3. ACTION HEADER / BARIS REORDER ACTIVE -->
    <div class="flex items-center justify-between px-0.5">
      <div class="flex items-center gap-1.5">
        <span class="text-xs font-bold tracking-tight text-slate-800">
          Daftar Dompet
        </span>
        <template x-if="isReordering">
          <span
            class="rounded-full bg-amber-100 px-2 py-0.5 text-[9px] font-bold text-amber-800"
          >
            Mode Reorder Aktif
          </span>
        </template>
      </div>

      <template x-if="!isReordering">
        <a
          href="/transaction?type=transfer"
          class="flex cursor-pointer items-center gap-1.5 rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-[11px] font-bold text-blue-600 transition-all hover:bg-blue-100 active:scale-95"
        >
          <ArrowRightLeft class="h-3.5 w-3.5 stroke-[2.5]" />
          <span>Transfer Antar Dompet</span>
        </a>
      </template>

      <template x-if="isReordering">
        <button
          type="button"
          @click="finishReorder()"
          class="flex cursor-pointer items-center gap-1.5 rounded-full bg-slate-900 px-3.5 py-1 text-[11px] font-bold text-white shadow-xs transition-all hover:bg-slate-800 active:scale-95"
        >
          <Check class="h-3.5 w-3.5 stroke-[3]" />
          <span>Selesai Reorder</span>
        </button>
      </template>
    </div>

    <!-- 4. LOADING STATE -->
    <template x-if="loading">
      <div class="py-12 text-center text-xs font-semibold text-slate-400">
        Mengambil data dompet...
      </div>
    </template>

    <!-- 5. MODE CARD -->
    <div
      x-show="!loading && viewMode === 'card' && !isReordering"
      class="space-y-3.5"
    >
      <template x-for="wallet in wallets" :key="wallet.id">
        <div
          :style="`background-color: ${wallet.color || '#1e3a8a'}`"
          class="relative cursor-pointer overflow-hidden rounded-3xl border border-white/20 p-5 text-white shadow-md transition-all hover:shadow-xl active:scale-[0.99]"
        >
          <div
            class="pointer-events-none absolute -top-10 -right-10 h-32 w-32 rounded-full bg-white/10 blur-xl"
          >
          </div>

          <div class="relative z-10 flex items-start justify-between">
            <div class="flex flex-col">
              <span
                x-text="wallet.type"
                class="text-[10px] font-bold tracking-widest text-white/60 uppercase"
              ></span>
              <h3
                x-text="wallet.name"
                class="text-sm font-extrabold tracking-tight text-white"
              >
              </h3>
            </div>

            <div class="flex items-center gap-2">
              <div
                class="flex h-7 w-7 items-center justify-center rounded-xl border border-white/20 bg-white/10 backdrop-blur-md"
              >
                <template x-if="wallet.icon === 'landmark'"
                  ><Landmark class="h-4 w-4 stroke-2" /></template
                >
                <template x-if="wallet.icon === 'building-2'"
                  ><Building2 class="h-4 w-4 stroke-2" /></template
                >
                <template x-if="wallet.icon === 'credit-card'"
                  ><CreditCard class="h-4 w-4 stroke-2" /></template
                >
                <template x-if="wallet.icon === 'coins'"
                  ><Coins class="h-4 w-4 stroke-2" /></template
                >
              </div>
            </div>
          </div>

          <div class="relative z-10 mt-5 mb-2 flex items-end justify-between">
            <div
              class="flex h-6 w-8 items-center justify-center rounded-md border border-amber-300/40 bg-linear-to-r from-amber-300 via-amber-200 to-amber-400 shadow-inner"
            >
              <div class="h-3 w-4 border-y border-amber-600/30"></div>
            </div>

            <div class="flex flex-col items-end">
              <span
                class="text-[9px] font-medium tracking-wide text-white/60 uppercase"
                >Saldo Saat Ini</span
              >
              <span
                x-text="formatCurrency(getWalletBalance(wallet))"
                class="text-xl font-black tracking-tight text-white sm:text-2xl"
              ></span>
            </div>
          </div>

          <div
            @click="showDetail(wallet)"
            class="relative z-10 mt-3 flex items-center justify-between border-t border-white/15 pt-2.5"
          >
            <span
              x-text="`${getWalletTransactionCount(wallet.id)} Transaksi`"
              class="text-[10px] font-semibold text-white/80"></span>
            <div
              class="flex items-center gap-1 text-[10px] font-bold text-white/90"
            >
              <span>Detail</span>
              <ChevronRight class="h-3.5 w-3.5 stroke-[2.5]" />
            </div>
          </div>
        </div>
      </template>
    </div>

    <!-- 6. MODE LIST (SERTA NAVIGASI PANAH REORDER) -->
    <div
      x-show="!loading && (viewMode === 'list' || isReordering)"
      x-cloak
      class="divide-y divide-slate-100 rounded-3xl border border-slate-200/70 bg-white shadow-sm"
    >
      <template x-for="(wallet, index) in wallets" :key="wallet.id">
        <div
          @click="!isReordering && showDetail(wallet)"
          class="flex items-center justify-between p-3.5 transition-colors first:rounded-t-3xl last:rounded-b-3xl"
          :class="isReordering ? 'bg-slate-50/50' : 'cursor-pointer hover:bg-slate-50/80'"
        >
          <div class="flex min-w-0 items-center gap-3">
            <!-- Navigasi Tombol Reorder -->
            <template x-if="isReordering">
              <div class="flex flex-col gap-0.5 pr-1">
                <button
                  type="button"
                  @click.stop="moveWallet(index, 'up')"
                  :disabled="index === 0"
                  class="flex h-6 w-6 cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 shadow-2xs hover:bg-blue-50 hover:text-blue-600 disabled:opacity-20"
                >
                  <ArrowUp class="h-3 w-3 stroke-[3]" />
                </button>
                <button
                  type="button"
                  @click.stop="moveWallet(index, 'down')"
                  :disabled="index === wallets.length - 1"
                  class="flex h-6 w-6 cursor-pointer items-center justify-center rounded-lg border border-slate-200 bg-white text-slate-700 shadow-2xs hover:bg-blue-50 hover:text-blue-600 disabled:opacity-20"
                >
                  <ArrowDown class="h-3 w-3 stroke-[3]" />
                </button>
              </div>
            </template>

            <div
              :style="`background-color: ${wallet.color}20; color: ${wallet.color}`"
              class="flex h-9.5 w-9.5 shrink-0 items-center justify-center rounded-2xl border border-slate-100"
            >
              <template x-if="wallet.icon === 'landmark'"
                ><Landmark class="h-4.5 w-4.5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'building-2'"
                ><Building2 class="h-4.5 w-4.5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'credit-card'"
                ><CreditCard class="h-4.5 w-4.5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'coins'"
                ><Coins class="h-4.5 w-4.5 stroke-2" /></template
              >
            </div>

            <div class="flex min-w-0 flex-col">
              <span
                x-text="wallet.name"
                class="truncate text-xs font-bold text-slate-800"></span>
              <div
                class="flex items-center gap-1 text-[10px] font-medium text-slate-400"
              >
                <span class="capitalize" x-text="wallet.type"></span>
                <span>•</span>
                <span
                  x-text="`${getWalletTransactionCount(wallet.id)} transaksi`"
                ></span>
              </div>
            </div>
          </div>

          <div class="flex shrink-0 flex-col items-end">
            <span
              x-text="formatCurrency(getWalletBalance(wallet))"
              class="text-xs font-extrabold text-slate-900"></span>
          </div>
        </div>
      </template>
    </div>

    <!-- 7. TOMBOL TAMBAH DOMPET -->
    <div x-show="!isReordering" class="pt-1">
      <button
        type="button"
        @click="openAddModal()"
        class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-dashed border-blue-300 bg-blue-50/40 py-3.5 text-blue-600 shadow-2xs transition-all hover:border-blue-500 hover:bg-blue-100/60 active:scale-95"
      >
        <Plus class="h-4 w-4 stroke-[2.5]" />
        <span class="text-xs font-bold">Tambah Dompet Baru</span>
      </button>
    </div>

    <!-- 8. MODAL DETAIL DOMPET (ENGAGED STATS & PILLS FILTER) -->
    <template x-teleport="body">
      <div
        x-show="openDetailModal"
        x-cloak
        class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-xs"
      >
        <div
          @click.away="openDetailModal = false"
          class="w-full max-w-sm overflow-hidden rounded-3xl bg-white shadow-2xl transition-all"
        >
          <div
            :style="`background-color: ${selectedWallet.color || '#2563eb'}`"
            class="relative p-5 text-white"
          >
            <div class="flex items-center justify-between">
              <span
                x-text="selectedWallet.type"
                class="rounded-full bg-white/20 px-2.5 py-0.5 text-[9px] font-bold tracking-widest text-white uppercase backdrop-blur-md"
              ></span>
              <button
                type="button"
                @click="openDetailModal = false"
                class="flex h-7 w-7 items-center justify-center rounded-full bg-white/20 text-white transition-colors hover:bg-white/30"
              >
                <X class="h-4 w-4 stroke-[2.5]" />
              </button>
            </div>

            <div class="mt-4 flex items-center gap-3">
              <div
                class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/20 backdrop-blur-md"
              >
                <template x-if="selectedWallet.icon === 'landmark'"
                  ><Landmark class="h-6 w-6 stroke-2 text-white" /></template
                >
                <template x-if="selectedWallet.icon === 'building-2'"
                  ><Building2 class="h-6 w-6 stroke-2 text-white" /></template
                >
                <template x-if="selectedWallet.icon === 'credit-card'"
                  ><CreditCard class="h-6 w-6 stroke-2 text-white" /></template
                >
                <template x-if="selectedWallet.icon === 'coins'"
                  ><Coins class="h-6 w-6 stroke-2 text-white" /></template
                >
              </div>

              <div class="flex min-w-0 flex-col">
                <h2
                  x-text="selectedWallet.name"
                  class="truncate text-lg font-black tracking-tight text-white"
                >
                </h2>
                <span
                  x-text="`${getWalletTransactionCount(selectedWallet.id)} Total Transaksi`"
                  class="text-[10px] text-white/70"></span>
              </div>
            </div>
          </div>

          <div class="space-y-4 p-5">
            <!-- Saldo Utama -->
            <div
              class="rounded-2xl border border-slate-100 bg-slate-50/80 p-3.5 text-center"
            >
              <span
                class="text-[10px] font-bold tracking-wider text-slate-400 uppercase"
              >
                Saldo Real-Time
              </span>
              <p
                x-text="formatCurrency(getWalletBalance(selectedWallet))"
                class="mt-0.5 text-2xl font-black tracking-tight text-slate-900"
              >
              </p>
            </div>

            <!-- STATISTIK RINGKAS DENGAN PILLS FILTER -->
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-[10px] font-bold text-slate-500 uppercase"
                  >Ringkasan Arus Kas</span
                >

                <!-- 3 Pills Filter Periode -->
                <div
                  class="flex items-center gap-1 rounded-xl bg-slate-100 p-0.5"
                >
                  <button
                    type="button"
                    @click="detailStatsPeriod = '1w'"
                    :class="detailStatsPeriod === '1w' ? 'bg-white text-slate-900 shadow-2xs font-bold' : 'text-slate-500 font-medium'"
                    class="cursor-pointer rounded-lg px-2 py-0.5 text-[9px] transition-all"
                    >1 Mgg</button
                  >
                  <button
                    type="button"
                    @click="detailStatsPeriod = '1m'"
                    :class="detailStatsPeriod === '1m' ? 'bg-white text-slate-900 shadow-2xs font-bold' : 'text-slate-500 font-medium'"
                    class="cursor-pointer rounded-lg px-2 py-0.5 text-[9px] transition-all"
                    >1 Bln</button
                  >
                  <button
                    type="button"
                    @click="detailStatsPeriod = 'all'"
                    :class="detailStatsPeriod === 'all' ? 'bg-white text-slate-900 shadow-2xs font-bold' : 'text-slate-500 font-medium'"
                    class="cursor-pointer rounded-lg px-2 py-0.5 text-[9px] transition-all"
                    >Lifetime</button
                  >
                </div>
              </div>

              <!-- Mini Cards Pemasukan vs Pengeluaran -->
              <div class="grid grid-cols-2 gap-2">
                <div
                  class="rounded-2xl border border-emerald-100 bg-emerald-50/40 p-2.5"
                >
                  <div class="flex items-center gap-1 text-emerald-600">
                    <TrendingUp class="h-3.5 w-3.5 stroke-[2.5]" />
                    <span class="text-[9px] font-bold uppercase">Pemasukan</span
                    >
                  </div>
                  <p
                    x-text="formatCurrency(getWalletDetailStats(selectedWallet.id).income)"
                    class="mt-1 text-xs font-black text-emerald-700"
                  >
                  </p>
                </div>

                <div
                  class="rounded-2xl border border-rose-100 bg-rose-50/40 p-2.5"
                >
                  <div class="flex items-center gap-1 text-rose-600">
                    <TrendingDown class="h-3.5 w-3.5 stroke-[2.5]" />
                    <span class="text-[9px] font-bold uppercase"
                      >Pengeluaran</span
                    >
                  </div>
                  <p
                    x-text="formatCurrency(getWalletDetailStats(selectedWallet.id).expense)"
                    class="mt-1 text-xs font-black text-rose-700"
                  >
                  </p>
                </div>
              </div>
            </div>

            <!-- Tombol Aksi Modal Detail -->
            <div class="flex items-center gap-2 border-t border-slate-100 pt-1">
              <button
                type="button"
                @click="deleteWalletFromDetail()"
                class="flex w-1/3 cursor-pointer items-center justify-center gap-1.5 rounded-2xl border border-red-200 bg-red-50/80 py-3 text-xs font-bold text-red-600 transition-all hover:bg-red-100 active:scale-95"
              >
                <Trash2 class="h-3.5 w-3.5 stroke-[2.5]" />
                <span>Hapus</span>
              </button>

              <button
                type="button"
                @click="openEditFromDetail()"
                class="flex w-2/3 cursor-pointer items-center justify-center gap-1.5 rounded-2xl bg-linear-to-r from-blue-600 to-blue-700 py-3 text-xs font-bold text-white shadow-md shadow-blue-600/20 transition-all hover:from-blue-700 hover:to-blue-800 active:scale-95"
              >
                <Pencil class="h-3.5 w-3.5 stroke-[2.5]" />
                <span>Edit Dompet</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </template>

    <!-- 9. MODAL FORM TAMBAH/EDIT DOMPET -->
    <template x-teleport="body">
      <div
        x-show="openFormModal"
        x-cloak
        class="fixed inset-0 z-50 flex items-center justify-center bg-slate-900/60 p-4 backdrop-blur-xs"
      >
        <div
          @click.away="openFormModal = false"
          class="w-full max-w-sm rounded-3xl bg-white p-5 shadow-2xl transition-all"
        >
          <div
            class="flex items-center justify-between border-b border-slate-100 pb-3"
          >
            <div class="flex items-center gap-2">
              <div
                class="flex h-7 w-7 items-center justify-center rounded-xl bg-blue-50 text-blue-600"
              >
                <Sparkles class="h-4 w-4 stroke-2" />
              </div>
              <h3
                x-text="isEdit ? 'Edit Dompet' : 'Tambah Dompet Baru'"
                class="text-sm font-extrabold text-slate-900"
              >
              </h3>
            </div>
            <button
              type="button"
              @click="openFormModal = false"
              class="flex h-7 w-7 items-center justify-center rounded-full text-slate-400 hover:bg-slate-100 hover:text-slate-600"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <form @submit.prevent="saveWallet()" class="mt-4 space-y-3.5">
            <div>
              <label
                class="mb-1 block text-[10px] font-bold text-slate-500 uppercase"
                >Nama Dompet</label
              >
              <input
                type="text"
                x-model="formData.name"
                placeholder="misal: BCA Utama, Cash, Gopay"
                class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 p-2.5 text-xs font-semibold text-slate-800 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/10"
                required
              />
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label
                  class="mb-1 block text-[10px] font-bold text-slate-500 uppercase"
                  >Tipe Dompet</label
                >
                <select
                  x-model="formData.type"
                  class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 p-2.5 text-xs font-semibold text-slate-800 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/10"
                >
                  <option value="bank">Bank</option>
                  <option value="cash">Cash</option>
                  <option value="e-wallet">E-Wallet</option>
                  <option value="paylater">Paylater / Tagihan</option>
                </select>
              </div>

              <div>
                <label
                  class="mb-1 block text-[10px] font-bold text-slate-500 uppercase"
                  >Ikon</label
                >
                <select
                  x-model="formData.icon"
                  class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 p-2.5 text-xs font-semibold text-slate-800 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/10"
                >
                  <option value="landmark">Bank (Landmark)</option>
                  <option value="building-2">Gedung / Lembaga</option>
                  <option value="credit-card">Kartu / E-Wallet</option>
                  <option value="coins">Koin / Cash</option>
                </select>
              </div>
            </div>

            <div>
              <label
                class="mb-1.5 block text-[10px] font-bold text-slate-500 uppercase"
                >Pilih Warna Tema</label
              >
              <div class="grid grid-cols-5 gap-2">
                <template
                  x-for="c in [
                    { name: 'Blue', hex: '#2563eb' },
                    { name: 'Cyan', hex: '#0891b2' },
                    { name: 'Emerald', hex: '#059669' },
                    { name: 'Amber', hex: '#d97706' },
                    { name: 'Rose', hex: '#e11d48' },
                    { name: 'Violet', hex: '#7c3aed' },
                    { name: 'Indigo', hex: '#4f46e5' },
                    { name: 'Slate', hex: '#334155' },
                    { name: 'Teal', hex: '#0d9488' },
                    { name: 'Orange', hex: '#ea580c' }
                  ]"
                  :key="c.hex"
                >
                  <button
                    type="button"
                    @click="formData.color = c.hex"
                    :style="`background-color: ${c.hex}`"
                    class="flex h-7 w-full cursor-pointer items-center justify-center rounded-xl border-2 transition-all active:scale-95"
                    :class="formData.color === c.hex ? 'border-slate-900 scale-105 shadow-sm' : 'border-transparent opacity-80 hover:opacity-100'"
                  >
                    <template x-if="formData.color === c.hex">
                      <Check class="h-3.5 w-3.5 stroke-[3] text-white" />
                    </template>
                  </button>
                </template>
              </div>
            </div>

            <div>
              <label
                class="mb-1 block text-[10px] font-bold text-slate-500 uppercase"
                >Saldo Awal / Nominal (Rp)</label
              >
              <input
                type="number"
                x-model="formData.balance"
                placeholder="0"
                class="w-full rounded-2xl border border-slate-200 bg-slate-50/60 p-2.5 text-xs font-semibold text-slate-800 outline-none focus:border-blue-500 focus:bg-white focus:ring-2 focus:ring-blue-500/10"
              />
            </div>

            <div class="flex items-center gap-2 pt-2">
              <button
                type="button"
                @click="openFormModal = false"
                class="w-1/3 cursor-pointer rounded-2xl border border-slate-200 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 active:scale-95"
                >Batal</button
              >
              <button
                type="submit"
                class="w-2/3 cursor-pointer rounded-2xl bg-blue-600 py-2.5 text-xs font-bold text-white shadow-md shadow-blue-600/20 hover:bg-blue-700 active:scale-95"
                >Simpan Dompet</button
              >
            </div>
          </form>
        </div>
      </div>
    </template>
  </div>
</Layout>

<!-- SCRIPT ALPINE CLIENT-SIDE -->
<script>
  import { formatCurrency } from '../utils/formatters';
  import {
    calculateSingleWalletBalance,
    calculateTotalBalance,
  } from '../utils/calculations';

  declare const Alpine: any;

  interface WalletItem {
    id: string;
    name: string;
    type: string;
    balance: number;
    color: string;
    icon: string;
    [key: string]: any;
  }

  interface TransactionItem {
    wallet_id: string;
    to_wallet_id?: string;
    amount: number;
    type: 'income' | 'expense' | 'transfer';
    transaction_date?: string;
    created_at?: string;
    [key: string]: any;
  }

  document.addEventListener('alpine:init', () => {
    Alpine.data('walletApp', () => ({
      viewMode: localStorage.getItem('studion_wallet_view_mode') || 'card',
      previousViewMode: 'card',
      isReordering: false,
      initialOrderJson: '',

      wallets: [] as WalletItem[],
      transactions: [] as TransactionItem[],
      loading: true,

      openDetailModal: false,
      openFormModal: false,
      detailStatsPeriod: '1m',

      isEdit: false,
      selectedWallet: {} as WalletItem,
      formData: {
        id: '',
        name: '',
        type: 'bank',
        balance: 0,
        color: '#2563eb',
        icon: 'landmark',
      },

      init() {
        this.fetchAllData();
      },

      toggleViewMode() {
        this.viewMode = this.viewMode === 'card' ? 'list' : 'card';
        localStorage.setItem('studion_wallet_view_mode', this.viewMode);
      },

      // FUNGSI SORTING DENGAN PERSISTENSI LOCALSTORAGE
      applyLocalStorageOrder(fetchedWallets: WalletItem[]) {
        const savedOrderJson = localStorage.getItem(
          'studion_wallet_sort_order'
        );
        if (!savedOrderJson) return fetchedWallets;

        try {
          const savedOrderIds: string[] = JSON.parse(savedOrderJson);
          return [...fetchedWallets].sort((a, b) => {
            const indexA = savedOrderIds.indexOf(a.id);
            const indexB = savedOrderIds.indexOf(b.id);

            // Jika ada dompet baru yang belum tercatat di localStorage, taruh di paling depan
            if (indexA === -1) return -1;
            if (indexB === -1) return 1;

            return indexA - indexB;
          });
        } catch (e) {
          console.error('Error parsing wallet sort order:', e);
          return fetchedWallets;
        }
      },

      toggleReorderMode() {
        if (!this.isReordering) {
          this.previousViewMode = this.viewMode;
          this.isReordering = true;
          this.initialOrderJson = JSON.stringify(this.wallets.map((w) => w.id));
        } else {
          this.finishReorder();
        }
      },

      moveWallet(index: number, direction: 'up' | 'down') {
        const newIndex = direction === 'up' ? index - 1 : index + 1;
        if (newIndex < 0 || newIndex >= this.wallets.length) return;

        const updated = [...this.wallets];
        const temp = updated[index];
        updated[index] = updated[newIndex];
        updated[newIndex] = temp;
        this.wallets = updated;
      },

      finishReorder() {
        const currentOrderJson = JSON.stringify(this.wallets.map((w) => w.id));

        // Jika tidak ada perubahan urutan -> keluar tanpa konfirmasi
        if (currentOrderJson === this.initialOrderJson) {
          this.isReordering = false;
          this.viewMode = this.previousViewMode;
          return;
        }

        // Jika ada perubahan urutan -> simpan ke LocalStorage
        if (confirm('Simpan perubahan urutan dompet?')) {
          const orderIds = this.wallets.map((w) => w.id);
          localStorage.setItem(
            'studion_wallet_sort_order',
            JSON.stringify(orderIds)
          );
        } else {
          // Batal -> Kembalikan urutan dari LocalStorage / Default
          this.fetchAllData();
        }

        this.isReordering = false;
        this.viewMode = this.previousViewMode;
      },

      async fetchAllData() {
        this.loading = true;
        try {
          const [resW, resT] = await Promise.all([
            fetch('/api/wallets'),
            fetch('/api/transactions'),
          ]);
          const rawWallets = (await resW.json()) as WalletItem[];

          // Terapkan urutan tersimpan di LocalStorage
          this.wallets = this.applyLocalStorageOrder(rawWallets);
          this.transactions = (await resT.json()) as TransactionItem[];
        } catch (e) {
          console.error(e);
        } finally {
          this.loading = false;
        }
      },

      getWalletBalance(wallet: WalletItem) {
        return calculateSingleWalletBalance(wallet, this.transactions);
      },

      get totalBalance() {
        const total = calculateTotalBalance(this.wallets, this.transactions);
        return formatCurrency(total);
      },

      getWalletTransactionCount(walletId: string) {
        if (!walletId) return 0;
        return this.transactions.filter(
          (t: TransactionItem) =>
            t.wallet_id === walletId || t.to_wallet_id === walletId
        ).length;
      },

      get topWallet() {
        if (!this.wallets.length) return null;
        return [...this.wallets].sort((a, b) => {
          return this.getWalletBalance(b) - this.getWalletBalance(a);
        })[0];
      },

      getWalletDetailStats(walletId: string) {
        if (!walletId) return { income: 0, expense: 0 };

        const now = new Date();
        const filteredTx = this.transactions.filter((t: TransactionItem) => {
          const isRelated =
            t.wallet_id === walletId || t.to_wallet_id === walletId;
          if (!isRelated) return false;

          if (this.detailStatsPeriod === 'all') return true;

          const txDate = new Date(t.transaction_date || t.created_at || now);
          const diffDays =
            (now.getTime() - txDate.getTime()) / (1000 * 3600 * 24);

          if (this.detailStatsPeriod === '1w') return diffDays <= 7;
          if (this.detailStatsPeriod === '1m') return diffDays <= 30;
          return true;
        });

        let income = 0;
        let expense = 0;

        filteredTx.forEach((t: TransactionItem) => {
          if (t.type === 'income' && t.wallet_id === walletId) {
            income += Number(t.amount);
          } else if (t.type === 'expense' && t.wallet_id === walletId) {
            expense += Number(t.amount);
          } else if (t.type === 'transfer') {
            if (t.to_wallet_id === walletId) income += Number(t.amount);
            if (t.wallet_id === walletId) expense += Number(t.amount);
          }
        });

        return { income, expense };
      },

      formatCurrency(val: number) {
        return formatCurrency(val);
      },

      showDetail(wallet: WalletItem) {
        this.selectedWallet = wallet;
        this.detailStatsPeriod = '1m';
        this.openDetailModal = true;
      },

      openAddModal() {
        this.isEdit = false;
        this.formData = {
          id: '',
          name: '',
          type: 'bank',
          balance: 0,
          color: '#2563eb',
          icon: 'landmark',
        };
        this.openFormModal = true;
      },

      openEditFromDetail() {
        this.isEdit = true;
        this.formData = { ...this.selectedWallet };
        this.openDetailModal = false;
        this.openFormModal = true;
      },

      async saveWallet() {
        if (!this.formData.name) return alert('Nama dompet harus diisi!');
        const method = this.isEdit ? 'PUT' : 'POST';
        const res = await fetch('/api/wallets', {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(this.formData),
        });

        if (res.ok) {
          this.openFormModal = false;
          this.fetchAllData();
        } else {
          alert('Gagal menyimpan dompet!');
        }
      },

      async deleteWalletFromDetail() {
        if (!confirm(`Yakin mau hapus ${this.selectedWallet.name}?`)) return;
        const res = await fetch('/api/wallets', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: this.selectedWallet.id }),
        });

        if (res.ok) {
          this.openDetailModal = false;
          this.fetchAllData();
        } else {
          alert('Gagal menghapus dompet!');
        }
      },
    }));
  });
</script>
