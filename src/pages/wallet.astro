---
import Layout from '../layouts/Layout.astro';
import {
  Wallet,
  Plus,
  ArrowRightLeft,
  Landmark,
  CreditCard,
  Coins,
  Star,
  Activity,
  ArrowLeft,
  Pencil,
  Trash2,
  X,
  Sparkles,
  Check,
  ArrowUp,
  ArrowDown,
  ArrowUpDown,
  AlertTriangle,
  ChevronDown,
  PiggyBank,
  QrCode,
  Briefcase,
  Building,
} from '@lucide/astro';
---

<Layout title="Dompet Saya - Studion App">
  <div
    x-data="{
  // Gunakan getter agar selalu mengambil instance store yang valid dari Alpine
  get accStore() {
    return Alpine.store('accountStore');
  },
  get txStore() {
    return Alpine.store('transactionStore');
  },

  isReordering: false,
  walletOrder: [],
  originalWalletOrder: [],
  openDetailModal: false,
  openFormModal: false,
  openCorrectionModal: false,
  openDeleteWarningModal: false,
openDeleteConfirmModal: false,
deleteConfirmName: '',
  isEdit: false,
  openIconPicker: false,
  selectedWallet: {},
  formData: {
    id: null,
    name: '',
    icon: 'landmark',
    initial_balance: 0
  },
  formattedBalance: '',
rawBalance: 0,
  newCorrectionBalance: 0,

      // Semua ikon dompet yang tersedia
      availableIcons: [
        { id: 'landmark', name: 'Bank Utama' },
        { id: 'building', name: 'Bank Cabang' },
        { id: 'credit-card', name: 'Kartu Kredit' },
        { id: 'coins', name: 'Tunai / Cash' },
        { id: 'wallet', name: 'Dompet Fisik' },
        { id: 'piggy-bank', name: 'Celengan' },
        { id: 'qr-code', name: 'E-Wallet QR' },
        { id: 'briefcase', name: 'Gaji / Bisnis' },
      ],

     async init() {
  if (this.accStore && !this.accStore.accounts?.length) {
    await this.accStore.init();
  }

  if (this.txStore && !this.txStore.transactions?.length) {
    await this.txStore.init();
  }

  const savedOrder = JSON.parse(
    localStorage.getItem('wallet_order') || '[]'
  );

  if (savedOrder.length) {
    this.walletOrder = savedOrder;
  }
},

handleBalanceInput(event) {
  const value = event.target.value.replace(/[^0-9]/g, '');

  this.rawBalance = value ? parseInt(value, 10) : 0;

  this.formattedBalance = this.rawBalance
    ? this.rawBalance.toLocaleString('id-ID')
    : '';
},

      get wallets() {
  const accounts = this.accStore?.accounts || [];

  if (!accounts.length) return [];

  if (!this.walletOrder.length) {
    return accounts;
  }

  const orderMap = new Map(
    this.walletOrder.map((id, index) => [id, index])
  );

  return [...accounts].sort((a, b) => {
    const indexA = orderMap.has(a.id)
      ? orderMap.get(a.id)
      : Number.MAX_SAFE_INTEGER;

    const indexB = orderMap.has(b.id)
      ? orderMap.get(b.id)
      : Number.MAX_SAFE_INTEGER;

    return indexA - indexB;
  });
},

      get totalBalance() {
        if (!this.accStore || typeof this.accStore.getTotalAssets !== 'function') return 'Rp 0';
        const total = this.accStore.getTotalAssets(this.txStore?.transactions || []);
        return 'Rp ' + (total || 0).toLocaleString('id-ID');
      },

      get topWallet() {
        if (!this.wallets.length) return null;
        return [...this.wallets].map(w => ({
          ...w,
          realBalance: this.accStore.getBalance(w, this.txStore?.transactions || [])
        })).sort((a, b) => b.realBalance - a.realBalance)[0];
      },

      formatCurrency(val) {
        return 'Rp ' + (val || 0).toLocaleString('id-ID');
      },

      getAccountRealBalance(id) {
  if (!this.accStore || typeof this.accStore.getBalance !== 'function') {
    return 0;
  }

  const account = this.wallets.find((wallet) => wallet.id === id);

  if (!account) {
    return 0;
  }

  return this.accStore.getBalance(
    account,
    this.txStore?.transactions || []
  );
},

      getWalletTransactionCount(id) {
        if (!this.txStore?.transactions) return 0;
        return this.txStore.transactions.filter(
          tx => tx.account_id === id || tx.to_account_id === id
        ).length;
      },

      toggleReorderMode() {
  if (!this.isReordering) {
    this.originalWalletOrder = this.wallets.map(
      (wallet) => wallet.id
    );

    this.walletOrder = [...this.originalWalletOrder];
    this.isReordering = true;
    return;
  }

  this.finishReorder();
},

      moveWallet(index, direction) {
  const targetIndex =
    direction === 'up' ? index - 1 : index + 1;

  if (
    targetIndex < 0 ||
    targetIndex >= this.wallets.length
  ) {
    return;
  }

  const newOrder = this.wallets.map(
    (wallet) => wallet.id
  );

  [newOrder[index], newOrder[targetIndex]] = [
    newOrder[targetIndex],
    newOrder[index],
  ];

  this.walletOrder = newOrder;
},

     finishReorder() {
  const currentOrder = this.wallets.map(
    (wallet) => wallet.id
  );

  const hasChanged =
    JSON.stringify(currentOrder) !==
    JSON.stringify(this.originalWalletOrder);

  if (hasChanged) {
    localStorage.setItem(
      'wallet_order',
      JSON.stringify(currentOrder)
    );
  }

  this.originalWalletOrder = [];
  this.isReordering = false;
},

      showDetail(wallet) {
        this.selectedWallet = wallet;
        this.openDetailModal = true;
      },

     openAddModal() {
  this.isEdit = false;

  this.formData = {
    id: null,
    name: '',
    icon: 'landmark',
    initial_balance: 0
  };

  this.rawBalance = 0;
  this.formattedBalance = '';

  this.openFormModal = true;

  this.$nextTick(() => {
    this.$refs.accountNameInput?.focus();
  });
},

      openEditFromDetail() {
        this.isEdit = true;

  const currentBalance = this.getWalletCurrentBalance(
    this.selectedWallet.id
  );

  this.formData = {
    id: this.selectedWallet.id,
    name: this.selectedWallet.name,
    icon: this.selectedWallet.icon,
  };

  this.rawBalance = currentBalance;

  this.formattedBalance = currentBalance
    ? currentBalance.toLocaleString('id-ID')
    : '';

  this.openDetailModal = false;
  this.openFormModal = true;
      },

      getWalletCurrentBalance(walletId) {
  const wallet = this.accStore.accounts.find(
    (account) => account.id === walletId
  );

  if (!wallet) return 0;

  let balance = Number(wallet.initial_balance) || 0;

  this.txStore.transactions.forEach((tx) => {
    const amount = Number(tx.amount) || 0;
    const fee = Number(tx.fee) || 0;

    if (tx.type === 'income' && tx.account_id === walletId) {
      balance += amount;
    }

    if (tx.type === 'expense' && tx.account_id === walletId) {
      balance -= amount;
    }

    if (tx.type === 'transfer') {
      if (tx.account_id === walletId) {
        balance -= amount + fee;
      }

      if (tx.to_account_id === walletId) {
        balance += amount;
      }
    }
  });

  return balance;
},
      
      async deleteWalletFromDetail() {
  const txCount = this.getWalletTransactionCount(
    this.selectedWallet.id
  );

  // Tidak punya transaksi → langsung hapus
  if (txCount === 0) {
    await this.accStore.deleteAccount(
      this.selectedWallet.id,
      this.txStore
    );

    this.openDetailModal = false;
    return;
  }

  // Punya transaksi → warning pertama
  this.openDeleteWarningModal = true;
},

proceedDeleteConfirmation() {
  this.openDeleteWarningModal = false;
  this.deleteConfirmName = '';
  this.openDeleteConfirmModal = true;

  this.$nextTick(() => {
    this.$refs.deleteConfirmInput?.focus();
  });
},

async confirmDeleteWallet() {
  if (
    this.deleteConfirmName.trim() !==
    this.selectedWallet.name
  ) {
    return;
  }

  await this.accStore.deleteAccount(
    this.selectedWallet.id,
    this.txStore
  );

  this.openDeleteConfirmModal = false;
  this.openDetailModal = false;
  this.deleteConfirmName = '';
},

      async saveWallet() {
  if (!this.formData.name.trim()) return;

  const targetBalance = this.rawBalance;

  if (!this.accStore) {
    console.error('accountStore belum terinisialisasi!');
    return;
  }

  if (this.isEdit) {
   const txCount = this.getWalletTransactionCount(this.formData.id);
const currentBalance = this.getWalletCurrentBalance(
  this.formData.id
);

    if (txCount > 0 && targetBalance !== currentBalance) {
      this.newCorrectionBalance = targetBalance;
      this.openFormModal = false;
      this.openCorrectionModal = true;
      return;
    }

    await this.accStore.updateAccount(this.formData.id, {
      name: this.formData.name.trim(),
      icon: this.formData.icon,
      initial_balance: targetBalance
    });
  } else {
    await this.accStore.addAccount({
      name: this.formData.name.trim(),
      icon: this.formData.icon,
      initial_balance: targetBalance
    });

    // Account baru selalu masuk paling atas di UI
    const newWallet = this.accStore.accounts[0];

    this.walletOrder = [
      newWallet.id,
      ...this.walletOrder.filter((id) => id !== newWallet.id),
    ];

    // Simpan urutan terbaru
    localStorage.setItem(
      'wallet_order',
      JSON.stringify(this.walletOrder)
    );
  }

  this.openFormModal = false;
},

     async confirmCorrection() {
  const account = this.accStore.accounts.find(
    (acc) => acc.id === this.formData.id
  );

  if (!account) return;

  await this.accStore.updateAccount(this.formData.id, {
    name: this.formData.name.trim(),
    icon: this.formData.icon
  });

  await this.accStore.correctBalance(
    account,
    this.newCorrectionBalance,
    this.txStore.transactions || [],
    this.txStore
  );

  this.openCorrectionModal = false;
},
    }
      
    
    "
    class="space-y-5 pt-2 pb-12"
  >
    <!-- 1. STICKY HEADER -->
    <div
      class="border-border bg-background/95 sticky top-0 z-40 -mx-5 -mt-2 space-y-3 border-b px-5 pt-6 pb-3 backdrop-blur-md"
    >
      <div class="flex items-center justify-between">
        <a
          href="/"
          class="border-border bg-card text-muted-foreground hover:bg-muted flex h-9.5 w-9.5 cursor-pointer items-center justify-center rounded-2xl border shadow-xs transition-all active:scale-95"
        >
          <ArrowLeft class="h-4.5 w-4.5 stroke-[2.5]" />
        </a>

        <h1 class="text-primary text-base font-extrabold tracking-tight">
          Dompet Saya
        </h1>

        <div class="w-9.5"></div>
      </div>
    </div>

    <!-- 2. CARD UTAMA (TOTAL SALDO & MICRO INFO) -->
    <div
      class="bg-card-blue-dark shadow-soft relative overflow-hidden rounded-[28px] p-6 text-white transition-all duration-300"
    >
      <div
        class="pointer-events-none absolute -right-8 -bottom-10 h-40 w-40 rounded-full bg-white/10"
      >
      </div>
      <div
        class="pointer-events-none absolute right-16 -bottom-16 h-32 w-32 rounded-full bg-white/5"
      >
      </div>

      <div class="relative z-10 flex items-center justify-between">
        <div class="flex items-center gap-2.5">
          <div
            class="flex h-8 w-8 items-center justify-center rounded-xl bg-white/15 backdrop-blur-md"
          >
            <Wallet class="h-4 w-4 stroke-[2.2] text-white" />
          </div>
          <span class="text-xs font-semibold tracking-wide text-white/80"
            >Total Saldo Dompet</span
          >
        </div>

        <button
          type="button"
          @click="toggleReorderMode()"
          :class="isReordering ? 'bg-white text-primary' : 'bg-white/15 text-white hover:bg-white/25'"
          class="flex h-8 w-8 cursor-pointer items-center justify-center rounded-full backdrop-blur-md transition-all active:scale-95"
          title="Atur Urutan Dompet"
        >
          <ArrowUpDown class="h-4 w-4 stroke-[2.5]" />
        </button>
      </div>

      <div class="relative z-10 mt-5 mb-4">
        <h2
          x-text="totalBalance"
          class="text-3xl font-extrabold tracking-tight text-white drop-shadow-xs"
        >
          Rp 0
        </h2>
      </div>

      <div
        class="relative z-10 grid grid-cols-3 gap-1.5 border-t border-white/15 pt-3"
      >
        <div class="flex min-w-0 items-center gap-1.5">
          <div
            class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-white/15 text-white"
          >
            <Wallet class="h-3 w-3 stroke-[2.2]" />
          </div>
          <div class="flex min-w-0 flex-col">
            <span
              x-text="wallets.length"
              class="text-[11px] leading-tight font-extrabold text-white"
              >0</span
            >
            <span class="truncate text-[9px] font-medium text-white/70"
              >Dompet</span
            >
          </div>
        </div>

        <div class="flex min-w-0 items-center gap-1.5">
          <div
            class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-white/15 text-white"
          >
            <Star class="h-3 w-3 stroke-[2.2]" />
          </div>
          <div class="flex min-w-0 flex-col">
            <span
              x-text="topWallet ? topWallet.name : '-'"
              class="truncate text-[11px] leading-tight font-extrabold text-white"
              >-</span
            >
            <span class="truncate text-[9px] font-medium text-white/70"
              >Teratas</span
            >
          </div>
        </div>

        <div class="flex min-w-0 items-center gap-1.5">
          <div
            class="flex h-6 w-6 shrink-0 items-center justify-center rounded-lg bg-white/15 text-white"
          >
            <Activity class="h-3 w-3 stroke-[2.2]" />
          </div>
          <div class="flex min-w-0 flex-col">
            <span
              x-text="txStore?.transactions?.length || 0"
              class="text-[11px] leading-tight font-extrabold text-white"
              >0</span
            >
            <span class="truncate text-[9px] font-medium text-white/70"
              >Transaksi</span
            >
          </div>
        </div>
      </div>
    </div>

    <!-- 3. ACTION HEADER -->
    <div class="flex items-center justify-between px-1">
      <div class="flex items-center gap-2">
        <span class="text-primary text-sm font-bold"> Daftar Dompet </span>
        <template x-if="isReordering">
          <span
            class="bg-blue-soft text-blue-main rounded-full px-2.5 py-0.5 text-[9px] font-extrabold"
          >
            Reorder Mode
          </span>
        </template>
      </div>

      <template x-if="!isReordering">
        <a
          href="/transaction?type=transfer"
          class="bg-blue-soft text-blue-main hover:bg-blue-soft/80 flex cursor-pointer items-center gap-1.5 rounded-full px-3.5 py-1.5 text-xs font-bold transition-all active:scale-95"
        >
          <ArrowRightLeft class="h-3.5 w-3.5 stroke-[2.5]" />
          <span>Transfer</span>
        </a>
      </template>

      <template x-if="isReordering">
        <button
          type="button"
          @click="finishReorder()"
          class="bg-primary text-primary-foreground shadow-soft flex cursor-pointer items-center gap-1 rounded-full px-3.5 py-1.5 text-xs font-bold transition-all hover:opacity-90 active:scale-95"
        >
          <Check class="h-3.5 w-3.5 stroke-3" />
          <span>Selesai</span>
        </button>
      </template>
    </div>

    <!-- 4. DAFTAR DOMPET -->
    <div
      class="divide-border border-border bg-card shadow-soft divide-y overflow-hidden rounded-[28px] border"
    >
      <template x-if="accStore?.isLoading">
        <div class="text-muted-foreground p-4 text-center text-xs">
          Memuat dompet...
        </div>
      </template>

      <template x-if="!accStore?.isLoading && wallets.length === 0">
        <div class="text-muted-foreground p-6 text-center text-xs">
          Belum ada dompet. Klik tombol di bawah untuk menambah.
        </div>
      </template>

      <template x-for="(wallet, index) in wallets" :key="wallet.id">
        <div
          @click="!isReordering && showDetail(wallet)"
          class="flex items-center justify-between p-4 transition-colors"
          :class="isReordering ? 'bg-muted/30' : 'cursor-pointer hover:bg-muted/50'"
        >
          <div class="flex min-w-0 items-center gap-3.5">
            <!-- Dynamic Icon Box -->
            <div
              class="bg-blue-soft text-primary flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl"
            >
              <template x-if="wallet.icon === 'landmark'"
                ><Landmark class="h-5 w-5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'building'"
                ><Building class="h-5 w-5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'credit-card'"
                ><CreditCard class="h-5 w-5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'coins'"
                ><Coins class="h-5 w-5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'wallet'"
                ><Wallet class="h-5 w-5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'piggy-bank'"
                ><PiggyBank class="h-5 w-5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'qr-code'"
                ><QrCode class="h-5 w-5 stroke-2" /></template
              >
              <template x-if="wallet.icon === 'briefcase'"
                ><Briefcase class="h-5 w-5 stroke-2" /></template
              >
            </div>

            <div class="flex min-w-0 flex-col">
              <span
                x-text="wallet.name"
                class="text-foreground truncate text-xs font-bold"></span>
              <div
                class="text-muted-foreground flex items-center gap-1 text-[10px] font-medium"
              >
                <span
                  x-text="`${getWalletTransactionCount(wallet.id)} transaksi`"
                ></span>
              </div>
            </div>
          </div>

          <div class="flex shrink-0 items-center gap-2">
            <span
              x-text="formatCurrency(getAccountRealBalance(wallet.id))"
              class="text-foreground text-xs font-extrabold"></span>

            <template x-if="isReordering">
              <div class="flex flex-col gap-1 pr-1">
                <button
                  type="button"
                  @click.stop="moveWallet(index, 'up')"
                  :disabled="index === 0"
                  class="border-border bg-card text-foreground hover:bg-blue-soft flex h-6 w-6 cursor-pointer items-center justify-center rounded-lg border disabled:opacity-20"
                >
                  <ArrowUp class="h-3 w-3 stroke-3" />
                </button>

                <button
                  type="button"
                  @click.stop="moveWallet(index, 'down')"
                  :disabled="index === wallets.length - 1"
                  class="border-border bg-card text-foreground hover:bg-blue-soft flex h-6 w-6 cursor-pointer items-center justify-center rounded-lg border disabled:opacity-20"
                >
                  <ArrowDown class="h-3 w-3 stroke-3" />
                </button>
              </div>
            </template>
          </div>
        </div>
      </template>
    </div>

    <!-- 5. TOMBOL TAMBAH DOMPET -->
    <div x-show="!isReordering" class="pt-1">
      <button
        type="button"
        @click="openAddModal()"
        class="border-blue-main/40 bg-blue-soft/30 text-blue-main hover:border-blue-main hover:bg-blue-soft flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-dashed py-3.5 shadow-xs transition-all active:scale-95"
      >
        <Plus class="h-4 w-4 stroke-[2.5]" />
        <span class="text-xs font-bold">Tambah Dompet Baru</span>
      </button>
    </div>

    <!-- 6. MODAL DETAIL DOMPET -->
    <div
      x-show="openDetailModal"
      x-cloak
      class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
    >
      <div
        @click.away="openDetailModal = false"
        class="border-border bg-card flex max-h-[90vh] w-full max-w-md flex-col overflow-hidden rounded-t-4xl border pb-16 shadow-2xl transition-transform sm:rounded-4xl"
      >
        <div class="bg-card-blue-dark relative p-6 text-white">
          <div
            class="pointer-events-none absolute -right-6 -bottom-8 h-28 w-28 rounded-full bg-white/10"
          >
          </div>

          <div class="relative z-10 flex items-center justify-between">
            <span
              class="rounded-full bg-white/20 px-2.5 py-0.5 text-[9px] font-bold tracking-widest text-white uppercase"
              >Detail Dompet</span
            >
            <button
              type="button"
              @click="openDetailModal = false"
              class="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 text-white"
            >
              <X class="h-4 w-4 stroke-[2.5]" />
            </button>
          </div>

          <div class="relative z-10 mt-5 flex items-center gap-3.5">
            <div
              class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-white/20 text-white"
            >
              <template x-if="selectedWallet.icon === 'landmark'"
                ><Landmark class="h-6 w-6 stroke-2" /></template
              >
              <template x-if="selectedWallet.icon === 'building'"
                ><Building class="h-6 w-6 stroke-2" /></template
              >
              <template x-if="selectedWallet.icon === 'credit-card'"
                ><CreditCard class="h-6 w-6 stroke-2" /></template
              >
              <template x-if="selectedWallet.icon === 'coins'"
                ><Coins class="h-6 w-6 stroke-2" /></template
              >
              <template x-if="selectedWallet.icon === 'wallet'"
                ><Wallet class="h-6 w-6 stroke-2" /></template
              >
              <template x-if="selectedWallet.icon === 'piggy-bank'"
                ><PiggyBank class="h-6 w-6 stroke-2" /></template
              >
              <template x-if="selectedWallet.icon === 'qr-code'"
                ><QrCode class="h-6 w-6 stroke-2" /></template
              >
              <template x-if="selectedWallet.icon === 'briefcase'"
                ><Briefcase class="h-6 w-6 stroke-2" /></template
              >
            </div>

            <div class="flex min-w-0 flex-col">
              <h2
                x-text="selectedWallet.name"
                class="truncate text-lg font-black tracking-tight text-white"
              >
              </h2>
              <span
                x-text="`${getWalletTransactionCount(selectedWallet.id)} Total Transaksi`"
                class="text-[10px] text-white/70"></span>
            </div>
          </div>
        </div>

        <div class="space-y-4 p-6">
          <div
            class="border-border bg-background rounded-2xl border p-4 text-center"
          >
            <span
              class="text-muted-foreground text-[10px] font-bold tracking-wider uppercase"
              >Saldo Real-Time</span
            >
            <p
              x-text="formatCurrency(getAccountRealBalance(selectedWallet.id))"
              class="text-primary mt-0.5 text-2xl font-black tracking-tight"
            >
            </p>
          </div>

          <div class="flex items-center gap-2 pt-1">
            <button
              type="button"
              @click="deleteWalletFromDetail()"
              class="flex w-1/3 cursor-pointer items-center justify-center gap-1.5 rounded-2xl border border-rose-200 bg-rose-50/80 py-3.5 text-xs font-bold text-rose-600 transition-colors active:scale-95"
            >
              <Trash2 class="h-4 w-4 stroke-2" />
              <span>Hapus</span>
            </button>

            <button
              type="button"
              @click="openEditFromDetail()"
              class="bg-primary text-primary-foreground shadow-soft flex w-2/3 cursor-pointer items-center justify-center gap-1.5 rounded-2xl py-3.5 text-xs font-bold transition-opacity hover:opacity-90 active:scale-95"
            >
              <Pencil class="h-4 w-4 stroke-2" />
              <span>Edit Dompet</span>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- MODAL WARNING DELETE -->
    <div
      x-show="openDeleteWarningModal"
      x-cloak
      class="bg-primary/20 fixed inset-0 -bottom-10 z-60 flex items-end justify-center backdrop-blur-xs sm:items-center"
    >
      <div
        @click.away="openDeleteWarningModal = false"
        class="border-border bg-card w-full max-w-md rounded-t-4xl border p-6 pb-24 shadow-2xl sm:rounded-4xl"
      >
        <div class="flex items-start gap-3">
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-rose-100 text-rose-600"
          >
            <AlertTriangle class="h-5 w-5 stroke-2" />
          </div>

          <div class="min-w-0">
            <h3 class="text-foreground text-sm font-extrabold">
              Hapus Dompet?
            </h3>

            <p class="text-muted-foreground mt-1 text-xs leading-relaxed">
              Dompet
              <strong class="text-foreground" x-text="selectedWallet.name"
              ></strong>
              memiliki
              <strong
                class="text-foreground"
                x-text="getWalletTransactionCount(selectedWallet.id)"></strong>
              transaksi.
            </p>

            <p class="text-muted-foreground mt-2 text-xs leading-relaxed">
              Jika dilanjutkan, seluruh transaksi yang terkait dengan dompet ini
              juga akan dihapus dan
              <strong class="text-rose-600">
                data yang sudah dihapus tidak dapat dipulihkan.
              </strong>
            </p>
          </div>
        </div>

        <div class="mt-6 flex items-center gap-2">
          <button
            type="button"
            @click="openDeleteWarningModal = false"
            class="border-border text-muted-foreground hover:bg-muted w-1/3 cursor-pointer rounded-2xl border py-3.5 text-xs font-bold"
          >
            Batal
          </button>

          <button
            type="button"
            @click="proceedDeleteConfirmation()"
            class="w-2/3 cursor-pointer rounded-2xl bg-rose-600 py-3.5 text-xs font-bold text-white transition-opacity hover:bg-rose-500 active:scale-95"
          >
            Lanjut Hapus
          </button>
        </div>
      </div>
    </div>

    <!-- MODAL FINAL DELETE CONFIRMATION -->
    <div
      x-show="openDeleteConfirmModal"
      x-cloak
      class="bg-primary/20 fixed inset-0 -bottom-10 z-70 flex items-end justify-center backdrop-blur-xs sm:items-center"
    >
      <div
        @click.away="openDeleteConfirmModal = false"
        class="border-border bg-card w-full max-w-md rounded-t-4xl border p-6 pb-24 shadow-2xl sm:rounded-4xl"
      >
        <div class="flex items-start gap-3">
          <div
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl bg-rose-100 text-rose-600"
          >
            <Trash2 class="h-5 w-5 stroke-2" />
          </div>

          <div>
            <h3 class="text-foreground text-sm font-extrabold">
              Konfirmasi Penghapusan
            </h3>

            <p class="text-muted-foreground mt-1 text-xs leading-relaxed">
              Tindakan ini akan menghapus dompet beserta seluruh transaksi yang
              terkait secara permanen.
            </p>
          </div>
        </div>

        <div class="mt-5">
          <p class="text-muted-foreground text-xs leading-relaxed">
            Untuk memastikan lu benar-benar sadar dengan tindakan ini, ketik
            nama dompet berikut:
          </p>

          <p
            class="text-foreground bg-muted mt-2 rounded-xl px-3 py-2 text-center text-sm font-black"
            x-text="selectedWallet.name"
          >
          </p>

          <input
            type="text"
            x-ref="deleteConfirmInput"
            x-model="deleteConfirmName"
            placeholder="Ketik nama dompet"
            class="border-border bg-background text-foreground mt-3 w-full rounded-2xl border px-4 py-3 text-xs font-semibold outline-none focus:border-rose-500"
            autocomplete="off"
            @keydown.enter="confirmDeleteWallet()"
          />
        </div>

        <div class="mt-6 flex items-center gap-2">
          <button
            type="button"
            @click="openDeleteConfirmModal = false; deleteConfirmName = ''"
            class="border-border text-muted-foreground hover:bg-muted w-1/3 cursor-pointer rounded-2xl border py-3.5 text-xs font-bold"
          >
            Batal
          </button>

          <button
            type="button"
            @click="confirmDeleteWallet()"
            :disabled="deleteConfirmName.trim() !== selectedWallet.name"
            :class=`
          deleteConfirmName.trim() === selectedWallet.name
            ? 'bg-rose-600 hover:bg-rose-500 cursor-pointer'
            : 'bg-rose-200 text-muted-foreground cursor-not-allowed'
        `
            class="w-2/3 rounded-2xl py-3.5 text-xs font-bold text-white transition-all active:scale-95 disabled:active:scale-100"
          >
            Hapus Permanen
          </button>
        </div>
      </div>
    </div>

    <!-- 7. MODAL KOREKSI SALDO -->
    <div
      x-show="openCorrectionModal"
      x-cloak
      class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
    >
      <div
        @click.away="openCorrectionModal = false"
        class="border-border bg-card flex max-h-[90vh] w-full max-w-md flex-col space-y-4 rounded-t-4xl border p-6 pb-24 shadow-2xl transition-transform sm:rounded-4xl"
      >
        <div class="flex items-center gap-3 text-amber-600">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-2xl bg-amber-100"
          >
            <AlertTriangle class="h-5 w-5 stroke-2" />
          </div>
          <div>
            <h3 class="text-foreground text-sm font-extrabold">
              Koreksi Saldo Akun
            </h3>
            <p class="text-muted-foreground text-[10px]">
              Akun ini sudah memiliki riwayat transaksi.
            </p>
          </div>
        </div>

        <p class="text-muted-foreground text-xs leading-relaxed">
          Perubahan saldo awal tidak disarankan secara langsung karena ada
          transaksi tercatat. Sistem akan membuat <strong
            class="text-foreground">Transaksi Koreksi Saldo</strong
          > otomatis agar total saldo dompet menjadi <strong
            class="text-foreground"
            x-text="formatCurrency(newCorrectionBalance)"></strong>.
        </p>

        <div class="flex items-center gap-2 pt-2">
          <button
            type="button"
            @click="openCorrectionModal = false"
            class="border-border text-muted-foreground hover:bg-muted w-1/3 cursor-pointer rounded-2xl border py-3.5 text-xs font-bold"
            >Batal</button
          >
          <button
            type="button"
            @click="confirmCorrection()"
            class="shadow-soft w-2/3 cursor-pointer rounded-2xl bg-amber-600 py-3.5 text-xs font-bold text-white hover:bg-amber-500 active:scale-95"
            >Buat Koreksi</button
          >
        </div>
      </div>
    </div>

    <!-- 8. MODAL FORM TAMBAH/EDIT DOMPET -->
    <div
      x-show="openFormModal"
      x-cloak
      class="bg-primary/20 fixed inset-0 z-50 flex items-end justify-center backdrop-blur-xs transition-opacity sm:items-center"
    >
      <div
        @click.away="openFormModal = false"
        class="border-border bg-card flex max-h-[90vh] w-full max-w-md flex-col rounded-t-4xl border p-6 pb-24 shadow-2xl transition-transform sm:rounded-4xl"
      >
        <div
          class="border-border flex items-center justify-between border-b pb-3"
        >
          <div class="flex items-center gap-2">
            <div
              class="bg-blue-soft text-blue-main flex h-8 w-8 items-center justify-center rounded-xl"
            >
              <Sparkles class="h-4 w-4 stroke-2" />
            </div>
            <h3
              x-text="isEdit ? 'Edit Dompet' : 'Tambah Dompet Baru'"
              class="text-primary text-base font-extrabold"
            >
            </h3>
          </div>
          <button
            type="button"
            @click="openFormModal = false"
            class="text-muted-foreground hover:bg-muted flex h-8 w-8 items-center justify-center rounded-full"
          >
            <X class="h-4 w-4 stroke-[2.5]" />
          </button>
        </div>

        <form @submit.prevent="saveWallet()" class="mt-4 space-y-4">
          <!-- NAMA DOMPET -->
          <div class="space-y-1.5">
            <label
              class="text-muted-foreground block text-[10px] font-bold uppercase"
              >Nama Dompet</label
            >
            <input
              type="text"
              x-ref="accountNameInput"
              x-model="formData.name"
              placeholder="misal: BCA, Cash, Gopay"
              class="border-border bg-background text-foreground focus:border-blue-main w-full rounded-2xl border px-4 py-3 text-xs font-semibold outline-none"
              required
            />
          </div>

          <!-- IKON DOMPET -->
          <div class="space-y-2">
            <label class="text-foreground text-xs font-bold">
              Icon Dompet
            </label>

            <div
              class="border-border bg-muted/20 mt-3 overflow-y-auto rounded-2xl border p-3"
            >
              <div class="grid grid-cols-6 gap-2">
                <template x-for="icon in availableIcons" :key="icon.id">
                  <button
                    type="button"
                    @click="formData.icon = icon.id"
                    :class=`
          formData.icon === icon.id
             ? 'bg-blue-soft text-blue border-blue'
          : 'bg-card text-muted-foreground border-border hover:bg-muted/50'
                    `
                    class="flex h-11 w-11 items-center justify-center rounded-xl border transition-colors"
                    :title="icon.name"
                  >
                    <template x-if="icon.id === 'landmark'">
                      <Landmark :size="18" />
                    </template>

                    <template x-if="icon.id === 'building'">
                      <Building :size="18" />
                    </template>

                    <template x-if="icon.id === 'credit-card'">
                      <CreditCard :size="18" />
                    </template>

                    <template x-if="icon.id === 'coins'">
                      <Coins :size="18" />
                    </template>

                    <template x-if="icon.id === 'wallet'">
                      <Wallet :size="18" />
                    </template>

                    <template x-if="icon.id === 'piggy-bank'">
                      <PiggyBank :size="18" />
                    </template>

                    <template x-if="icon.id === 'qr-code'">
                      <QrCode :size="18" />
                    </template>

                    <template x-if="icon.id === 'briefcase'">
                      <Briefcase :size="18" />
                    </template>
                  </button>
                </template>
              </div>
            </div>
          </div>

          <!-- SALDO AWAL -->
          <div class="space-y-1.5">
            <label
              class="text-muted-foreground block text-[10px] font-bold uppercase"
              >Saldo Awal (Rp)</label
            >
            <input
              type="text"
              inputmode="numeric"
              :value="formattedBalance"
              @input="handleBalanceInput($event)"
              placeholder="0"
              class="border-border bg-background text-foreground focus:border-blue-main w-full rounded-2xl border px-4 py-3 text-xs font-bold outline-none"
            />
          </div>

          <div class="flex items-center gap-2 pt-2">
            <button
              type="button"
              @click="openFormModal = false"
              class="border-border text-muted-foreground hover:bg-muted w-1/3 cursor-pointer rounded-2xl border py-3.5 text-xs font-bold"
              >Batal</button
            >
            <button
              type="submit"
              class="bg-primary text-primary-foreground shadow-soft w-2/3 cursor-pointer rounded-2xl py-3.5 text-xs font-bold hover:opacity-90 active:scale-95"
              >Simpan Dompet</button
            >
          </div>
        </form>
      </div>
    </div>
  </div>
</Layout>
