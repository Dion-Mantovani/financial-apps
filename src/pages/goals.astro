---
import Layout from '../layouts/Layout.astro';
import { ArrowLeft, Target, Plus, Laptop, Plane, Car } from '@lucide/astro';
---

<Layout title="Impian - Studion App">
  <div class="space-y-4 pt-2 pb-10">
    <!-- HEADER -->
    <div class="mt-6 flex items-center justify-between pb-1">
      <a
        href="/"
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-2xl border border-slate-200/80 bg-white text-slate-700 shadow-2xs transition-all hover:border-blue-400 hover:bg-slate-50 active:scale-95"
      >
        <ArrowLeft class="h-4 w-4 stroke-[2.5]" />
      </a>
      <h1 class="text-sm font-extrabold tracking-tight text-slate-900">
        Target Impian
      </h1>
      <div class="w-9"></div>
    </div>

    <!-- GOAL CARD 1 -->
    <div
      class="space-y-3 rounded-3xl border border-slate-200/70 bg-white p-4 shadow-sm"
    >
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-2xl bg-cyan-50 text-cyan-600"
          >
            <Laptop class="h-5 w-5 stroke-2" />
          </div>
          <div>
            <h3 class="text-xs font-bold text-slate-800">MacBook Pro M3</h3>
            <p class="text-[10px] text-slate-400">Target: Des 2026</p>
          </div>
        </div>
        <span class="text-xs font-extrabold text-blue-600">65%</span>
      </div>

      <!-- PROGRESS BAR -->
      <div class="space-y-1">
        <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
          <div class="h-full rounded-full bg-blue-600" style="width: 65%"></div>
        </div>
        <div class="flex justify-between text-[10px] font-bold">
          <span class="text-slate-800">Rp 19.500.000</span>
          <span class="text-slate-400">Rp 30.000.000</span>
        </div>
      </div>
    </div>

    <!-- GOAL CARD 2 -->
    <div
      class="space-y-3 rounded-3xl border border-slate-200/70 bg-white p-4 shadow-sm"
    >
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div
            class="flex h-10 w-10 items-center justify-center rounded-2xl bg-amber-50 text-amber-600"
          >
            <Plane class="h-5 w-5 stroke-2" />
          </div>
          <div>
            <h3 class="text-xs font-bold text-slate-800">Liburan Ke Jepang</h3>
            <p class="text-[10px] text-slate-400">Target: Jun 2027</p>
          </div>
        </div>
        <span class="text-xs font-extrabold text-blue-600">30%</span>
      </div>

      <!-- PROGRESS BAR -->
      <div class="space-y-1">
        <div class="h-2 w-full overflow-hidden rounded-full bg-slate-100">
          <div class="h-full rounded-full bg-amber-500" style="width: 30%">
          </div>
        </div>
        <div class="flex justify-between text-[10px] font-bold">
          <span class="text-slate-800">Rp 7.500.000</span>
          <span class="text-slate-400">Rp 25.000.000</span>
        </div>
      </div>
    </div>

    <!-- TOMBOL TAMBAH -->
    <button
      type="button"
      class="flex w-full cursor-pointer items-center justify-center gap-2 rounded-2xl border border-dashed border-blue-300 bg-blue-50/40 py-3.5 text-blue-600 shadow-2xs transition-all hover:bg-blue-100/60 active:scale-95"
    >
      <Plus class="h-4 w-4 stroke-[2.5]" />
      <span class="text-xs font-bold">Buat Target Baru</span>
    </button>
  </div>
</Layout>
